diff --git a/src-tauri/src/settings_service/normalization.rs b/src-tauri/src/settings_service/normalization.rs
new file mode 100644
index 0000000..3b0b795
--- /dev/null
+++ b/src-tauri/src/settings_service/normalization.rs
@@ -0,0 +1,39 @@
+//! Pure legacy salvage and normalization; callers decide explicitly whether to persist.
+use super::errors::{SettingsError, SettingsErrorCode};
+use crate::settings::{self, AppSettings};
+use serde_json::Value;
+
+/// Normalize an existing payload without mutating its raw document or logging values.
+// @spec FR-002: In-memory salvage and migrations — .specs/features/008-settings-cli/spec.md#fr-002
+pub(super) fn normalize(payload: &Value) -> Result<(AppSettings, bool), SettingsError> {
+    let (mut settings, recovered) = match serde_json::from_value(payload.clone()) {
+        Ok(settings) => (settings, false),
+        Err(_) => (salvage(payload)?, true),
+    };
+    settings::apply_settings_migrations(&mut settings, payload);
+    for (key, binding) in settings::get_default_settings().bindings {
+        settings.bindings.entry(key).or_insert(binding);
+    }
+    settings::ensure_post_process_defaults(&mut settings);
+    Ok((settings, recovered))
+}
+fn salvage(payload: &Value) -> Result<AppSettings, SettingsError> {
+    let mut merged =
+        serde_json::to_value(settings::get_default_settings()).map_err(|_| failed())?;
+    // Probe one recognized field at a time against defaults; unknown values stay only in raw storage.
+    if let Some(fields) = payload.as_object() {
+        for entry in super::descriptor::descriptors() {
+            if let Some(value) = fields.get(entry.key) {
+                let mut candidate = merged.clone();
+                candidate[entry.key] = value.clone();
+                if serde_json::from_value::<AppSettings>(candidate.clone()).is_ok() {
+                    merged = candidate;
+                }
+            }
+        }
+    }
+    serde_json::from_value(merged).map_err(|_| failed())
+}
+fn failed() -> SettingsError {
+    SettingsError::new(SettingsErrorCode::PersistenceFailed)
+}
diff --git a/src-tauri/src/settings_service/ownership.rs b/src-tauri/src/settings_service/ownership.rs
new file mode 100644
index 0000000..79ac6e6
--- /dev/null
+++ b/src-tauri/src/settings_service/ownership.rs
@@ -0,0 +1,198 @@
+//! Stable sibling locks and passive legacy ownership are independent of JSON generations.
+use super::{
+    errors::{SettingsError, SettingsErrorCode},
+    store::persistence_failed,
+};
+#[cfg(unix)]
+use std::fs::OpenOptions;
+use std::{
+    fs::File,
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+#[path = "instance_probe.rs"]
+mod probe;
+#[cfg(unix)]
+pub(super) use probe::current_uid;
+pub use probe::LegacyState as OwnerState;
+// The future IPC technical deadline is five seconds; transaction lock waiting is bounded here too.
+const LOCK_DEADLINE: Duration = Duration::from_secs(5);
+const LOCK_RECHECK: Duration = Duration::from_millis(2);
+
+/// Passive owner port; injections inspect real isolated OS resources in integration tests.
+pub trait OwnerProbe {
+    /// Observe current native ownership without connecting, messaging, deleting or reserving resources.
+    fn inspect(&self) -> OwnerState;
+}
+/// Default platform observation never invokes the historic singleton callback.
+pub struct NativeOwnerProbe;
+impl OwnerProbe for NativeOwnerProbe {
+    fn inspect(&self) -> OwnerState {
+        #[cfg(target_os = "macos")]
+        {
+            probe::inspect_legacy_path(
+                Path::new("/tmp/com_pais_handy_si.sock"),
+                probe::current_uid(),
+            )
+        }
+        #[cfg(target_os = "linux")]
+        {
+            probe::inspect_legacy_dbus()
+        }
+        #[cfg(windows)]
+        {
+            probe::inspect_legacy_windows()
+        }
+    }
+}
+/// Isolated passive pathname probe; absence must cover the same-user scope to permit a write.
+pub struct LegacyPathProbe {
+    path: PathBuf,
+}
+impl LegacyPathProbe {
+    /// Bind an isolated absolute legacy pathname without filesystem side effects.
+    pub fn new(path: PathBuf) -> Self {
+        Self { path }
+    }
+}
+impl OwnerProbe for LegacyPathProbe {
+    fn inspect(&self) -> OwnerState {
+        #[cfg(unix)]
+        {
+            let state = probe::inspect_legacy_path(&self.path, probe::current_uid());
+            match state {
+                OwnerState::Absent | OwnerState::Occupied => probe::classify_owner(
+                    Ok(state == OwnerState::Occupied),
+                    probe::ProbeScope::SameUser,
+                ),
+                OwnerState::Uncertain => {
+                    probe::classify_owner(Ok(false), probe::ProbeScope::CurrentSession)
+                }
+                OwnerState::Unavailable => probe::classify_owner(
+                    Err(std::io::Error::other("owner unavailable")),
+                    probe::ProbeScope::SameUser,
+                ),
+            }
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = &self.path;
+            OwnerState::Uncertain
+        }
+    }
+}
+/// Pinned stable lock handle; drop releases the lock without unlinking its pathname.
+pub(super) struct FileLock {
+    #[cfg(windows)]
+    parent: super::windows_store::PinnedDirectory,
+    file: File,
+    path: PathBuf,
+}
+impl FileLock {
+    /// Open a stable private lock and acquire nonblocking or bounded worker ownership; drop retains its pathname.
+    pub fn acquire(path: PathBuf, wait: bool) -> Result<Self, SettingsError> {
+        let lock = open_lock(path)?;
+        lock.validate()?;
+        let deadline = Instant::now() + LOCK_DEADLINE;
+        loop {
+            match fs2::FileExt::try_lock_exclusive(&lock.file) {
+                Ok(()) => {
+                    lock.validate()?;
+                    return Ok(lock);
+                }
+                Err(error)
+                    if error.raw_os_error().is_some_and(|code| {
+                        Some(code) == fs2::lock_contended_error().raw_os_error()
+                    }) && wait
+                        && Instant::now() < deadline =>
+                {
+                    std::thread::park_timeout(LOCK_RECHECK)
+                }
+                Err(_) => return Err(SettingsError::new(SettingsErrorCode::Unavailable)),
+            }
+        }
+    }
+    /// Compare the held file and current pathname identity; refuse substitutes without deleting them.
+    pub fn validate(&self) -> Result<(), SettingsError> {
+        let path = std::fs::symlink_metadata(&self.path).map_err(|_| persistence_failed())?;
+        let held = self.file.metadata().map_err(|_| persistence_failed())?;
+        super::locator::validate_owner(&path)?;
+        if !path.is_file() {
+            return Err(persistence_failed());
+        }
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            if (path.dev(), path.ino(), path.uid()) != (held.dev(), held.ino(), held.uid())
+                || path.nlink() != 1
+                || path.mode() & 0o777 != 0o600
+            {
+                return Err(persistence_failed());
+            }
+        }
+        #[cfg(windows)]
+        {
+            self.parent.validate().map_err(|_| persistence_failed())?;
+            let current = super::windows_store::open_private(&self.path, true)
+                .map_err(|_| persistence_failed())?;
+            if super::windows_store::identity(&current).map_err(|_| persistence_failed())?
+                != super::windows_store::identity(&self.file).map_err(|_| persistence_failed())?
+            {
+                return Err(persistence_failed());
+            }
+            let _ = held;
+        }
+        Ok(())
+    }
+}
+fn open_lock(path: PathBuf) -> Result<FileLock, SettingsError> {
+    #[cfg(windows)]
+    let parent = super::windows_store::pin_parent(path.parent().ok_or_else(persistence_failed)?)
+        .map_err(|_| persistence_failed())?;
+    #[cfg(windows)]
+    let file = match super::windows_store::create_private_lock(&path) {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+            super::windows_store::open_private(&path, true).map_err(|_| persistence_failed())?
+        }
+        Err(_) => return Err(persistence_failed()),
+    };
+    #[cfg(unix)]
+    let file = {
+        use std::os::unix::fs::OpenOptionsExt;
+        // Stable lock contents/inode are deliberately retained; never truncate an existing lock.
+        OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(&path)
+            .map_err(|_| persistence_failed())?
+    };
+    let lock = FileLock {
+        file,
+        path,
+        #[cfg(windows)]
+        parent,
+    };
+    Ok(lock)
+}
+/// Retain startup lease until shutdown; ownership cannot be inferred from a busy lease.
+pub struct StartupLease {
+    pub(super) lock: FileLock,
+}
+impl StartupLease {
+    /// Revalidate the pinned lease; dropping it releases ownership without deleting the lock.
+    pub fn validate(&self) -> Result<(), SettingsError> {
+        self.lock.validate()
+    }
+}
+/// Fail closed on occupied, unavailable and session-limited evidence.
+pub(super) fn require_absent(probe: &impl OwnerProbe) -> Result<(), SettingsError> {
+    if probe.inspect() != OwnerState::Absent {
+        return Err(SettingsError::new(SettingsErrorCode::Unavailable));
+    }
+    Ok(())
+}
diff --git a/src-tauri/src/settings_service/store.rs b/src-tauri/src/settings_service/store.rs
new file mode 100644
index 0000000..a33c727
--- /dev/null
+++ b/src-tauri/src/settings_service/store.rs
@@ -0,0 +1,126 @@
+//! Fresh preserved raw documents and typed non-mutating settings views.
+use super::{
+    errors::{SettingsError, SettingsErrorCode},
+    protocol::{Revision, SettingsSnapshot},
+};
+use crate::settings::get_default_settings;
+use serde_json::{json, Value};
+use std::path::PathBuf;
+
+/// Repository identity stays stable while each JSON generation is replaced atomically.
+pub struct SettingsRepository {
+    pub(crate) path: PathBuf,
+}
+/// Recovery warning contains no raw document, field name or parse diagnostics.
+pub struct SettingsRead {
+    pub snapshot: SettingsSnapshot,
+    pub warning: bool,
+}
+/// Raw documents remain internal: only transactions may replace their generations.
+pub(super) struct Document {
+    pub raw: Value,
+    pub read: SettingsRead,
+    pub writable: bool,
+    pub missing: bool,
+}
+impl SettingsRepository {
+    /// Bind an isolated path; construction performs no filesystem operations.
+    pub fn new(path: PathBuf) -> Self {
+        Self { path }
+    }
+    /// Read fresh bytes and normalize only in memory; absent parents remain absent.
+    // @spec FR-002: Non-creating fresh reads — .specs/features/008-settings-cli/spec.md#fr-002
+    pub fn read_snapshot(&self) -> Result<SettingsRead, SettingsError> {
+        let path = super::locator::canonical_path(&self.path)?;
+        if !path.parent().is_some_and(std::path::Path::exists) {
+            return Ok(fallback(true)?.read);
+        }
+        let _lock =
+            super::ownership::FileLock::acquire(path.with_file_name("settings.lock"), true)?;
+        Ok(self.load_at(&path)?.read)
+    }
+    pub(super) fn load_at(&self, path: &std::path::Path) -> Result<Document, SettingsError> {
+        #[cfg(windows)]
+        let _parent =
+            super::windows_store::pin_parent(path.parent().ok_or_else(persistence_failed)?)
+                .map_err(|_| persistence_failed())?;
+        #[cfg(unix)]
+        let mut options = std::fs::OpenOptions::new();
+        #[cfg(unix)]
+        options.read(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC);
+        }
+        #[cfg(unix)]
+        let opened = options.open(path);
+        #[cfg(windows)]
+        let opened = super::windows_store::open_checked(
+            path,
+            super::windows_store::ResourceKind::File,
+            false,
+        );
+        match opened {
+            Ok(mut file) => {
+                let metadata = file.metadata().map_err(|_| persistence_failed())?;
+                super::locator::validate_owner(&metadata)?;
+                if !metadata.is_file() {
+                    return Err(persistence_failed());
+                }
+                #[cfg(unix)]
+                {
+                    use std::os::unix::fs::MetadataExt;
+                    if metadata.nlink() != 1 {
+                        return Err(persistence_failed());
+                    }
+                }
+                let mut bytes = Vec::new();
+                std::io::Read::read_to_end(&mut file, &mut bytes)
+                    .map_err(|_| persistence_failed())?;
+                match serde_json::from_slice::<Value>(&bytes) {
+                    Ok(value) if value.is_object() => document(value),
+                    _ => fallback(false),
+                }
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => fallback(true),
+            Err(_) => Err(persistence_failed()),
+        }
+    }
+}
+fn document(raw: Value) -> Result<Document, SettingsError> {
+    // A missing legacy revision starts at zero; an existing malformed counter can never authorize writes.
+    let valid_revision = raw.get("settings_revision").map(Value::as_u64);
+    let writable =
+        !matches!(valid_revision, Some(None)) && raw.get("settings").is_none_or(Value::is_object);
+    let revision = Revision(valid_revision.flatten().unwrap_or(0));
+    let payload = raw.get("settings").cloned().unwrap_or_else(|| json!({}));
+    let (settings, recovered) = super::normalization::normalize(&payload)?;
+    let warning = recovered || !writable;
+    Ok(Document {
+        raw,
+        read: SettingsRead {
+            snapshot: SettingsSnapshot { settings, revision },
+            warning,
+        },
+        writable,
+        missing: false,
+    })
+}
+fn fallback(missing: bool) -> Result<Document, SettingsError> {
+    Ok(Document {
+        raw: json!({}),
+        read: SettingsRead {
+            snapshot: SettingsSnapshot {
+                settings: get_default_settings(),
+                revision: Revision(0),
+            },
+            warning: !missing,
+        },
+        writable: missing,
+        missing,
+    })
+}
+pub(super) fn persistence_failed() -> SettingsError {
+    SettingsError::new(SettingsErrorCode::PersistenceFailed)
+}
diff --git a/src-tauri/src/settings_service/transaction.rs b/src-tauri/src/settings_service/transaction.rs
new file mode 100644
index 0000000..5a22251
--- /dev/null
+++ b/src-tauri/src/settings_service/transaction.rs
@@ -0,0 +1,216 @@
+//! Lock/reload/patch transactions preserve raw fields and independent startup ownership.
+pub use super::atomic::{PersistObserver, PersistStage};
+use super::{
+    errors::SettingsError,
+    ownership::{require_absent, FileLock, NativeOwnerProbe, OwnerProbe, StartupLease},
+    protocol::{Revision, SettingsSnapshot},
+    store::{persistence_failed, SettingsRead, SettingsRepository},
+    validation::SettingsMutation,
+};
+use serde_json::Value;
+
+impl SettingsRepository {
+    /// Commit a validated scalar against fresh bytes using native passive ownership checks.
+    // @spec FR-003: Durable typed patch and revision — .specs/features/008-settings-cli/spec.md#fr-003
+    pub fn commit_mutation(
+        &self,
+        mutation: SettingsMutation,
+        expected: Option<Revision>,
+    ) -> Result<SettingsRead, SettingsError> {
+        self.commit_with_probe(mutation, expected, &NativeOwnerProbe, &())
+    }
+    /// Isolated OS probe/fault ports test the actual repository and durable replacement.
+    pub fn commit_with_probe(
+        &self,
+        mutation: SettingsMutation,
+        expected: Option<Revision>,
+        probe: &impl OwnerProbe,
+        observer: &impl PersistObserver,
+    ) -> Result<SettingsRead, SettingsError> {
+        let path = self.prepare_parent()?;
+        let transaction = FileLock::acquire(path.with_file_name("settings.lock"), true)?;
+        let lease = FileLock::acquire(path.with_file_name("settings.instance.lock"), false)?;
+        require_absent(probe)?;
+        let mut document = self.load_at(&path)?;
+        check_revision(&document, expected)?;
+        let mutation = revalidate_mutation(&document.read.snapshot.settings, mutation)?;
+        let current = serde_json::to_value(&document.read.snapshot.settings)
+            .map_err(|_| persistence_failed())?;
+        let mut candidate = current.clone();
+        candidate[mutation.key()] =
+            serde_json::to_value(mutation.value()).map_err(|_| persistence_failed())?;
+        let settings = serde_json::from_value(candidate).map_err(|_| persistence_failed())?;
+        let candidate = serde_json::to_value(&settings).map_err(|_| persistence_failed())?;
+        if current == candidate {
+            return Ok(document.read);
+        }
+        let revision = next_revision(document.read.snapshot.revision)?;
+        apply_changed_fields(&mut document.raw, &current, &candidate, document.missing)?;
+        document.raw["settings_revision"] = serde_json::json!(revision.0);
+        super::atomic::persist(&path, &document.raw, observer, || {
+            transaction.validate()?;
+            lease.validate()?;
+            if super::locator::canonical_path(&self.path)? != path {
+                return Err(persistence_failed());
+            }
+            // Last passive probe occurs after temporary-file fsync and immediately before replacement.
+            require_absent(probe)
+        })?;
+        Ok(SettingsRead {
+            snapshot: SettingsSnapshot { settings, revision },
+            warning: document.read.warning,
+        })
+    }
+    /// Startup normalizes explicitly under the transaction lock and retains a separate lease until shutdown.
+    // @spec FR-004: Startup/offline ownership fence — .specs/features/008-settings-cli/spec.md#fr-004
+    pub fn initialize(
+        &self,
+        probe: &impl OwnerProbe,
+    ) -> Result<(SettingsRead, StartupLease), SettingsError> {
+        let path = self.prepare_parent()?;
+        let transaction = FileLock::acquire(path.with_file_name("settings.lock"), true)?;
+        let lease = StartupLease {
+            lock: FileLock::acquire(path.with_file_name("settings.instance.lock"), false)?,
+        };
+        require_absent(probe)?;
+        let mut document = self.load_at(&path)?;
+        check_revision(&document, None)?;
+        let normalized = serde_json::to_value(&document.read.snapshot.settings)
+            .map_err(|_| persistence_failed())?;
+        let previous = document
+            .raw
+            .get("settings")
+            .cloned()
+            .unwrap_or_else(|| serde_json::json!({}));
+        let preserved = normalized_payload(&previous, &normalized);
+        if document.missing || preserved != previous {
+            let revision = next_revision(document.read.snapshot.revision)?;
+            document.raw["settings"] = preserved;
+            document.raw["settings_revision"] = serde_json::json!(revision.0);
+            super::atomic::persist(&path, &document.raw, &(), || {
+                transaction.validate()?;
+                lease.validate()?;
+                require_absent(probe)
+            })?;
+            document.read.snapshot.revision = revision;
+        }
+        Ok((document.read, lease))
+    }
+    fn prepare_parent(&self) -> Result<std::path::PathBuf, SettingsError> {
+        let path = super::locator::canonical_path(&self.path)?;
+        let parent = path.parent().ok_or_else(persistence_failed)?;
+        if !parent.exists() {
+            // Creation belongs only to an explicit changed/startup operation; read never calls this function.
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::DirBuilderExt;
+                std::fs::DirBuilder::new()
+                    .recursive(true)
+                    .mode(0o700)
+                    .create(parent)
+                    .map_err(|_| persistence_failed())?;
+            }
+            #[cfg(windows)]
+            super::windows_store::ensure_private_parent(parent)
+                .map_err(|_| persistence_failed())?;
+        }
+        super::locator::canonical_path(&path)
+    }
+}
+fn revalidate_mutation(
+    settings: &crate::settings::AppSettings,
+    mutation: SettingsMutation,
+) -> Result<SettingsMutation, SettingsError> {
+    let entry = super::descriptor::descriptor(mutation.key()).ok_or_else(persistence_failed)?;
+    let candidate = serde_json::to_value(mutation.value()).map_err(|_| persistence_failed())?;
+    // Membership can change after parsing; use the locked current prompts, not the caller's old context.
+    let prompt_ids = settings
+        .post_process_prompts
+        .iter()
+        .map(|prompt| prompt.id.as_str())
+        .collect::<Vec<_>>();
+    let context = super::validation::ValidationContext {
+        prompt_ids: &prompt_ids,
+        updates_allowed: !crate::settings::update_checks_forced_disabled(),
+    };
+    super::validation::validate_value(entry, candidate, &context)
+}
+fn normalized_payload(previous: &Value, normalized: &Value) -> Value {
+    let mut preserved = previous.clone();
+    for entry in super::descriptor::descriptors() {
+        // Startup recovery preserves existing raw secrets even when their typed decoding was invalid.
+        if !(entry.secret && previous.get(entry.key).is_some()) {
+            merge_preserved(&mut preserved[entry.key], &normalized[entry.key]);
+        }
+    }
+    preserved
+}
+fn check_revision(
+    document: &super::store::Document,
+    expected: Option<Revision>,
+) -> Result<(), SettingsError> {
+    if !document.writable {
+        return Err(persistence_failed());
+    }
+    if expected.is_some_and(|revision| revision != document.read.snapshot.revision) {
+        return Err(SettingsError::revision_conflict(
+            document.read.snapshot.revision,
+        ));
+    }
+    Ok(())
+}
+fn next_revision(current: Revision) -> Result<Revision, SettingsError> {
+    current
+        .0
+        .checked_add(1)
+        .map(Revision)
+        .ok_or_else(persistence_failed)
+}
+fn apply_changed_fields(
+    raw: &mut Value,
+    before: &Value,
+    after: &Value,
+    missing: bool,
+) -> Result<(), SettingsError> {
+    if missing {
+        raw["settings"] = after.clone();
+        return Ok(());
+    }
+    if !raw["settings"].is_object() {
+        raw["settings"] = serde_json::json!({});
+    }
+    // Apply only semantic changes to the preserved payload; unrelated raw secrets/future fields remain untouched.
+    for entry in super::descriptor::descriptors() {
+        if before[entry.key] != after[entry.key] {
+            merge_preserved(&mut raw["settings"][entry.key], &after[entry.key]);
+        }
+    }
+    Ok(())
+}
+fn merge_preserved(raw: &mut Value, typed: &Value) {
+    match (raw, typed) {
+        (Value::Object(raw), Value::Object(typed)) => {
+            for (key, value) in typed {
+                merge_preserved(raw.entry(key).or_insert(Value::Null), value);
+            }
+        }
+        (raw @ Value::Array(_), Value::Array(typed)) => {
+            let previous = raw.as_array().cloned().unwrap_or_default();
+            *raw = Value::Array(
+                typed
+                    .iter()
+                    .map(|item| {
+                        let mut preserved = item
+                            .get("id")
+                            .and_then(|id| previous.iter().find(|old| old.get("id") == Some(id)))
+                            .cloned()
+                            .unwrap_or(Value::Null);
+                        merge_preserved(&mut preserved, item);
+                        preserved
+                    })
+                    .collect(),
+            );
+        }
+        (raw, typed) => *raw = typed.clone(),
+    }
+}
diff --git a/src-tauri/src/settings_service/validation.rs b/src-tauri/src/settings_service/validation.rs
index ed7aa0f..f3a3b51 100644
--- a/src-tauri/src/settings_service/validation.rs
+++ b/src-tauri/src/settings_service/validation.rs
@@ -133,7 +133,8 @@ fn parse_cli(
     }
 }
 
-fn validate_value(
+/// Revalidate one canonical value against fresh membership/build context without I/O.
+pub(super) fn validate_value(
     entry: &'static super::descriptor::SettingDescriptor,
     candidate: serde_json::Value,
     context: &ValidationContext<'_>,
diff --git a/src-tauri/src/settings_service/windows_store.rs b/src-tauri/src/settings_service/windows_store.rs
new file mode 100644
index 0000000..32855bf
--- /dev/null
+++ b/src-tauri/src/settings_service/windows_store.rs
@@ -0,0 +1,258 @@
+//! Windows settings files use checked handles, pinned parents and persistent user ACLs.
+// @spec FR-003: Private Windows durable generations — .specs/features/008-settings-cli/spec.md#fr-003
+#[path = "windows_store/replace.rs"]
+mod replace;
+#[path = "windows_store/security.rs"]
+mod security;
+pub(super) use replace::{replace_owned, ReplaceError};
+use std::{
+    ffi::OsStr,
+    fs::File,
+    io,
+    os::windows::{
+        ffi::OsStrExt,
+        io::{AsRawHandle, FromRawHandle},
+    },
+    path::{Component, Path, PathBuf},
+};
+use windows_sys::Win32::{
+    Foundation::{GENERIC_READ, GENERIC_WRITE, INVALID_HANDLE_VALUE},
+    Storage::FileSystem::{
+        CreateDirectoryW, CreateFileW, FileIdInfo, GetFileInformationByHandle,
+        GetFileInformationByHandleEx, GetFileType, BY_HANDLE_FILE_INFORMATION, CREATE_NEW, DELETE,
+        FILE_ATTRIBUTE_DIRECTORY, FILE_ATTRIBUTE_REPARSE_POINT, FILE_FLAG_BACKUP_SEMANTICS,
+        FILE_FLAG_OPEN_REPARSE_POINT, FILE_FLAG_WRITE_THROUGH, FILE_ID_INFO, FILE_SHARE_DELETE,
+        FILE_SHARE_READ, FILE_SHARE_WRITE, FILE_TYPE_DISK, OPEN_EXISTING, READ_CONTROL,
+    },
+};
+
+/// Expected resource type; reparse points and multiple file links are always refused.
+#[derive(Clone, Copy)]
+pub(crate) enum ResourceKind {
+    File,
+    Directory,
+}
+/// Stable identity uses the full Windows/ReFS file ID rather than a process-local handle.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) struct FileIdentity {
+    pub volume: u64,
+    pub id: [u8; 16],
+}
+/// Ancestor handles deny deletion/rename until the caller's repository operation ends.
+pub(crate) struct PinnedDirectory {
+    handles: Vec<File>,
+    path: PathBuf,
+}
+impl PinnedDirectory {
+    /// Re-open the final pathname and compare it with the retained handle before mutation.
+    pub(super) fn validate(&self) -> io::Result<()> {
+        let current = open_raw(&self.path, ResourceKind::Directory, false, false)?;
+        security::verify(&current, false)?;
+        let held = self.handles.last().ok_or_else(security::denied)?;
+        if identity(&current)? != identity(held)? {
+            return Err(security::denied());
+        }
+        Ok(())
+    }
+    /// Canonical absolute parent path retained by this pinned directory.
+    pub(super) fn path(&self) -> &Path {
+        &self.path
+    }
+}
+/// Account SID for persisted-file ownership; IPC uses a separate logon identity.
+pub(super) fn current_user_sid() -> io::Result<String> {
+    security::current_user_sid()
+}
+
+/// Pin an existing directory and all ancestors without changing any existing ACL.
+pub(super) fn pin_parent(path: &Path) -> io::Result<PinnedDirectory> {
+    pin_directory(path, false)
+}
+/// Create only missing directory components with private attributes, then retain checked handles.
+pub(super) fn ensure_private_parent(path: &Path) -> io::Result<PinnedDirectory> {
+    pin_directory(path, true)
+}
+
+fn pin_directory(path: &Path, create: bool) -> io::Result<PinnedDirectory> {
+    if !path.is_absolute() {
+        return Err(security::denied());
+    }
+    let mut current = PathBuf::new();
+    let mut handles = Vec::new();
+    for component in path.components() {
+        match component {
+            Component::Prefix(_) => {
+                current.push(component);
+                continue;
+            }
+            Component::RootDir | Component::Normal(_) => current.push(component),
+            _ => return Err(security::denied()),
+        }
+        // Hold every already-checked ancestor before resolving the next component; reparse traversal is refused.
+        let file = match open_raw(&current, ResourceKind::Directory, false, false) {
+            Ok(file) => file,
+            Err(error) if create && error.kind() == io::ErrorKind::NotFound => {
+                create_directory(&current)?;
+                let file = open_raw(&current, ResourceKind::Directory, false, false)?;
+                security::verify(&file, true)?;
+                file
+            }
+            Err(error) => return Err(error),
+        };
+        handles.push(file);
+    }
+    let final_handle = handles.last().ok_or_else(security::denied)?;
+    // System ancestors have different owners; the settings parent must belong to this account.
+    security::verify(final_handle, false)?;
+    Ok(PinnedDirectory {
+        handles,
+        path: current,
+    })
+}
+
+fn create_directory(path: &Path) -> io::Result<()> {
+    let descriptor = security::Descriptor::private(&current_user_sid()?)?;
+    let attributes = descriptor.attributes();
+    let name = wide(path.as_os_str())?;
+    // SAFETY: descriptor, attributes and terminated filename stay live until directory creation returns.
+    if unsafe { CreateDirectoryW(name.as_ptr(), &attributes) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+/// Open a legacy account-owned resource; only current-user/SYSTEM/Admin ACL grants are allowed.
+pub(super) fn open_checked(path: &Path, kind: ResourceKind, writable: bool) -> io::Result<File> {
+    let _parent = pin_parent(path.parent().ok_or_else(security::denied)?)?;
+    let file = open_raw(path, kind, writable, !writable)?;
+    security::verify(&file, false)?;
+    Ok(file)
+}
+/// Open an existing private stable lock without granting replacement through share-delete.
+pub(super) fn open_private(path: &Path, writable: bool) -> io::Result<File> {
+    let _parent = pin_parent(path.parent().ok_or_else(security::denied)?)?;
+    let file = open_raw(path, ResourceKind::File, writable, false)?;
+    security::verify(&file, true)?;
+    Ok(file)
+}
+
+fn open_raw(
+    path: &Path,
+    kind: ResourceKind,
+    writable: bool,
+    share_delete: bool,
+) -> io::Result<File> {
+    let name = wide(path.as_os_str())?;
+    let access = GENERIC_READ | READ_CONTROL | if writable { GENERIC_WRITE } else { 0 };
+    let share =
+        FILE_SHARE_READ | FILE_SHARE_WRITE | if share_delete { FILE_SHARE_DELETE } else { 0 };
+    let flags = FILE_FLAG_OPEN_REPARSE_POINT
+        | if matches!(kind, ResourceKind::Directory) {
+            FILE_FLAG_BACKUP_SEMANTICS
+        } else {
+            0
+        };
+    // SAFETY: terminated filename remains live; no optional security/template pointers are dereferenced.
+    let handle = unsafe {
+        CreateFileW(
+            name.as_ptr(),
+            access,
+            share,
+            std::ptr::null(),
+            OPEN_EXISTING,
+            flags,
+            std::ptr::null_mut(),
+        )
+    };
+    if handle == INVALID_HANDLE_VALUE {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: successful CreateFile transfers one owned handle; File closes it on all subsequent refusals.
+    let file = unsafe { File::from_raw_handle(handle) };
+    validate_kind(&file, kind)?;
+    Ok(file)
+}
+
+/// Create an owner-private temp with DELETE rights. Existing paths are never truncated or ACL-repaired.
+pub(super) fn create_private(path: &Path) -> io::Result<File> {
+    create_file(path, DELETE)
+}
+/// Stable locks allow competing read/write handles while all holders deny pathname deletion.
+pub(super) fn create_private_lock(path: &Path) -> io::Result<File> {
+    create_file(path, 0)
+}
+
+fn create_file(path: &Path, delete_access: u32) -> io::Result<File> {
+    let _parent = pin_parent(path.parent().ok_or_else(security::denied)?)?;
+    let descriptor = security::Descriptor::private(&current_user_sid()?)?;
+    let attributes = descriptor.attributes();
+    let name = wide(path.as_os_str())?;
+    // SAFETY: name/attributes/descriptor stay live; successful CREATE_NEW transfers sole handle ownership.
+    let handle = unsafe {
+        CreateFileW(
+            name.as_ptr(),
+            GENERIC_READ | GENERIC_WRITE | READ_CONTROL | delete_access,
+            FILE_SHARE_READ | FILE_SHARE_WRITE,
+            &attributes,
+            CREATE_NEW,
+            FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_WRITE_THROUGH,
+            std::ptr::null_mut(),
+        )
+    };
+    if handle == INVALID_HANDLE_VALUE {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: valid owned handle is transferred exactly once, including validation errors.
+    let file = unsafe { File::from_raw_handle(handle) };
+    validate_kind(&file, ResourceKind::File)?;
+    security::verify(&file, true)?;
+    Ok(file)
+}
+
+fn validate_kind(file: &File, kind: ResourceKind) -> io::Result<()> {
+    let mut info = BY_HANDLE_FILE_INFORMATION::default();
+    // SAFETY: File owns a live handle and initialized output has the API's exact structure size.
+    if unsafe { GetFileInformationByHandle(file.as_raw_handle(), &mut info) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let directory = info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY != 0;
+    // SAFETY: handle remains live during this scalar metadata query.
+    if unsafe { GetFileType(file.as_raw_handle()) } != FILE_TYPE_DISK
+        || info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT != 0
+        || directory != matches!(kind, ResourceKind::Directory)
+        || (!directory && info.nNumberOfLinks != 1)
+    {
+        return Err(security::denied());
+    }
+    Ok(())
+}
+
+/// Query full volume/file identity; failed inspection never becomes equality or an unsafe fallback.
+pub(super) fn identity(file: &File) -> io::Result<FileIdentity> {
+    let mut info = FILE_ID_INFO::default();
+    // SAFETY: live handle and aligned FILE_ID_INFO output match the declared byte size.
+    if unsafe {
+        GetFileInformationByHandleEx(
+            file.as_raw_handle(),
+            FileIdInfo,
+            (&mut info as *mut FILE_ID_INFO).cast(),
+            std::mem::size_of_val(&info) as u32,
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(FileIdentity {
+        volume: info.VolumeSerialNumber,
+        id: info.FileId.Identifier,
+    })
+}
+
+fn wide(value: &OsStr) -> io::Result<Vec<u16>> {
+    let mut value: Vec<u16> = value.encode_wide().collect();
+    if value.contains(&0) {
+        return Err(security::denied());
+    }
+    value.push(0);
+    Ok(value)
+}
diff --git a/src-tauri/src/settings_service/windows_store/replace.rs b/src-tauri/src/settings_service/windows_store/replace.rs
new file mode 100644
index 0000000..eaadec3
--- /dev/null
+++ b/src-tauri/src/settings_service/windows_store/replace.rs
@@ -0,0 +1,92 @@
+//! Owned-handle replacement distinguishes refusal from uncertain post-commit durability.
+use super::{security, validate_kind, wide, PinnedDirectory, ResourceKind};
+use std::{ffi::OsStr, fs::File, io, os::windows::io::AsRawHandle};
+use windows_sys::Win32::Storage::FileSystem::{
+    FileRenameInfo, FlushFileBuffers, SetFileInformationByHandle, FILE_RENAME_INFO,
+};
+
+/// A failed flush after rename must not authorize an automatic retry of a possibly committed write.
+#[derive(Debug)]
+pub(crate) enum ReplaceError {
+    Before(io::Error),
+    After(io::Error),
+}
+
+/// Flush the temp, rename relative to a pinned parent, then report uncertain post-rename flush failures.
+pub(crate) fn replace_owned(
+    file: &File,
+    parent: &PinnedDirectory,
+    name: &OsStr,
+) -> Result<(), ReplaceError> {
+    let name = replacement_name(name).map_err(ReplaceError::Before)?;
+    parent.validate().map_err(ReplaceError::Before)?;
+    validate_kind(file, ResourceKind::File).map_err(ReplaceError::Before)?;
+    security::verify(file, true).map_err(ReplaceError::Before)?;
+    flush(file).map_err(ReplaceError::Before)?;
+    let held = parent
+        .handles
+        .last()
+        .ok_or_else(security::denied)
+        .map_err(ReplaceError::Before)?;
+    rename(file, held, &name).map_err(ReplaceError::Before)?;
+    flush(file).map_err(ReplaceError::After)
+}
+
+fn replacement_name(name: &OsStr) -> io::Result<Vec<u16>> {
+    let value = wide(name)?;
+    let content = &value[..value.len() - 1];
+    // A single normal filename excludes traversal, streams and Win32 trailing-dot/space aliases.
+    if content.is_empty()
+        || content.iter().any(|value| matches!(*value, 47 | 92 | 58))
+        || matches!(content.last(), Some(32 | 46))
+    {
+        return Err(security::denied());
+    }
+    Ok(value)
+}
+
+fn rename(file: &File, parent: &File, name: &[u16]) -> io::Result<()> {
+    let bytes = (name.len() - 1)
+        .checked_mul(std::mem::size_of::<u16>())
+        .ok_or_else(security::denied)?;
+    let size = std::mem::offset_of!(FILE_RENAME_INFO, FileName)
+        .checked_add(bytes)
+        .ok_or_else(security::denied)?;
+    let byte_count = u32::try_from(bytes).map_err(|_| security::denied())?;
+    let native_size = u32::try_from(size).map_err(|_| security::denied())?;
+    let mut buffer = vec![
+        0usize;
+        size.max(std::mem::size_of::<FILE_RENAME_INFO>())
+            .div_ceil(std::mem::size_of::<usize>())
+    ];
+    // SAFETY: usize storage aligns the native structure and covers header/name; borrowed handles and UTF-16 stay live.
+    unsafe {
+        let rename = buffer.as_mut_ptr().cast::<FILE_RENAME_INFO>();
+        (*rename).Anonymous.ReplaceIfExists = true;
+        (*rename).RootDirectory = parent.as_raw_handle();
+        (*rename).FileNameLength = byte_count;
+        std::ptr::copy_nonoverlapping(
+            name.as_ptr(),
+            std::ptr::addr_of_mut!((*rename).FileName).cast(),
+            name.len() - 1,
+        );
+        if SetFileInformationByHandle(
+            file.as_raw_handle(),
+            FileRenameInfo,
+            rename.cast(),
+            native_size,
+        ) == 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+    }
+    Ok(())
+}
+
+fn flush(file: &File) -> io::Result<()> {
+    // SAFETY: File owns a live writable disk handle; this module never flushes a pipe or console.
+    if unsafe { FlushFileBuffers(file.as_raw_handle()) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
diff --git a/src-tauri/src/settings_service/windows_store/security.rs b/src-tauri/src/settings_service/windows_store/security.rs
new file mode 100644
index 0000000..e8b8761
--- /dev/null
+++ b/src-tauri/src/settings_service/windows_store/security.rs
@@ -0,0 +1,243 @@
+//! Current-user file ownership and private creation ACLs, independent of logon-session IPC.
+use std::{fs::File, io, os::windows::io::AsRawHandle};
+use windows_sys::Win32::{
+    Foundation::{CloseHandle, LocalFree},
+    Security::{
+        AclSizeInformation,
+        Authorization::{
+            ConvertSidToStringSidW, ConvertStringSecurityDescriptorToSecurityDescriptorW,
+            GetSecurityInfo, SDDL_REVISION_1, SE_FILE_OBJECT,
+        },
+        GetAce, GetAclInformation, GetSecurityDescriptorControl, GetTokenInformation, IsValidSid,
+        TokenUser, ACCESS_ALLOWED_ACE, ACE_HEADER, ACL, ACL_SIZE_INFORMATION,
+        DACL_SECURITY_INFORMATION, OWNER_SECURITY_INFORMATION, PSID, SECURITY_ATTRIBUTES,
+        SE_DACL_PROTECTED, TOKEN_QUERY, TOKEN_USER,
+    },
+    System::Threading::{GetCurrentProcess, OpenProcessToken},
+};
+// Token inspection is bounded like the settings IPC implementation; SID text is bounded by Windows SID limits.
+const TOKEN_BYTES: usize = 65_536;
+const SID_CHARS: usize = 192;
+// ACCESS_ALLOWED_ACE_TYPE from winnt.h; the bindings place this constant in an otherwise unused SDK feature.
+const ALLOW_ACE: u8 = 0;
+
+pub(super) fn denied() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        "private settings resource unavailable",
+    )
+}
+
+/// LocalAlloc descriptor ownership; its borrowed SID/ACL pointers expire on drop.
+pub(super) struct Descriptor(*mut core::ffi::c_void);
+impl Drop for Descriptor {
+    fn drop(&mut self) {
+        // SAFETY: construction owns exactly one LocalAlloc descriptor; drop frees it once.
+        unsafe {
+            LocalFree(self.0);
+        }
+    }
+}
+impl Descriptor {
+    /// Create a protected, non-inheritable descriptor granting only the persistent account SID.
+    pub(super) fn private(sid: &str) -> io::Result<Self> {
+        // Explicit owner avoids the Administrators default owner of an elevated token.
+        let sddl: Vec<u16> = format!("O:{sid}D:P(A;;FA;;;{sid})")
+            .encode_utf16()
+            .chain(Some(0))
+            .collect();
+        let mut descriptor = std::ptr::null_mut();
+        // SAFETY: terminated UTF-16 and initialized descriptor output live through the conversion.
+        if unsafe {
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                sddl.as_ptr(),
+                SDDL_REVISION_1,
+                &mut descriptor,
+                std::ptr::null_mut(),
+            )
+        } == 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self(descriptor))
+    }
+    /// Borrow non-inheritable native creation attributes; this descriptor must outlive the API call.
+    pub(super) fn attributes(&self) -> SECURITY_ATTRIBUTES {
+        SECURITY_ATTRIBUTES {
+            nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: self.0,
+            bInheritHandle: 0,
+        }
+    }
+}
+
+/// Return TokenUser identity, never the temporary TokenLogonSid used by IPC.
+pub(super) fn current_user_sid() -> io::Result<String> {
+    let mut token = std::ptr::null_mut();
+    // SAFETY: process pseudo-handle and initialized token output are valid.
+    if unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let result = token_user(token);
+    // SAFETY: successful OpenProcessToken transfers this owned handle, closed once after inspection.
+    unsafe {
+        CloseHandle(token);
+    }
+    result
+}
+
+fn token_user(token: windows_sys::Win32::Foundation::HANDLE) -> io::Result<String> {
+    let mut buffer = vec![0usize; TOKEN_BYTES / std::mem::size_of::<usize>()];
+    let mut length = 0;
+    // SAFETY: usize allocation aligns TOKEN_USER; bounded writable storage/token remain live throughout.
+    unsafe {
+        if GetTokenInformation(
+            token,
+            TokenUser,
+            buffer.as_mut_ptr().cast(),
+            TOKEN_BYTES as u32,
+            &mut length,
+        ) == 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        if length < std::mem::size_of::<TOKEN_USER>() as u32 || length as usize > TOKEN_BYTES {
+            return Err(denied());
+        }
+        sid_text((*buffer.as_ptr().cast::<TOKEN_USER>()).User.Sid)
+    }
+}
+
+fn sid_text(sid: PSID) -> io::Result<String> {
+    let mut text = std::ptr::null_mut();
+    // SAFETY: caller supplies a SID from a live native token/security descriptor/validated ACE.
+    if sid.is_null() || unsafe { IsValidSid(sid) } == 0 {
+        return Err(denied());
+    }
+    // SAFETY: validated SID and initialized output; successful conversion allocates LocalAlloc text.
+    if unsafe { ConvertSidToStringSidW(sid, &mut text) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let result = decode_text(text);
+    // SAFETY: successful conversion allocated text and decode does not retain it.
+    unsafe {
+        LocalFree(text.cast());
+    }
+    result
+}
+
+fn decode_text(text: *const u16) -> io::Result<String> {
+    let mut count = 0;
+    // SAFETY: SID conversion supplies terminated text; reject overlong values instead of truncating.
+    unsafe {
+        while count < SID_CHARS && *text.add(count) != 0 {
+            count += 1;
+        }
+        if count == SID_CHARS {
+            return Err(denied());
+        }
+        String::from_utf16(std::slice::from_raw_parts(text, count)).map_err(|_| denied())
+    }
+}
+
+/// Verify by handle. Legacy ACLs may grant SYSTEM/Admin privileges; new resources grant only the user.
+pub(super) fn verify(file: &File, strict: bool) -> io::Result<()> {
+    let expected = current_user_sid()?;
+    let mut owner = std::ptr::null_mut();
+    let mut acl = std::ptr::null_mut();
+    let mut descriptor = std::ptr::null_mut();
+    // SAFETY: owned File and initialized outputs remain live; success returns one LocalAlloc descriptor.
+    let error = unsafe {
+        GetSecurityInfo(
+            file.as_raw_handle(),
+            SE_FILE_OBJECT,
+            OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+            &mut owner,
+            std::ptr::null_mut(),
+            &mut acl,
+            std::ptr::null_mut(),
+            &mut descriptor,
+        )
+    };
+    if error != 0 {
+        return Err(io::Error::from_raw_os_error(error as i32));
+    }
+    let held = Descriptor(descriptor);
+    if descriptor.is_null() || sid_text(owner)? != expected || acl.is_null() {
+        return Err(denied());
+    }
+    if strict {
+        require_protected(&held)?;
+    }
+    verify_acl(acl, &expected, strict)
+}
+
+fn require_protected(descriptor: &Descriptor) -> io::Result<()> {
+    let mut control = 0;
+    let mut revision = 0;
+    // SAFETY: descriptor guard owns valid security storage; scalar outputs are initialized.
+    if unsafe { GetSecurityDescriptorControl(descriptor.0, &mut control, &mut revision) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if control & SE_DACL_PROTECTED == 0 {
+        return Err(denied());
+    }
+    Ok(())
+}
+
+fn verify_acl(acl: *const ACL, user: &str, strict: bool) -> io::Result<()> {
+    let mut info = ACL_SIZE_INFORMATION::default();
+    // SAFETY: GetSecurityInfo supplied this non-null ACL; output size matches the initialized structure.
+    if unsafe {
+        GetAclInformation(
+            acl,
+            (&mut info as *mut ACL_SIZE_INFORMATION).cast(),
+            std::mem::size_of_val(&info) as u32,
+            AclSizeInformation,
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    if info.AceCount == 0 {
+        return Err(denied());
+    }
+    for index in 0..info.AceCount {
+        let mut ace = std::ptr::null_mut();
+        // SAFETY: index is bounded by native ACL count; output points into the live descriptor.
+        if unsafe { GetAce(acl, index, &mut ace) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        verify_ace(ace, user, strict)?;
+    }
+    Ok(())
+}
+
+fn verify_ace(ace: *const core::ffi::c_void, user: &str, strict: bool) -> io::Result<()> {
+    if ace.is_null() {
+        return Err(denied());
+    }
+    // SAFETY: GetAce returned an ACE from a live validated native ACL; header bounds subsequent fields.
+    unsafe {
+        let header = &*ace.cast::<ACE_HEADER>();
+        if header.AceType != ALLOW_ACE
+            || (header.AceSize as usize) < std::mem::size_of::<ACCESS_ALLOWED_ACE>()
+        {
+            return Err(denied());
+        }
+        let allowed = &*ace.cast::<ACCESS_ALLOWED_ACE>();
+        let sid: PSID = std::ptr::addr_of!(allowed.SidStart).cast_mut().cast();
+        // Bound SID sub-authorities inside this ACE before IsValidSid follows its variable-length tail.
+        let offset = std::mem::offset_of!(ACCESS_ALLOWED_ACE, SidStart);
+        let sid_bytes = header.AceSize as usize - offset;
+        if sid_bytes < 8 || 8 + 4 * usize::from(*sid.cast::<u8>().add(1)) > sid_bytes {
+            return Err(denied());
+        }
+        let text = sid_text(sid)?;
+        // OS privilege principals cannot be excluded from administrative access; other users/groups are refused.
+        if text != user && (strict || !matches!(text.as_str(), "S-1-5-18" | "S-1-5-32-544")) {
+            return Err(denied());
+        }
+    }
+    Ok(())
+}
diff --git a/src-tauri/tests/settings_transactions.rs b/src-tauri/tests/settings_transactions.rs
new file mode 100644
index 0000000..93cc4a1
--- /dev/null
+++ b/src-tauri/tests/settings_transactions.rs
@@ -0,0 +1,15 @@
+//! Real filesystem and process contracts for atomic settings storage.
+#[path = "settings_transactions/driver.rs"]
+mod driver;
+#[path = "settings_transactions/faults.rs"]
+mod faults;
+#[path = "settings_transactions/locator.rs"]
+mod locator;
+#[path = "settings_transactions/ownership.rs"]
+mod ownership;
+#[path = "settings_transactions/processes.rs"]
+mod processes;
+#[path = "settings_transactions/reads.rs"]
+mod reads;
+#[path = "settings_transactions/transactions.rs"]
+mod transactions;
diff --git a/src-tauri/tests/settings_transactions/driver.rs b/src-tauri/tests/settings_transactions/driver.rs
new file mode 100644
index 0000000..ac928fa
--- /dev/null
+++ b/src-tauri/tests/settings_transactions/driver.rs
@@ -0,0 +1,219 @@
+//! Test-only process driver links the exact production repository and coordinates stdin barriers.
+use handy_app_lib::settings_service::{
+    ownership::LegacyPathProbe,
+    store::SettingsRepository,
+    validation::{validate_cli, ValidationContext},
+};
+use serde_json::{json, Value};
+use std::{
+    io::{BufRead, Write},
+    process::{Child, ChildStdin, Command, Stdio},
+    sync::mpsc::{self, Receiver},
+    time::{Duration, Instant},
+};
+type TestResult<T> = Result<T, Box<dyn std::error::Error>>;
+const DEADLINE: Duration = Duration::from_secs(10);
+pub(super) struct Driver {
+    child: Child,
+    input: ChildStdin,
+    lines: Receiver<String>,
+}
+impl Driver {
+    pub(super) fn start(
+        path: &std::path::Path,
+        mode: &str,
+        key: &str,
+        value: &str,
+    ) -> TestResult<Self> {
+        let mut child = Command::new(std::env::current_exe()?)
+            .args([
+                "--exact",
+                "driver::repository_subprocess_fixture",
+                "--ignored",
+                "--nocapture",
+            ])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()?;
+        let input = child.stdin.take().ok_or("child stdin")?;
+        let stdout = child.stdout.take().ok_or("child stdout")?;
+        let (sender, lines) = mpsc::channel();
+        std::thread::spawn(move || {
+            for line in std::io::BufReader::new(stdout).lines() {
+                match line {
+                    Ok(line) => {
+                        if sender.send(line).is_err() {
+                            break;
+                        }
+                    }
+                    Err(_) => break,
+                }
+            }
+        });
+        let mut driver = Self {
+            child,
+            input,
+            lines,
+        };
+        driver.send(&json!({"path":path,"mode":mode,"key":key,"value":value}).to_string())?;
+        driver.receive("READY")?;
+        Ok(driver)
+    }
+    pub(super) fn send(&mut self, line: &str) -> TestResult<()> {
+        writeln!(self.input, "{line}")?;
+        self.input.flush()?;
+        Ok(())
+    }
+    fn receive(&self, prefix: &str) -> TestResult<String> {
+        let deadline = Instant::now() + DEADLINE;
+        loop {
+            let line = self
+                .lines
+                .recv_timeout(deadline.saturating_duration_since(Instant::now()))?;
+            if line.starts_with(prefix) {
+                eprintln!("NESTED {} {line}", self.child.id());
+                return Ok(line);
+            }
+        }
+    }
+    pub(super) fn kill_at_barrier(mut self) -> TestResult<()> {
+        self.child.kill()?;
+        let status = self.child.wait()?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::process::ExitStatusExt;
+            assert_eq!(status.signal(), Some(libc::SIGKILL));
+        }
+        eprintln!("NESTED_KILL {} {:?}", self.child.id(), status.code());
+        assert!(!status.success());
+        Ok(())
+    }
+    pub(super) fn wait_crash_barrier(&self) -> TestResult<()> {
+        self.receive("CRASH_READY")?;
+        Ok(())
+    }
+    pub(super) fn outcome(&self) -> TestResult<Value> {
+        Ok(serde_json::from_str(
+            self.receive("RESULT ")?
+                .strip_prefix("RESULT ")
+                .ok_or("result")?,
+        )?)
+    }
+    pub(super) fn finish(mut self) -> TestResult<()> {
+        let deadline = Instant::now() + DEADLINE;
+        loop {
+            if let Some(status) = self.child.try_wait()? {
+                println!(
+                    "NESTED_EXIT {} {}",
+                    self.child.id(),
+                    status.code().unwrap_or(-1)
+                );
+                assert!(status.success());
+                return Ok(());
+            }
+            if Instant::now() >= deadline {
+                self.child.kill()?;
+                return Err("child deadline".into());
+            }
+            std::thread::yield_now();
+        }
+    }
+}
+impl Drop for Driver {
+    fn drop(&mut self) {
+        // Fixture cleanup owns only this spawned test process; never a user application process.
+        if matches!(self.child.try_wait(), Ok(None)) {
+            let _ = self.child.kill();
+            let _ = self.child.wait();
+        }
+    }
+}
+#[test]
+#[ignore = "test-only subprocess entry point; executed by process/crash contracts with stdin barriers"]
+fn repository_subprocess_fixture() -> TestResult<()> {
+    let stdin = std::io::stdin();
+    let mut input = stdin.lock();
+    let mut line = String::new();
+    input.read_line(&mut line)?;
+    let config: Value = serde_json::from_str(&line)?;
+    let path = std::path::PathBuf::from(config["path"].as_str().ok_or("path")?);
+    let probe = LegacyPathProbe::new(path.with_file_name("absent-legacy.sock"));
+    let repository = SettingsRepository::new(path);
+    println!("READY");
+    std::io::stdout().flush()?;
+    line.clear();
+    input.read_line(&mut line)?;
+    assert_eq!(line.trim(), "GO");
+    if config["mode"] == "startup" {
+        let (read, lease) = repository.initialize(&probe)?;
+        println!(
+            "RESULT {}",
+            json!({"ok":true,"revision":read.snapshot.revision.0})
+        );
+        std::io::stdout().flush()?;
+        line.clear();
+        input.read_line(&mut line)?;
+        assert_eq!(line.trim(), "RELEASE");
+        drop(lease);
+    } else {
+        drop(input);
+        write_fixture(&repository, &probe, &config)?;
+    }
+    Ok(())
+}
+
+struct CrashPause(handy_app_lib::settings_service::transaction::PersistStage);
+impl handy_app_lib::settings_service::transaction::PersistObserver for CrashPause {
+    fn observe(
+        &self,
+        stage: handy_app_lib::settings_service::transaction::PersistStage,
+    ) -> std::io::Result<()> {
+        if stage == self.0 {
+            println!("CRASH_READY");
+            std::io::stdout().flush()?;
+            // The parent terminates this owned fixture here; no Rust error/unwind/Drop simulates the crash.
+            let mut line = String::new();
+            std::io::stdin().lock().read_line(&mut line)?;
+            return Err(std::io::Error::other("crash barrier unexpectedly released"));
+        }
+        Ok(())
+    }
+}
+fn write_fixture(
+    repository: &SettingsRepository,
+    probe: &LegacyPathProbe,
+    config: &Value,
+) -> TestResult<()> {
+    use handy_app_lib::settings_service::transaction::PersistStage;
+    let mutation = validate_cli(
+        config["key"].as_str().ok_or("key")?,
+        config["value"].as_str().ok_or("value")?,
+        &ValidationContext {
+            prompt_ids: &[],
+            updates_allowed: true,
+        },
+    )?;
+    let result = match config["mode"].as_str() {
+        Some("crash_before") => repository.commit_with_probe(
+            mutation,
+            None,
+            probe,
+            &CrashPause(PersistStage::BeforeReplace),
+        ),
+        Some("crash_after") => repository.commit_with_probe(
+            mutation,
+            None,
+            probe,
+            &CrashPause(PersistStage::AfterReplace),
+        ),
+        _ => repository.commit_with_probe(mutation, None, probe, &()),
+    };
+    let outcome = match result {
+        Ok(read) => json!({"ok":true,"revision":read.snapshot.revision.0}),
+        Err(error) => json!({"ok":false,"error":error}),
+    };
+    println!("RESULT {outcome}");
+    std::io::stdout().flush()?;
+    Ok(())
+}
diff --git a/src-tauri/tests/settings_transactions/faults.rs b/src-tauri/tests/settings_transactions/faults.rs
new file mode 100644
index 0000000..317e17d
--- /dev/null
+++ b/src-tauri/tests/settings_transactions/faults.rs
@@ -0,0 +1,151 @@
+//! Fault stages expose only complete old/new JSON; substitutes are retained unmodified.
+use handy_app_lib::settings_service::{
+    errors::SettingsErrorCode,
+    ownership::LegacyPathProbe,
+    store::SettingsRepository,
+    transaction::{PersistObserver, PersistStage},
+    validation::{validate_cli, ValidationContext},
+};
+use serde_json::json;
+struct FailAt(PersistStage);
+impl PersistObserver for FailAt {
+    fn observe(&self, stage: PersistStage) -> std::io::Result<()> {
+        if stage == self.0 {
+            return Err(std::io::Error::other("injected filesystem failure"));
+        }
+        Ok(())
+    }
+}
+#[test]
+fn every_durable_fault_preserves_a_complete_generation_and_reports_uncertainty(
+) -> Result<(), Box<dyn std::error::Error>> {
+    for stage in [
+        PersistStage::BeforeWrite,
+        PersistStage::AfterWrite,
+        PersistStage::AfterFileSync,
+        PersistStage::BeforeReplace,
+        PersistStage::AfterReplace,
+        PersistStage::AfterDirectorySync,
+    ] {
+        let directory = tempfile::tempdir()?;
+        let path = directory.path().join("settings_store.json");
+        let original = json!({"settings_revision":7,"settings":{"audio_feedback":true,"unknown":"CANARY_KEEP"}});
+        std::fs::write(&path, serde_json::to_vec(&original)?)?;
+        let mutation = validate_cli(
+            "audio_feedback",
+            "false",
+            &ValidationContext {
+                prompt_ids: &[],
+                updates_allowed: true,
+            },
+        )?;
+        let probe = LegacyPathProbe::new(directory.path().join("absent.sock"));
+        let error = SettingsRepository::new(path.clone())
+            .commit_with_probe(mutation, None, &probe, &FailAt(stage))
+            .err()
+            .ok_or("fault succeeded")?;
+        let disk: serde_json::Value = serde_json::from_slice(&std::fs::read(&path)?)?;
+        if matches!(
+            stage,
+            PersistStage::AfterReplace | PersistStage::AfterDirectorySync
+        ) {
+            assert_eq!(error.code(), SettingsErrorCode::Unavailable);
+            assert_eq!(
+                serde_json::to_value(error)?["details"]["outcome"],
+                "unknown"
+            );
+            assert_eq!(disk["settings_revision"], 8);
+            assert_eq!(disk["settings"]["audio_feedback"], false);
+        } else {
+            assert_eq!(error.code(), SettingsErrorCode::PersistenceFailed);
+            assert_eq!(disk, original);
+        }
+        assert_eq!(disk["settings"]["unknown"], "CANARY_KEEP");
+    }
+    Ok(())
+}
+struct ReplaceTemp {
+    directory: std::path::PathBuf,
+    substitute: std::sync::Mutex<Option<std::path::PathBuf>>,
+}
+impl PersistObserver for ReplaceTemp {
+    fn observe(&self, stage: PersistStage) -> std::io::Result<()> {
+        if stage == PersistStage::BeforeReplace {
+            let path = std::fs::read_dir(&self.directory)?
+                .filter_map(Result::ok)
+                .map(|entry| entry.path())
+                .find(|path| path.extension().is_some_and(|extension| extension == "tmp"))
+                .ok_or_else(|| std::io::Error::other("private temp missing"))?;
+            std::fs::rename(&path, self.directory.join("retained-original"))?;
+            std::fs::write(&path, b"CANARY_SUBSTITUTE")?;
+            *self
+                .substitute
+                .lock()
+                .map_err(|_| std::io::Error::other("substitute mutex"))? = Some(path);
+        }
+        Ok(())
+    }
+}
+#[test]
+fn replaced_temporary_path_never_replaces_store_or_deletes_substitute(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let bytes =
+        serde_json::to_vec(&json!({"settings_revision":7,"settings":{"audio_feedback":true}}))?;
+    std::fs::write(&path, &bytes)?;
+    let observer = ReplaceTemp {
+        directory: directory.path().to_path_buf(),
+        substitute: std::sync::Mutex::new(None),
+    };
+    let mutation = validate_cli(
+        "audio_feedback",
+        "false",
+        &ValidationContext {
+            prompt_ids: &[],
+            updates_allowed: true,
+        },
+    )?;
+    let probe = LegacyPathProbe::new(directory.path().join("absent.sock"));
+    let error = SettingsRepository::new(path.clone())
+        .commit_with_probe(mutation, None, &probe, &observer)
+        .err()
+        .ok_or("substitute persisted")?;
+    assert_eq!(error.code(), SettingsErrorCode::PersistenceFailed);
+    assert_eq!(std::fs::read(path)?, bytes);
+    let substitute = observer
+        .substitute
+        .lock()
+        .map_err(|_| "mutex")?
+        .clone()
+        .ok_or("substitute path")?;
+    assert_eq!(std::fs::read(substitute)?, b"CANARY_SUBSTITUTE");
+    Ok(())
+}
+#[test]
+#[cfg(unix)]
+fn stable_lock_inode_survives_replacement_and_is_retained_after_release(
+) -> Result<(), Box<dyn std::error::Error>> {
+    use std::os::unix::fs::MetadataExt;
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let repository = SettingsRepository::new(path.clone());
+    repository.read_snapshot()?;
+    let lock = directory.path().join("settings.lock");
+    let inode = std::fs::metadata(&lock)?.ino();
+    let probe = LegacyPathProbe::new(directory.path().join("absent.sock"));
+    for value in ["false", "true"] {
+        let mutation = validate_cli(
+            "audio_feedback",
+            value,
+            &ValidationContext {
+                prompt_ids: &[],
+                updates_allowed: true,
+            },
+        )?;
+        repository.commit_with_probe(mutation, None, &probe, &())?;
+        assert_eq!(std::fs::metadata(&lock)?.ino(), inode);
+    }
+    assert!(lock.is_file());
+    Ok(())
+}
diff --git a/src-tauri/tests/settings_transactions/locator.rs b/src-tauri/tests/settings_transactions/locator.rs
new file mode 100644
index 0000000..8ce3663
--- /dev/null
+++ b/src-tauri/tests/settings_transactions/locator.rs
@@ -0,0 +1,73 @@
+//! Native path-provider parity and portable marker reads never create or upgrade data.
+use handy_app_lib::settings_service::locator::StoreLocator;
+#[test]
+fn installed_resolution_uses_the_same_directory_provider_as_tauri(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let executable = directory.path().join("handy");
+    let installed = directory.path().join("installed");
+    let path = StoreLocator::resolve(&executable, &installed)?;
+    assert_eq!(
+        path,
+        directory
+            .path()
+            .canonicalize()?
+            .join("installed/settings_store.json")
+    );
+    assert!(!installed.exists());
+    let os = dirs::data_dir()
+        .ok_or("OS data directory")?
+        .join("com.pais.handy");
+    let injected = StoreLocator::resolve(&executable, &os)?;
+    assert_eq!(
+        injected.file_name(),
+        Some(std::ffi::OsStr::new("settings_store.json"))
+    );
+    assert!(injected.ends_with("com.pais.handy/settings_store.json"));
+    Ok(())
+}
+#[test]
+fn portable_magic_and_legacy_markers_are_read_without_mutation(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let executable = directory.path().join("handy");
+    let marker = directory.path().join("portable");
+    let data = directory.path().join("Data");
+    let installed = directory.path().join("installed");
+    std::fs::write(&marker, "Handy Portable Mode\n")?;
+    let bytes = std::fs::read(&marker)?;
+    assert_eq!(
+        StoreLocator::resolve(&executable, &installed)?,
+        directory
+            .path()
+            .canonicalize()?
+            .join("Data/settings_store.json")
+    );
+    assert!(!data.exists());
+    assert_eq!(std::fs::read(&marker)?, bytes);
+    std::fs::write(&marker, [])?;
+    assert!(
+        StoreLocator::resolve(&executable, &installed)?.ends_with("installed/settings_store.json")
+    );
+    std::fs::create_dir(&data)?;
+    assert!(StoreLocator::resolve(&executable, &installed)?.ends_with("Data/settings_store.json"));
+    assert_eq!(std::fs::read(marker)?, b"");
+    Ok(())
+}
+#[test]
+fn missing_ancestor_is_canonicalized_and_parent_traversal_is_refused(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let executable = directory.path().join("handy");
+    let root = directory.path().join("missing/child");
+    assert_eq!(
+        StoreLocator::resolve(&executable, &root)?,
+        directory
+            .path()
+            .canonicalize()?
+            .join("missing/child/settings_store.json")
+    );
+    assert!(!root.exists());
+    assert!(StoreLocator::resolve(&executable, &directory.path().join("../foreign")).is_err());
+    Ok(())
+}
diff --git a/src-tauri/tests/settings_transactions/ownership.rs b/src-tauri/tests/settings_transactions/ownership.rs
new file mode 100644
index 0000000..526dd13
--- /dev/null
+++ b/src-tauri/tests/settings_transactions/ownership.rs
@@ -0,0 +1,141 @@
+//! Native isolated owner resources and startup leases prevent offline commits.
+use handy_app_lib::settings_service::{
+    errors::SettingsErrorCode,
+    ownership::LegacyPathProbe,
+    store::SettingsRepository,
+    transaction::{PersistObserver, PersistStage},
+    validation::{validate_cli, ValidationContext},
+};
+use serde_json::json;
+#[cfg(unix)]
+struct AppearingOwner {
+    path: std::path::PathBuf,
+    listener: std::sync::Mutex<Option<std::os::unix::net::UnixListener>>,
+}
+#[cfg(unix)]
+impl PersistObserver for AppearingOwner {
+    fn observe(&self, stage: PersistStage) -> std::io::Result<()> {
+        if stage == PersistStage::AfterFileSync {
+            *self
+                .listener
+                .lock()
+                .map_err(|_| std::io::Error::other("listener mutex"))? =
+                Some(std::os::unix::net::UnixListener::bind(&self.path)?);
+        }
+        Ok(())
+    }
+}
+#[test]
+#[cfg(unix)]
+fn native_owner_appearing_after_temp_sync_refuses_before_replace(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let bytes =
+        serde_json::to_vec(&json!({"settings_revision":7,"settings":{"audio_feedback":true}}))?;
+    std::fs::write(&path, &bytes)?;
+    let owner = directory.path().join("legacy.sock");
+    let probe = LegacyPathProbe::new(owner.clone());
+    let observer = AppearingOwner {
+        path: owner,
+        listener: std::sync::Mutex::new(None),
+    };
+    let mutation = validate_cli(
+        "audio_feedback",
+        "false",
+        &ValidationContext {
+            prompt_ids: &[],
+            updates_allowed: true,
+        },
+    )?;
+    let error = SettingsRepository::new(path.clone())
+        .commit_with_probe(mutation, None, &probe, &observer)
+        .err()
+        .ok_or("native owner ignored at commit")?;
+    assert_eq!(error.code(), SettingsErrorCode::Unavailable);
+    assert_eq!(std::fs::read(path)?, bytes);
+    Ok(())
+}
+#[test]
+fn startup_normalizes_once_preserves_raw_secrets_and_keeps_offline_fenced(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let probe = LegacyPathProbe::new(directory.path().join("absent.sock"));
+    let stored = json!({"settings_revision":41,"unknown_top":"CANARY_TOP","settings":{"push_to_talk":true,"selected_model":"chosen","post_process_api_keys":{"custom":"CANARY_KEY"},"post_process_providers":[{"id":"custom","label":"Custom","base_url":"https://example.invalid","unknown_secret":"CANARY_PROVIDER"}],"unknown_payload":"CANARY_PAYLOAD"}});
+    std::fs::write(&path, serde_json::to_vec(&stored)?)?;
+    let repository = SettingsRepository::new(path.clone());
+    let (read, lease) = repository.initialize(&probe)?;
+    assert_eq!(read.snapshot.revision.0, 42);
+    lease.validate()?;
+    let bytes = std::fs::read(&path)?;
+    let disk: serde_json::Value = serde_json::from_slice(&bytes)?;
+    assert_eq!(disk["unknown_top"], stored["unknown_top"]);
+    assert_eq!(
+        disk["settings"]["unknown_payload"],
+        stored["settings"]["unknown_payload"]
+    );
+    assert_eq!(
+        disk["settings"]["post_process_api_keys"],
+        stored["settings"]["post_process_api_keys"]
+    );
+    assert_eq!(
+        disk["settings"]["post_process_providers"][0]["unknown_secret"],
+        "CANARY_PROVIDER"
+    );
+    let mutation = validate_cli(
+        "audio_feedback",
+        "false",
+        &ValidationContext {
+            prompt_ids: &[],
+            updates_allowed: true,
+        },
+    )?;
+    let error = repository
+        .commit_with_probe(mutation, None, &probe, &())
+        .err()
+        .ok_or("busy startup permitted offline")?;
+    assert_eq!(error.code(), SettingsErrorCode::Unavailable);
+    assert_eq!(std::fs::read(&path)?, bytes);
+    drop(lease);
+    let (second, lease) = repository.initialize(&probe)?;
+    assert_eq!(second.snapshot.revision.0, 42);
+    assert_eq!(std::fs::read(path)?, bytes);
+    drop(lease);
+    Ok(())
+}
+#[test]
+#[cfg(unix)]
+fn passive_occupied_socket_refuses_without_connecting_or_deleting(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let owner = directory.path().join("legacy.sock");
+    let listener = std::os::unix::net::UnixListener::bind(&owner)?;
+    listener.set_nonblocking(true)?;
+    let probe = LegacyPathProbe::new(owner.clone());
+    let mutation = validate_cli(
+        "audio_feedback",
+        "false",
+        &ValidationContext {
+            prompt_ids: &[],
+            updates_allowed: true,
+        },
+    )?;
+    let error = SettingsRepository::new(path.clone())
+        .commit_with_probe(mutation, None, &probe, &())
+        .err()
+        .ok_or("occupied owner accepted")?;
+    assert_eq!(error.code(), SettingsErrorCode::Unavailable);
+    assert!(!path.exists());
+    assert!(owner.exists());
+    assert_eq!(
+        listener
+            .accept()
+            .err()
+            .ok_or("passive probe connected")?
+            .kind(),
+        std::io::ErrorKind::WouldBlock
+    );
+    Ok(())
+}
diff --git a/src-tauri/tests/settings_transactions/processes.rs b/src-tauri/tests/settings_transactions/processes.rs
new file mode 100644
index 0000000..1a08b77
--- /dev/null
+++ b/src-tauri/tests/settings_transactions/processes.rs
@@ -0,0 +1,231 @@
+//! Subprocess barriers and an independent reader verify real atomic repository generations.
+use super::driver::Driver;
+use handy_app_lib::settings_service::{
+    ownership::LegacyPathProbe,
+    store::SettingsRepository,
+    validation::{validate_cli, ValidationContext},
+};
+use serde_json::{json, Value};
+use std::time::{Duration, Instant};
+type TestResult<T> = Result<T, Box<dyn std::error::Error>>;
+const DEADLINE: Duration = Duration::from_secs(10);
+#[test]
+fn two_barrier_started_subprocess_writers_preserve_disjoint_fields() -> TestResult<()> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    std::fs::write(
+        &path,
+        serde_json::to_vec(
+            &json!({"settings_revision":0,"settings":{"audio_feedback":true,"start_hidden":false}}),
+        )?,
+    )?;
+    let mut first = Driver::start(&path, "write", "audio_feedback", "false")?;
+    let mut second = Driver::start(&path, "write", "start_hidden", "true")?;
+    first.send("GO")?;
+    second.send("GO")?;
+    let first_result = first.outcome()?;
+    let second_result = second.outcome()?;
+    assert_eq!(first_result["ok"], true);
+    assert_eq!(second_result["ok"], true);
+    let mut revisions = vec![
+        first_result["revision"].as_u64().ok_or("revision")?,
+        second_result["revision"].as_u64().ok_or("revision")?,
+    ];
+    revisions.sort();
+    assert_eq!(revisions, [1, 2]);
+    first.finish()?;
+    second.finish()?;
+    let disk: Value = serde_json::from_slice(&std::fs::read(path)?)?;
+    assert_eq!(disk["settings_revision"], 2);
+    assert_eq!(disk["settings"]["audio_feedback"], false);
+    assert_eq!(disk["settings"]["start_hidden"], true);
+    Ok(())
+}
+#[test]
+fn barrier_started_startup_and_writer_respect_real_lease_ownership() -> TestResult<()> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let original = serde_json::to_value(
+        SettingsRepository::new(path.clone())
+            .read_snapshot()?
+            .snapshot
+            .public_settings(),
+    )?["audio_feedback"]
+        .as_bool()
+        .ok_or("default feedback")?;
+    let mut startup = Driver::start(&path, "startup", "", "")?;
+    let mut writer = Driver::start(
+        &path,
+        "write",
+        "audio_feedback",
+        if original { "false" } else { "true" },
+    )?;
+    startup.send("GO")?;
+    writer.send("GO")?;
+    let startup_result = startup.outcome()?;
+    let writer_result = writer.outcome()?;
+    assert_eq!(startup_result["ok"], true);
+    let disk: Value = serde_json::from_slice(&std::fs::read(&path)?)?;
+    if writer_result["ok"] == true {
+        assert_eq!(disk["settings"]["audio_feedback"], !original);
+        assert!(
+            startup_result["revision"]
+                .as_u64()
+                .ok_or("startup revision")?
+                >= writer_result["revision"]
+                    .as_u64()
+                    .ok_or("writer revision")?
+        );
+    } else {
+        assert_eq!(writer_result["error"]["code"], "unavailable");
+        assert_eq!(disk["settings_revision"], startup_result["revision"]);
+    }
+    startup.send("RELEASE")?;
+    startup.finish()?;
+    writer.finish()?;
+    Ok(())
+}
+#[test]
+fn independent_raw_reader_observes_only_complete_old_or_new_generations() -> TestResult<()> {
+    use std::sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc, Barrier,
+    };
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    std::fs::write(
+        &path,
+        serde_json::to_vec(&json!({"settings_revision":0,"settings":{"audio_feedback":true}}))?,
+    )?;
+    let barrier = Arc::new(Barrier::new(2));
+    let stop = Arc::new(AtomicBool::new(false));
+    let reader_path = path.clone();
+    let reader_barrier = barrier.clone();
+    let reader_stop = stop.clone();
+    let reader =
+        std::thread::spawn(move || read_generations(reader_path, reader_barrier, reader_stop));
+    barrier.wait();
+    let repository = SettingsRepository::new(path.clone());
+    let probe = LegacyPathProbe::new(directory.path().join("absent-legacy.sock"));
+    for revision in 1..=32 {
+        let mutation = validate_cli(
+            "audio_feedback",
+            if revision % 2 == 0 { "true" } else { "false" },
+            &ValidationContext {
+                prompt_ids: &[],
+                updates_allowed: true,
+            },
+        )?;
+        assert_eq!(
+            repository
+                .commit_with_probe(mutation, None, &probe, &())?
+                .snapshot
+                .revision
+                .0,
+            revision
+        );
+    }
+    stop.store(true, Ordering::Release);
+    assert!(
+        reader
+            .join()
+            .map_err(|_| "reader panic")?
+            .map_err(|error| format!("reader: {error}"))?
+            > 0
+    );
+    Ok(())
+}
+
+fn read_generations(
+    path: std::path::PathBuf,
+    barrier: std::sync::Arc<std::sync::Barrier>,
+    stop: std::sync::Arc<std::sync::atomic::AtomicBool>,
+) -> Result<usize, String> {
+    use std::sync::atomic::Ordering;
+    barrier.wait();
+    let deadline = Instant::now() + DEADLINE;
+    let mut count = 0;
+    loop {
+        let bytes = std::fs::read(&path).map_err(|_| "raw read")?;
+        let value: Value = serde_json::from_slice(&bytes).map_err(|_| "partial JSON")?;
+        let revision = value["settings_revision"].as_u64().ok_or("revision")?;
+        if value["settings"]["audio_feedback"] != json!(revision % 2 == 0) {
+            return Err("mixed generation".into());
+        }
+        count += 1;
+        if stop.load(Ordering::Acquire) {
+            return Ok(count);
+        }
+        if Instant::now() > deadline {
+            return Err("reader deadline".into());
+        }
+    }
+}
+
+#[test]
+fn forced_process_termination_before_and_after_replace_preserves_complete_generations_and_releases_locks(
+) -> TestResult<()> {
+    for mode in ["crash_before", "crash_after"] {
+        let directory = tempfile::tempdir()?;
+        let path = directory.path().join("settings_store.json");
+        let old = json!({"settings_revision":7,"settings":{"audio_feedback":true,"unknown":"CANARY_KEEP"}});
+        let old_bytes = serde_json::to_vec(&old)?;
+        std::fs::write(&path, &old_bytes)?;
+        let mut driver = Driver::start(&path, mode, "audio_feedback", "false")?;
+        driver.send("GO")?;
+        driver.wait_crash_barrier()?;
+        driver.kill_at_barrier()?;
+        let revision = assert_crash_generation(&path, mode, &old)?;
+        let probe = LegacyPathProbe::new(directory.path().join("absent-legacy.sock"));
+        let mutation = validate_cli(
+            "audio_feedback",
+            if mode == "crash_before" {
+                "false"
+            } else {
+                "true"
+            },
+            &ValidationContext {
+                prompt_ids: &[],
+                updates_allowed: true,
+            },
+        )?;
+        assert_eq!(
+            SettingsRepository::new(path)
+                .commit_with_probe(mutation, None, &probe, &())?
+                .snapshot
+                .revision
+                .0,
+            revision + 1
+        );
+    }
+    Ok(())
+}
+
+fn assert_crash_generation(path: &std::path::Path, mode: &str, old: &Value) -> TestResult<u64> {
+    use std::{
+        collections::hash_map::DefaultHasher,
+        hash::{Hash, Hasher},
+    };
+    let mut expected = old.clone();
+    let revision = if mode == "crash_before" {
+        7
+    } else {
+        expected["settings_revision"] = json!(8);
+        expected["settings"]["audio_feedback"] = json!(false);
+        8
+    };
+    let bytes = std::fs::read(path)?;
+    let disk: Value = serde_json::from_slice(&bytes)?;
+    assert_eq!(disk, expected);
+    assert_eq!(bytes, serde_json::to_vec(&expected)?);
+    let mut observed_hash = DefaultHasher::new();
+    bytes.hash(&mut observed_hash);
+    let mut expected_hash = DefaultHasher::new();
+    serde_json::to_vec(&expected)?.hash(&mut expected_hash);
+    assert_eq!(observed_hash.finish(), expected_hash.finish());
+    eprintln!(
+        "CRASH_GENERATION {mode} revision={revision} fingerprint={:016x}",
+        observed_hash.finish()
+    );
+    Ok(revision)
+}
diff --git a/src-tauri/tests/settings_transactions/reads.rs b/src-tauri/tests/settings_transactions/reads.rs
new file mode 100644
index 0000000..971e186
--- /dev/null
+++ b/src-tauri/tests/settings_transactions/reads.rs
@@ -0,0 +1,55 @@
+//! Non-creating reads and recovery preserve revision continuity and raw bytes.
+use handy_app_lib::settings_service::{protocol::Revision, store::SettingsRepository};
+use serde_json::json;
+
+#[test]
+fn missing_store_returns_defaults_without_creating_parent_or_store(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("absent").join("settings_store.json");
+    let read = SettingsRepository::new(path.clone()).read_snapshot()?;
+    assert_eq!(read.snapshot.revision, Revision(0));
+    assert!(!read.warning);
+    assert_eq!(
+        serde_json::to_value(read.snapshot.public_settings())?
+            .as_object()
+            .ok_or("object")?
+            .len(),
+        63
+    );
+    assert!(!path.parent().ok_or("parent")?.exists());
+    Ok(())
+}
+#[test]
+fn salvage_keeps_valid_revision_valid_fields_and_store_bytes(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let bytes = serde_json::to_vec(
+        &json!({"settings_revision":41,"unknown_top":"CANARY_TOP","settings":{"paste_method":"invalid_method","audio_feedback":false,"post_process_api_keys":{"custom":"CANARY_SECRET"},"unknown_payload":"CANARY_PAYLOAD"}}),
+    )?;
+    std::fs::write(&path, &bytes)?;
+    let read = SettingsRepository::new(path.clone()).read_snapshot()?;
+    assert_eq!(read.snapshot.revision, Revision(41));
+    assert!(read.warning);
+    let public = serde_json::to_value(read.snapshot.public_settings())?;
+    assert_eq!(public["audio_feedback"], false);
+    assert_eq!(
+        public["post_process_api_keys"]["custom"],
+        json!({"present":true})
+    );
+    assert_eq!(std::fs::read(path)?, bytes);
+    Ok(())
+}
+#[test]
+fn broken_json_read_recovers_defaults_without_overwriting() -> Result<(), Box<dyn std::error::Error>>
+{
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    std::fs::write(&path, b"CANARY_BROKEN_JSON")?;
+    let read = SettingsRepository::new(path.clone()).read_snapshot()?;
+    assert!(read.warning);
+    assert_eq!(read.snapshot.revision, Revision(0));
+    assert_eq!(std::fs::read(path)?, b"CANARY_BROKEN_JSON");
+    Ok(())
+}
diff --git a/src-tauri/tests/settings_transactions/transactions.rs b/src-tauri/tests/settings_transactions/transactions.rs
new file mode 100644
index 0000000..ad94349
--- /dev/null
+++ b/src-tauri/tests/settings_transactions/transactions.rs
@@ -0,0 +1,161 @@
+//! Durable revision/CAS/no-op/refusal contracts use real raw files.
+use handy_app_lib::settings_service::{
+    errors::SettingsErrorCode,
+    protocol::Revision,
+    store::SettingsRepository,
+    validation::{validate_cli, ValidationContext},
+};
+use serde_json::json;
+fn mutation(
+    key: &str,
+    value: &str,
+) -> Result<
+    handy_app_lib::settings_service::validation::SettingsMutation,
+    handy_app_lib::settings_service::errors::SettingsError,
+> {
+    validate_cli(
+        key,
+        value,
+        &ValidationContext {
+            prompt_ids: &[],
+            updates_allowed: true,
+        },
+    )
+}
+#[test]
+fn changed_patch_is_durable_increments_once_and_preserves_unknowns_and_secrets(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let original = json!({"settings_revision":7,"future":{"secret":"CANARY_TOP"},"settings":{"future":{"secret":"CANARY_NESTED"},"post_process_api_keys":{"custom":"CANARY_KEY"},"audio_feedback":true}});
+    std::fs::write(&path, serde_json::to_vec(&original)?)?;
+    let read = SettingsRepository::new(path.clone()).commit_with_probe(
+        mutation("audio_feedback", "false")?,
+        Some(Revision(7)),
+        &probe(&directory),
+        &(),
+    )?;
+    assert_eq!(read.snapshot.revision, Revision(8));
+    let disk: serde_json::Value = serde_json::from_slice(&std::fs::read(path)?)?;
+    assert_eq!(disk["settings_revision"], 8);
+    assert_eq!(disk["settings"]["audio_feedback"], false);
+    for key in ["future", "post_process_api_keys"] {
+        assert_eq!(disk["settings"][key], original["settings"][key]);
+    }
+    assert_eq!(disk["future"], original["future"]);
+    Ok(())
+}
+#[test]
+fn stale_compare_and_set_refuses_without_changing_bytes() -> Result<(), Box<dyn std::error::Error>>
+{
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let bytes =
+        serde_json::to_vec(&json!({"settings_revision":5,"settings":{"audio_feedback":true}}))?;
+    std::fs::write(&path, &bytes)?;
+    let error = SettingsRepository::new(path.clone())
+        .commit_with_probe(
+            mutation("audio_feedback", "false")?,
+            Some(Revision(4)),
+            &probe(&directory),
+            &(),
+        )
+        .err()
+        .ok_or("stale CAS accepted")?;
+    assert_eq!(error.code(), SettingsErrorCode::RevisionConflict);
+    assert_eq!(
+        serde_json::to_value(error)?["details"]["current_revision"],
+        5
+    );
+    assert_eq!(std::fs::read(path)?, bytes);
+    Ok(())
+}
+#[test]
+fn corrupt_or_overflow_revision_and_broken_json_refuse_write(
+) -> Result<(), Box<dyn std::error::Error>> {
+    for bytes in [
+        serde_json::to_vec(
+            &json!({"settings_revision":"CANARY_COUNTER","settings":{"audio_feedback":true}}),
+        )?,
+        serde_json::to_vec(
+            &json!({"settings_revision":u64::MAX,"settings":{"audio_feedback":true}}),
+        )?,
+        b"CANARY_BROKEN".to_vec(),
+    ] {
+        let directory = tempfile::tempdir()?;
+        let path = directory.path().join("settings_store.json");
+        std::fs::write(&path, &bytes)?;
+        let error = SettingsRepository::new(path.clone())
+            .commit_with_probe(
+                mutation("audio_feedback", "false")?,
+                None,
+                &probe(&directory),
+                &(),
+            )
+            .err()
+            .ok_or("unsafe continuity accepted")?;
+        assert_eq!(error.code(), SettingsErrorCode::PersistenceFailed);
+        assert!(!serde_json::to_string(&error)?.contains("CANARY"));
+        assert_eq!(std::fs::read(path)?, bytes);
+    }
+    Ok(())
+}
+#[test]
+fn semantic_noop_does_not_rewrite_or_increment_and_first_change_is_one(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let repository = SettingsRepository::new(path.clone());
+    let defaults = serde_json::to_value(repository.read_snapshot()?.snapshot.public_settings())?;
+    let raw = defaults["audio_feedback"].as_bool().ok_or("default bool")?;
+    let read = repository.commit_with_probe(
+        mutation("audio_feedback", if raw { "true" } else { "false" })?,
+        None,
+        &probe(&directory),
+        &(),
+    )?;
+    assert_eq!(read.snapshot.revision, Revision(0));
+    assert!(!path.exists());
+    let read = repository.commit_with_probe(
+        mutation("audio_feedback", if raw { "false" } else { "true" })?,
+        None,
+        &probe(&directory),
+        &(),
+    )?;
+    assert_eq!(read.snapshot.revision, Revision(1));
+    assert!(path.exists());
+    Ok(())
+}
+
+fn probe(
+    directory: &tempfile::TempDir,
+) -> handy_app_lib::settings_service::ownership::LegacyPathProbe {
+    handy_app_lib::settings_service::ownership::LegacyPathProbe::new(
+        directory.path().join("absent-legacy.sock"),
+    )
+}
+#[test]
+fn prompt_mutation_revalidates_membership_against_the_locked_fresh_snapshot(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("settings_store.json");
+    let bytes = serde_json::to_vec(
+        &json!({"settings_revision":4,"settings":{"post_process_prompts":[{"id":"current","name":"Current","prompt":"Fixture prompt"}]}}),
+    )?;
+    std::fs::write(&path, &bytes)?;
+    let stale = validate_cli(
+        "post_process_selected_prompt_id",
+        "removed",
+        &ValidationContext {
+            prompt_ids: &["removed"],
+            updates_allowed: true,
+        },
+    )?;
+    let error = SettingsRepository::new(path.clone())
+        .commit_with_probe(stale, None, &probe(&directory), &())
+        .err()
+        .ok_or("removed prompt committed")?;
+    assert_eq!(error.code(), SettingsErrorCode::ValidationFailed);
+    assert_eq!(std::fs::read(path)?, bytes);
+    Ok(())
+}
