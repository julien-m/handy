diff --git a/src-tauri/src/settings_service/atomic.rs b/src-tauri/src/settings_service/atomic.rs
new file mode 100644
index 0000000..d3a6564
--- /dev/null
+++ b/src-tauri/src/settings_service/atomic.rs
@@ -0,0 +1,202 @@
+//! Private same-directory generations are flushed before replace and directory sync.
+use super::{errors::SettingsError, store::persistence_failed};
+#[cfg(unix)]
+use std::fs::OpenOptions;
+use std::{
+    fs::File,
+    io::Write,
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicU64, Ordering},
+};
+static TEMP_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+/// Injection boundary corresponds to real durable-write stages, never a mock repository.
+#[derive(Clone, Copy, Eq, PartialEq)]
+pub enum PersistStage {
+    BeforeWrite,
+    AfterWrite,
+    AfterFileSync,
+    BeforeReplace,
+    AfterReplace,
+    AfterDirectorySync,
+}
+/// Filesystem fault port; normal production commits use the inert implementation.
+pub trait PersistObserver {
+    /// Observe/inject one real durable stage; returned failure is mapped according to commit certainty.
+    fn observe(&self, stage: PersistStage) -> std::io::Result<()>;
+}
+impl PersistObserver for () {
+    fn observe(&self, _: PersistStage) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+pub(super) fn persist(
+    path: &Path,
+    value: &serde_json::Value,
+    observer: &impl PersistObserver,
+    authorize_replace: impl FnOnce() -> Result<(), SettingsError>,
+) -> Result<(), SettingsError> {
+    let parent = path.parent().ok_or_else(persistence_failed)?;
+    #[cfg(unix)]
+    let directory = File::open(parent).map_err(|_| persistence_failed())?;
+    #[cfg(windows)]
+    let directory = super::windows_store::pin_parent(parent).map_err(|_| persistence_failed())?;
+    #[cfg(unix)]
+    let identity = directory.metadata().map_err(|_| persistence_failed())?;
+    let (temporary, mut file) = private_temp(parent)?;
+    write_generation(&mut file, value, observer)?;
+    observer
+        .observe(PersistStage::BeforeReplace)
+        .map_err(|_| persistence_failed())?;
+    #[cfg(unix)]
+    validate_directory(parent, &identity)?;
+    #[cfg(windows)]
+    directory.validate().map_err(|_| persistence_failed())?;
+    validate_temp(&temporary, &file)?;
+    authorize_replace()?;
+    // Only a complete synchronized generation reaches the durable pathname. Failed private temps are retained.
+    replace_generation(&temporary, path, &file, &directory)?;
+    observer
+        .observe(PersistStage::AfterReplace)
+        .map_err(|_| SettingsError::unknown_outcome())?;
+    #[cfg(unix)]
+    directory
+        .sync_all()
+        .map_err(|_| SettingsError::unknown_outcome())?;
+    observer
+        .observe(PersistStage::AfterDirectorySync)
+        .map_err(|_| SettingsError::unknown_outcome())?;
+    Ok(())
+}
+#[cfg(unix)]
+type NativeDirectory = File;
+#[cfg(windows)]
+type NativeDirectory = super::windows_store::PinnedDirectory;
+fn replace_generation(
+    temporary: &Path,
+    path: &Path,
+    file: &File,
+    directory: &NativeDirectory,
+) -> Result<(), SettingsError> {
+    #[cfg(unix)]
+    {
+        let _ = (file, directory);
+    }
+    #[cfg(unix)]
+    replace(temporary, path).map_err(|_| persistence_failed())?;
+    #[cfg(windows)]
+    super::windows_store::replace_owned(
+        file,
+        directory,
+        path.file_name().ok_or_else(persistence_failed)?,
+    )
+    // OS diagnostics remain private; the replacement phase determines the fixed public code.
+    .map_err(|error| match error {
+        super::windows_store::ReplaceError::Before(error) => {
+            let _ = error;
+            persistence_failed()
+        }
+        super::windows_store::ReplaceError::After(error) => {
+            let _ = error;
+            SettingsError::unknown_outcome()
+        }
+    })?;
+    #[cfg(windows)]
+    {
+        let _ = temporary;
+    }
+    Ok(())
+}
+fn write_generation(
+    file: &mut File,
+    value: &serde_json::Value,
+    observer: &impl PersistObserver,
+) -> Result<(), SettingsError> {
+    observer
+        .observe(PersistStage::BeforeWrite)
+        .map_err(|_| persistence_failed())?;
+    serde_json::to_writer(&mut *file, value).map_err(|_| persistence_failed())?;
+    file.flush().map_err(|_| persistence_failed())?;
+    observer
+        .observe(PersistStage::AfterWrite)
+        .map_err(|_| persistence_failed())?;
+    file.sync_all().map_err(|_| persistence_failed())?;
+    observer
+        .observe(PersistStage::AfterFileSync)
+        .map_err(|_| persistence_failed())?;
+    Ok(())
+}
+fn private_temp(parent: &Path) -> Result<(PathBuf, File), SettingsError> {
+    let sequence = TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+    let path = parent.join(format!(".settings-{}-{sequence}.tmp", std::process::id()));
+    #[cfg(unix)]
+    let file = {
+        use std::os::unix::fs::OpenOptionsExt;
+        OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(&path)
+            .map_err(|_| persistence_failed())?
+    };
+    #[cfg(windows)]
+    let file = super::windows_store::create_private(&path).map_err(|_| persistence_failed())?;
+    Ok((path, file))
+}
+fn validate_temp(path: &Path, held: &File) -> Result<(), SettingsError> {
+    let current = std::fs::symlink_metadata(path).map_err(|_| persistence_failed())?;
+    let identity = held.metadata().map_err(|_| persistence_failed())?;
+    super::locator::validate_owner(&current)?;
+    if !current.is_file() {
+        return Err(persistence_failed());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if (current.dev(), current.ino(), current.uid())
+            != (identity.dev(), identity.ino(), identity.uid())
+            || current.nlink() != 1
+            || current.mode() & 0o777 != 0o600
+        {
+            return Err(persistence_failed());
+        }
+    }
+    #[cfg(windows)]
+    {
+        let reopened = super::windows_store::open_checked(
+            path,
+            super::windows_store::ResourceKind::File,
+            false,
+        )
+        .map_err(|_| persistence_failed())?;
+        if super::windows_store::identity(&reopened).map_err(|_| persistence_failed())?
+            != super::windows_store::identity(held).map_err(|_| persistence_failed())?
+        {
+            return Err(persistence_failed());
+        }
+        let _ = identity;
+    }
+    Ok(())
+}
+#[cfg(unix)]
+fn validate_directory(path: &Path, held: &std::fs::Metadata) -> Result<(), SettingsError> {
+    let current = std::fs::symlink_metadata(path).map_err(|_| persistence_failed())?;
+    super::locator::validate_owner(&current)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if (current.dev(), current.ino()) != (held.dev(), held.ino()) {
+            return Err(persistence_failed());
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = held;
+    }
+    Ok(())
+}
+#[cfg(unix)]
+fn replace(source: &Path, target: &Path) -> std::io::Result<()> {
+    std::fs::rename(source, target)
+}
diff --git a/src-tauri/src/settings_service/instance_probe.rs b/src-tauri/src/settings_service/instance_probe.rs
index f844e91..f1ecacb 100644
--- a/src-tauri/src/settings_service/instance_probe.rs
+++ b/src-tauri/src/settings_service/instance_probe.rs
@@ -9,7 +9,7 @@ use std::path::Path;
 
 /// Conservative inspection result; neither absence nor this spike authorizes writes.
 #[derive(Clone, Copy, Debug, Eq, PartialEq)]
-pub(crate) enum LegacyState {
+pub enum LegacyState {
     Absent,
     Occupied,
     Uncertain,
@@ -68,3 +68,45 @@ pub(crate) fn classify_owner(owner: std::io::Result<bool>, scope: ProbeScope) ->
         Err(_) => LegacyState::Unavailable,
     }
 }
+
+/// Effective UID is obtained only at the native platform inspection boundary.
+#[cfg(unix)]
+pub(crate) fn current_uid() -> u32 {
+    // SAFETY: geteuid has no pointers and does not mutate Rust memory.
+    unsafe { libc::geteuid() }
+}
+/// Inspect the original plugin's local mutex/window without messaging or reserving it.
+#[cfg(windows)]
+pub(crate) fn inspect_legacy_windows() -> LegacyState {
+    use windows_sys::Win32::{
+        Foundation::{CloseHandle, GetLastError, ERROR_FILE_NOT_FOUND},
+        System::Threading::{OpenMutexW, SYNCHRONIZATION_SYNCHRONIZE},
+        UI::WindowsAndMessaging::FindWindowW,
+    };
+    // Original tauri-plugin-single-instance 2.4 resources; absence covers only the current session.
+    let wide = |text: &str| text.encode_utf16().chain(Some(0)).collect::<Vec<_>>();
+    let mutex = wide("com.pais.handy-sim");
+    let class = wide("com.pais.handy-sic");
+    let window = wide("com.pais.handy-siw");
+    // SAFETY: names are terminated, permissions only query existing ownership; no resource is created.
+    let handle = unsafe { OpenMutexW(SYNCHRONIZATION_SYNCHRONIZE, 0, mutex.as_ptr()) };
+    if !handle.is_null() {
+        // SAFETY: this owned successful OpenMutex handle is released exactly once.
+        unsafe { CloseHandle(handle) };
+        return LegacyState::Occupied;
+    }
+    // SAFETY: GetLastError snapshots the preceding failed call; FindWindow only observes existing identity.
+    let error = unsafe { GetLastError() };
+    let target = unsafe { FindWindowW(class.as_ptr(), window.as_ptr()) };
+    if !target.is_null() {
+        return LegacyState::Occupied;
+    }
+    classify_owner(
+        if error == ERROR_FILE_NOT_FOUND {
+            Ok(false)
+        } else {
+            Err(std::io::Error::from_raw_os_error(error as i32))
+        },
+        ProbeScope::CurrentSession,
+    )
+}
diff --git a/src-tauri/src/settings_service/locator.rs b/src-tauri/src/settings_service/locator.rs
new file mode 100644
index 0000000..750e0bb
--- /dev/null
+++ b/src-tauri/src/settings_service/locator.rs
@@ -0,0 +1,90 @@
+//! Non-creating portable/installed identities use the same OS directory provider as Tauri.
+use super::{
+    errors::{SettingsError, SettingsErrorCode},
+    store::persistence_failed,
+};
+use std::path::{Component, Path, PathBuf};
+const APP_IDENTIFIER: &str = "com.pais.handy";
+const STORE_FILENAME: &str = "settings_store.json";
+
+/// Side-effect-free installed/portable store resolver; no marker upgrade or Data creation.
+pub struct StoreLocator;
+impl StoreLocator {
+    /// Resolve current executable and OS user data without starting Tauri or changing the environment.
+    // @spec FR-002: Pure store identity resolution — .specs/features/008-settings-cli/spec.md#fr-002
+    pub fn current() -> Result<PathBuf, SettingsError> {
+        let executable = std::env::current_exe().map_err(|_| persistence_failed())?;
+        let installed = dirs::data_dir()
+            .ok_or_else(persistence_failed)?
+            .join(APP_IDENTIFIER);
+        Self::resolve(&executable, &installed)
+    }
+    /// Explicit path inputs support installed/portable parity tests without modifying global configuration.
+    pub fn resolve(executable: &Path, installed_data: &Path) -> Result<PathBuf, SettingsError> {
+        let directory = executable.parent().ok_or_else(persistence_failed)?;
+        let data = directory.join("Data");
+        let marker = directory.join("portable");
+        let portable = crate::portable::resolve_data_dir(&marker, &data)?;
+        canonical_path(
+            &portable
+                .unwrap_or_else(|| installed_data.to_path_buf())
+                .join(STORE_FILENAME),
+        )
+    }
+}
+/// Canonicalize the closest existing ancestor and append only normal missing components.
+pub(super) fn canonical_path(path: &Path) -> Result<PathBuf, SettingsError> {
+    if !path.is_absolute()
+        || path
+            .components()
+            .any(|part| matches!(part, Component::ParentDir))
+    {
+        return Err(persistence_failed());
+    }
+    let mut ancestor = path.to_path_buf();
+    let mut missing = Vec::new();
+    while !ancestor.exists() {
+        missing.push(
+            ancestor
+                .file_name()
+                .ok_or_else(persistence_failed)?
+                .to_owned(),
+        );
+        ancestor = ancestor
+            .parent()
+            .ok_or_else(persistence_failed)?
+            .to_path_buf();
+    }
+    let canonical = ancestor.canonicalize().map_err(|_| persistence_failed())?;
+    validate_owner(&std::fs::metadata(&canonical).map_err(|_| persistence_failed())?)?;
+    #[cfg(windows)]
+    {
+        let metadata = std::fs::metadata(&canonical).map_err(|_| persistence_failed())?;
+        let kind = if metadata.is_dir() {
+            super::windows_store::ResourceKind::Directory
+        } else {
+            super::windows_store::ResourceKind::File
+        };
+        super::windows_store::open_checked(&canonical, kind, false)
+            .map_err(|_| persistence_failed())?;
+    }
+    let mut result = canonical;
+    for component in missing.into_iter().rev() {
+        result.push(component);
+    }
+    Ok(result)
+}
+/// Refuse foreign owner/type aliases; Windows native ACL implementation remains platform-specific.
+pub(super) fn validate_owner(metadata: &std::fs::Metadata) -> Result<(), SettingsError> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != super::ownership::current_uid() {
+            return Err(SettingsError::new(SettingsErrorCode::Unavailable));
+        }
+    }
+    if metadata.file_type().is_symlink() {
+        return Err(SettingsError::new(SettingsErrorCode::Unavailable));
+    }
+    Ok(())
+}
