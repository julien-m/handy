/progress.md:L84-L87\",\n    \".specs/features/008-settings-cli/progress.md:L88-L107\",\n    \".specs/features/008-settings-cli/progress.md:L108-L113\",\n    \".specs/features/008-settings-cli/progress.md:L114-L134\",\n    \".specs/features/008-settings-cli/progress.md:L135-L151\",\n    \".specs/features/008-settings-cli/progress.md:L152-L168\",\n    \".specs/features/008-settings-cli/spec.md:L1-L9\",\n    \".specs/features/008-settings-cli/spec.md:L10-L11\",\n    \".specs/features/008-settings-cli/spec.md:L12-L20\",\n    \".specs/features/008-settings-cli/spec.md:L21-L22\",\n    \".specs/features/008-settings-cli/spec.md:L23-L58\",\n    \".specs/features/008-settings-cli/spec.md:L59-L93\",\n    \".specs/features/008-settings-cli/spec.md:L94-L129\",\n    \".specs/features/008-settings-cli/spec.md:L130-L170\",\n    \".specs/features/008-settings-cli/spec.md:L171-L203\",\n    \".specs/features/008-settings-cli/spec.md:L204-L205\",\n    \".specs/features/008-settings-cli/spec.md:L206-L210\",\n    \".specs/features/008-settings-cli/spec.md:L211-L215\",\n    \".specs/features/008-settings-cli/spec.md:L216-L220\",\n    \".specs/features/008-settings-cli/spec.md:L221-L225\",\n    \".specs/features/008-settings-cli/spec.md:L226-L230\",\n    \".specs/features/008-settings-cli/spec.md:L231-L235\",\n    \".specs/features/008-settings-cli/spec.md:L236-L240\",\n    \".specs/features/008-settings-cli/spec.md:L241-L245\",\n    \".specs/features/008-settings-cli/spec.md:L246-L247\",\n    \".specs/features/008-settings-cli/spec.md:L248-L252\",\n    \".specs/features/008-settings-cli/spec.md:L253-L257\",\n    \".specs/features/008-settings-cli/spec.md:L258-L262\",\n    \".specs/features/008-settings-cli/spec.md:L263-L267\",\n    \".specs/features/008-settings-cli/spec.md:L268-L272\",\n    \".specs/features/008-settings-cli/spec.md:L273-L277\",\n    \".specs/features/008-settings-cli/spec.md:L278-L286\",\n    \".specs/features/008-settings-cli/spec.md:L287-L297\",\n    \".specs/features/008-settings-cli/spec.md:L298-L307\",\n    \".specs/features/008-settings-cli/spec.md:L308-L315\",\n    \".specs/features/008-settings-cli/spec.md:L316-L317\",\n    \".specs/features/008-settings-cli/spec.md:L318-L321\",\n    \".specs/features/008-settings-cli/spec.md:L322-L325\",\n    \".specs/features/008-settings-cli/spec.md:L326-L328\",\n    \".specs/testing/strategy.md:L1-L2\",\n    \".specs/testing/strategy.md:L3-L6\",\n    \".specs/testing/strategy.md:L7-L12\",\n    \".specs/testing/strategy.md:L13-L16\",\n    \".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L1-L9\",\n    \".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L10-L15\",\n    \".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L16-L21\",\n    \".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L22-L26\",\n    \".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L27-L30\",\n    \".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L31-L33\",\n    \".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L1-L9\",\n    \".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L10-L15\",\n    \".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L16-L21\",\n    \".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L22-L26\",\n    \".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L27-L30\",\n    \".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L31-L33\",\n    \".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L1-L9\",\n    \".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L10-L15\",\n    \".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L16-L21\",\n    \".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L22-L25\",\n    \".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L26-L37\",\n    \".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L38-L44\",\n    \".specs/features/008-settings-cli/plan.md:L1-L9\",\n    \".specs/features/008-settings-cli/plan.md:L10-L11\",\n    \".specs/features/008-settings-cli/plan.md:L12-L17\",\n    \".specs/features/008-settings-cli/plan.md:L18-L35\",\n    \".specs/features/008-settings-cli/plan.md:L36-L47\",\n    \".specs/features/008-settings-cli/plan.md:L48-L60\",\n    \".specs/features/008-settings-cli/plan.md:L61-L62\",\n    \".specs/features/008-settings-cli/plan.md:L63-L68\",\n    \".specs/features/008-settings-cli/plan.md:L69-L76\",\n    \".specs/features/008-settings-cli/plan.md:L77-L82\",\n    \".specs/features/008-settings-cli/plan.md:L83-L102\",\n    \".specs/features/008-settings-cli/plan.md:L103-L123\",\n    \".specs/features/008-settings-cli/plan.md:L124-L211\",\n    \".specs/features/008-settings-cli/plan.md:L212-L249\",\n    \".specs/features/008-settings-cli/plan.md:L250-L289\",\n    \".specs/features/008-settings-cli/plan.md:L290-L291\",\n    \".specs/features/008-settings-cli/plan.md:L292-L301\",\n    \".specs/features/008-settings-cli/plan.md:L302-L311\",\n    \".specs/features/008-settings-cli/plan.md:L312-L321\",\n    \".specs/features/008-settings-cli/plan.md:L322-L331\",\n    \".specs/features/008-settings-cli/plan.md:L332-L341\",\n    \".specs/features/008-settings-cli/plan.md:L342-L351\",\n    \".specs/features/008-settings-cli/plan.md:L352-L361\"\n  ],\n  \"conclusions\": [\n    {\n      \"requirement_id\": \"008-settings-cli:AC-001\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The submitted architecture adds the group to the existing executable and parses/returns before Tauri, model/audio, portable mutation and single-instance activation. Both JSON placements and historical invocation preservation are explicit; Windows keeps one console-subsystem executable and inherited settings/headless handles. Step 5 wires real parser/IPC branches with binary old-flag tests, and Step 7 captures M1/no-window/tray/model proof. The 2-second successful-read requirement is retained. Foreign native observations remain pending and primitive histories are not full acceptance.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L206-L210\",\n          \"excerpt\": \"### AC-001\\n\\n**Criterion:** `handy settings` is a subcommand group of the existing `handy` executable. Existing flags (`--toggle-transcription`, `--toggle-post-process`, `--cancel`, `--start-hidden`, `--no-tray`, `--debug`, `--transcribe-file`, `--model`, `--device-index`, `--list-devices`, `--list-models`, `--repeat`, `--json`) keep their behavior; `--json` after `settings` belongs to the subcommand. It works on macOS, Windows and Linux; on Windows, output appears in the console the command was started from. A `handy settings` invocation never shows a window, a tray icon or loads a model, never triggers the single-instance \\\"show window\\\" behavior, and completes reads within 2 seconds on an Apple M1 Mac in a release build.\\n**Priority:** P1 | **Story:** Stories 1 and 5\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L63-L68\",\n          \"excerpt\": \"### Entry point and Windows console\\n\\nUse `CliArgs::try_parse_from` before any Tauri builder, specta export, model/audio manager, portable mutating initialization or single-instance callback. `settings` runs and exits here; all old invocations retain their existing run branch. Accept both JSON placements and deduplicate them. Mixed settings with recording, startup, transcription/model/device/list/repeat flags is usage_error (2); `--debug` and `--json` remain compatible. Parser failures with JSON requested use the same envelope renderer without echoing raw values. JSON help is `{ok:true,revision:N,data:{help:...}}`, human help remains readable; obtain revision using the same non-mutating read path.\\n\\nWindows decision: retain one `handy.exe` with the **console PE subsystem** in debug and release. During implementation replace the current release-only `windows_subsystem=\\\"windows\\\"` attribute with the console selection; retain inherited stdout/stderr handles throughout the `settings` branch. The existing GUI branch calls `FreeConsole` before Tauri; never hide or close the parent's console, allocate another console or introduce a launcher/manifest policy. Existing headless transcription/list operations keep their console handles. Pure dispatch tests distinguish settings, existing headless, GUI and transcription-engine worker branches. Compile the Windows target in its supported native build environment and inspect PE OptionalHeader.Subsystem=3; compilation/header inspection tests this choice without claiming shell/UI runtime evidence. Inspect [Microsoft console creation](https://learn.microsoft.com/en-us/windows/console/creation-of-a-console) and [FreeConsole](https://learn.microsoft.com/en-us/windows/console/freeconsole) as technical context. Native cmd/PowerShell output, waits/exits, redirection and GUI launch/console-flash checks on the oldest supported Windows and 24H2 are **pending release evidence**; they never block Steps 1–7, feature completion on the integration branch or merge into `dev`. A compile failure remains a code defect to fix; missing Windows native observation does not become a step gate. No platform-native success is inferred from compilation.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L83-L102\",\n          \"excerpt\": \"### Routing, startup fence and legacy compatibility\\n\\nNew app acquires a per-user/store instance lease before loading settings, under settings.lock, publishes its private endpoint before releasing startup ownership, and keeps the lease until shutdown. A headless writer acquires settings.lock, then checks the new lease/endpoint and passive legacy state again immediately before commit. GUI startup for the new version uses that same lock; it reads a complete commit or establishes ownership before the CLI can mutate. The lease is separate from the transaction lock; a busy or starting owner never means offline permission. A stale new-version endpoint is reclaimable only after OS liveness/ownership proof and protected removal; ambiguous access returns unavailable with no write.\\n\\n| OS | Private request channel / peer verification | Passive older-instance detection |\\n|---|---|---|\\n| macOS | Short AF_UNIX SOCK_STREAM path in a canonical current-UID-owned directory (0700), with owner/type/device/inode guards; both endpoints enforce kernel peer UID via getpeereid before any application bytes | Inspect `/tmp/com_pais_handy_si.sock` type/owner without connecting, reading a legacy frame, invoking callback or removing it. Reuse inspect_legacy_path and its Absent/Occupied/Unavailable results. Stale/uncertain legacy resources refuse mutation rather than authorize deletion |\\n| Linux | AF_UNIX SOCK_STREAM under validated current-UID-owned directory (0700), XDG_RUNTIME_DIR or short private fallback, with owner/type/device/inode guards; both endpoints enforce checked SO_PEERCRED UID before any application bytes | Query session DBus `com.pais.handy.SingleInstance` through NameHasOwner/GetNameOwner only; never own that name, serve ExecuteCallback or call it. Errors/unknown scope refuse mutation |\\n| Windows | Named pipe keyed by SID+store hash, protected current-logon-SID DACL, reject remote clients and verify client token | Query legacy `com.pais.handy-sim` mutex and `com.pais.handy-sic`/`com.pais.handy-siw` target without WM_COPYDATA. Never reserve the mutex or create a compatibility window/message loop. Missing/ambiguous ownership evidence refuses mutation |\\n\\nUnix channel authorization uses the validated canonical current-UID directory with mode 0700 plus retained directory/socket owner, type, device/inode and single-link checks. Revalidate directory identity before/after bind and before accept/connect; refuse hostile aliases/replacements without touching substitutes. Bind without changing process-global umask, pathname chmod or a bootstrap-permission framework. Socket mode is diagnostic, not a portable security boundary. On macOS, ACLs can grant traversal/connection beyond ordinary mode bits, so mode 0700 alone is not exhaustive access proof: accepted clients and connected servers must each pass kernel-derived expected UID authentication before request parsing, response rendering or any application read/write. Failure closes/refuses the connection with no application bytes or store mutation; protocol UID/PID fields are never authorization evidence. Same-UID identity changes fail closed; no atomic pathname-race guarantee is claimed. Failed/closed socket names are retained rather than removed through a racy stat/check-then-unlink; Step 5 implements reviewed lease-proven reclamation so normal restart remains possible. Never delete the legacy singleton path.\\n\\n**Informative:** Inspect [Linux unix(7)](https://man7.org/linux/man-pages/man7/unix.7.html) for pathname/socket permission portability and kernel SO_PEERCRED context; inspect [Apple getpeereid(3)](https://developer.apple.com/library/archive/documentation/System/Conceptual/ManPages_iPhoneOS/man3/getpeereid.3.html) for both-side peer effective UID authentication. These references explain the mechanism; they add no external normative requirement or acceptance graph.\\n\\nInspect the locked [macOS plugin source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/macos.rs), [Windows source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/windows.rs) and [Linux source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/linux.rs). Cargo.lock resolves 2.4.0; recalculate identities if that dependency changes. Legacy identities do not prove store identity, so refuse conservatively for a same-user legacy owner even with an apparently different store. Do not connect/send an empty command: macOS empty streams can invoke show-window. Detected old instance means unavailable/5 and byte-identical store/revision, for reads or writes that would otherwise go to it.\\n\\nMinimal AC-005 scope: passive detection and refusal only. **No legacy invocation handoff, worker, spool, capture, acknowledgement, replay or recovery daemon is planned.** Offline CLI and new startup never impersonate an old singleton. Existing historical flags still use their current single-instance flow outside `settings`. Remove obsolete spike decoder/spool/reservation code and handoff tests during implementation, preserving the passive probe and reusable private-resource/peer-UID helpers. No code is removed by this planning command. Older versions do not participate in the new lock: a launch after the final passive probe is not claimed to be atomically fenced or delivered/replayed. This unsupported old-version race is documented; deterministic probes refuse an owner that appears before commit. Real older-binary race observations are pending release evidence, never a demand to recreate replay.\\n\\nRequests to a running new app carry protocol version, user/store identity, opaque request ID, typed operation, expected revision and dry_run. Bound UTF-8 frames to 1 MiB, reject malformed/oversized input without raw dumps. Domain imports share this technical limit until their owner defines another. Requests contain no raw argv. Use a monotonic 5 s end-to-end response deadline, including lock/persistence/transport wait. Successful M1 reads finish within 2 s; timeout failures are measured separately. No offline fallback write or blind retry after submission/timeout; reread revision/value first. Late replies cannot resurrect an expired request.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L352-L361\",\n          \"excerpt\": \"### Step 7 — Prove macOS acceptance and track release evidence\\n\\n**Prerequisite:** Steps 1–6 complete; automated platform builds/tests run in supported environments; macOS release binary available. Native Windows/Linux, older-binary and second-account artifacts are not entry gates.\\n**Required inputs:** Independent AC/FR inventory, actual macOS binary, native harness/schema, isolated installed/portable stores and release-evidence check matrix.\\n**Action:** Add `src-tauri/tests/{settings_cli.rs,settings_routing.rs}` and `scripts/settings-native-proof.ts`; add `tests/settings-events.spec.ts` for existing frontend behavior. Run the automated commands below and mandatory macOS native checks, capture M1 read latency, no window/tray/model, real new-app IPC, live settings refresh and shortcut registration. The Bun child-process harness uses real binaries/private stores, not browser-only Tauri mocks. Exercise older-owner/foreign-peer branches with injected resources deterministically, then list the exact real Windows/Linux/older-binary/second-account checks as pending release evidence below.\\n**FR covered:** FR-001.3: Native flag and latency evidence, FR-002.4: Discovery and secret tests, FR-003.4: Parity and concurrency proof, FR-004.4: Real platform routing proof, FR-005.3: Domain acceptance proof, FR-006.5: Every owned code and exit proof\\n**Execution evidence:** macOS binary hash/OS/tool versions, stdout/stderr/exits, raw store generations, AC/FR/SC assertion matrix, native observations and every latency sample; build/test transcripts for supported code plus explicit pending release evidence rows with exact checks and no PASS.\\n**Success criteria:** Required automated P0/P1 checks have zero unexplained failures; macOS native proof is complete before Implemented; every AC/SC has a truthful coverage row distinguishing proved assertions from the pending platform/old-binary/second-user subsets. Those pending observations never block implementation steps, feature completion on the integration branch or merge into dev, and are never declared passed.\\n**Failure handling:** Missing macOS native acceptance blocks Implemented; automated failure/data/secret defects require repair. Missing Windows/Linux/old-binary/second-account native observations stay pending release evidence, with exact check and owner, rather than BLOCKED for this feature or dev merge.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:AC-002\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The descriptor model enumerates all fields with type/range/enum/read-only/secret/domain information and explicit presence-only projection. Scalar parsing and list-owner guidance are specified; generic operations and their exact source response/unknown-key/UI-guidance contract are assigned in Step 5, with deterministic boundary/error tests in Step 2. Missing-store/default/salvage reads normalize only in memory and never create the store; both JSON placements share the early parser. This covers the composite design without treating already-built foundation ports as executable CLI success.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L211-L215\",\n          \"excerpt\": \"### AC-002\\n\\n**Criterion:** `handy settings get [KEY]` returns all non-secret settings or one key; `handy settings keys` lists settable keys with type, allowed values or range and read-only flag; `handy settings set KEY VALUE` changes one scalar setting. Secret values (API keys) are never printed; reads report only their presence. Unknown keys return `not_found`. `set` parses VALUE with the key's descriptor type (boolean `true`/`false`, integer, enumeration value, string). Generic `set` on a list key returns `validation_failed` naming the domain command to use; on a secret or read-only key it returns `validation_failed` stating that the key is changed in the settings UI. A top-level `--json` before `settings` is accepted as equivalent to `--json` after it. A headless read never creates the settings store.\\n**Priority:** P1 | **Story:** Stories 1 and 2\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L69-L76\",\n          \"excerpt\": \"### Paths, storage and revision\\n\\nExtract side-effect-free StoreLocator from portable initialization. Read the portable marker without upgrading it or creating Data; resolve installed user app-data using the configured identifier com.pais.handy and OS APIs, not guessed HOME strings. For nonexistent paths, canonicalize the nearest existing ancestor, append validated components and reject symlink/reparse aliases that cross user boundaries. Lock identity survives atomic store replacement: lock the stable sibling lock file, never the replaced JSON inode.\\n\\nSettingsRepository reads fresh disk bytes under settings.lock; missing store gives defaults/revision 0. Read only salvage/migrate/merge defaults in memory, never save, create settings_store.json, upgrade portable marker or increment revision. Startup takes the same lock and explicitly commits any initialization/migration change once. Older stores with no revision start at 0; first changed commit is 1. Preserve a valid top-level revision through payload salvage; malformed existing revision or unrecoverable revision continuity refuses writes with persistence_failed rather than reset-and-CAS. Entire unreadable JSON reports defaults with warning for read recovery, but cannot be overwritten automatically; explicit supported recovery is outside this feature. Semantic no-op after normalization does not write or increment; migrations persisted by startup are real writes. Reject revision overflow before native effects. Never silently reset the counter.\\n\\nCommit a typed mutation/patch against the newly loaded settings, not the caller's stale AppSettings snapshot. Validate the whole candidate and dependencies, compare normalized persisted values (including secret changes, excluding runtime overrides), increment once, serialize the entire preserved store object to a private same-directory temporary file, flush/sync, atomically replace and sync the parent directory on Unix (Windows replacement APIs and durable flush). Crash injection must observe old or new complete generation, never partial JSON. Disable plugin-store ownership/autosave/exit-save for this particular settings file; a reload alone cannot prevent a delayed old cache write. Other plugin stores remain unchanged. A compatibility AppHandle adapter reads the service snapshot; it cannot write the settings file independently. Activate app/startup adapters and transfer exclusive settings-file ownership only in Step4, atomically with all-writer migration; Step3 builds isolated repository/locator/normalization primitives while the existing app path and disabled settings CLI remain unchanged.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L63-L68\",\n          \"excerpt\": \"### Entry point and Windows console\\n\\nUse `CliArgs::try_parse_from` before any Tauri builder, specta export, model/audio manager, portable mutating initialization or single-instance callback. `settings` runs and exits here; all old invocations retain their existing run branch. Accept both JSON placements and deduplicate them. Mixed settings with recording, startup, transcription/model/device/list/repeat flags is usage_error (2); `--debug` and `--json` remain compatible. Parser failures with JSON requested use the same envelope renderer without echoing raw values. JSON help is `{ok:true,revision:N,data:{help:...}}`, human help remains readable; obtain revision using the same non-mutating read path.\\n\\nWindows decision: retain one `handy.exe` with the **console PE subsystem** in debug and release. During implementation replace the current release-only `windows_subsystem=\\\"windows\\\"` attribute with the console selection; retain inherited stdout/stderr handles throughout the `settings` branch. The existing GUI branch calls `FreeConsole` before Tauri; never hide or close the parent's console, allocate another console or introduce a launcher/manifest policy. Existing headless transcription/list operations keep their console handles. Pure dispatch tests distinguish settings, existing headless, GUI and transcription-engine worker branches. Compile the Windows target in its supported native build environment and inspect PE OptionalHeader.Subsystem=3; compilation/header inspection tests this choice without claiming shell/UI runtime evidence. Inspect [Microsoft console creation](https://learn.microsoft.com/en-us/windows/console/creation-of-a-console) and [FreeConsole](https://learn.microsoft.com/en-us/windows/console/freeconsole) as technical context. Native cmd/PowerShell output, waits/exits, redirection and GUI launch/console-flash checks on the oldest supported Windows and 24H2 are **pending release evidence**; they never block Steps 1–7, feature completion on the integration branch or merge into `dev`. A compile failure remains a code defect to fix; missing Windows native observation does not become a step gate. No platform-native success is inferred from compilation.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L302-L311\",\n          \"excerpt\": \"### Step 2 — Define descriptors, validators and DTO contracts\\n\\n**Prerequisite:** Step 1 retained primitives and automated checks pass; current UI/writer inventory captured. Pending release evidence does not block this step.\\n**Required inputs:** All AppSettings fields, UI command validators and current output enums, spec error table.\\n**Action:** Add the missing `settings_service/{mod.rs,descriptor.rs,validation.rs,protocol.rs,errors.rs}` around the retained Step 1 modules define SettingDescriptor, SettingsMutation, SettingsSnapshot, Revision, PublicSettings, OperationRequest and SettingsError. Build shared validators for every corresponding UI setting and existing domain operation; migrate invalid-to-default behavior to errors. New inline unit tests and `src-tauri/tests/settings_validation.rs` exercise real adapters against an independently maintained cases inventory. Generate `contracts/settings-cli.schema.json` from DTOs during implementation, plus `contracts/settings-cli.md` command matrix; schemas are not OpenAPI. Modify Cargo.toml for reviewed fs2, OS APIs and required Tokio features, not new model dependencies.\\n**FR covered:** FR-002.1: Complete descriptor and redaction model, FR-003.1: Shared typed validation, FR-005.1: Domain extension interface, FR-006.1: Typed errors and envelope contract\\n**Execution evidence:** Inventory diff, schema contract tests, valid/invalid/boundary cases including booleans, integers, enums, optional strings, read-only/secret/list keys.\\n**Success criteria:** Every persisted key classified; 100% settable-key UI/CLI parity including English reasons; unknown and unregistered-domain guidance deterministic; no secret serialization path.\\n**Failure handling:** Missing descriptor, divergent validation or leaked value is P0; repair before transaction integration.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:AC-003\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The plan uses common validators and stable English errors with translated UI code/field mapping, and explicitly rejects formerly coerced invalid paste values. Step 4 migrates real UI/internal writers to latest-state minimal mutations and tests genuine adapter parity/rejection. That same cutover activates app reads/writes and exclusive plugin ownership, avoiding a premature snapshot adapter. Refused values/preparation failures preserve bytes/revision; post-commit effect failures remain committed errors. Current pure-port parity stays partial until actual adapters exist.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L216-L220\",\n          \"excerpt\": \"### AC-003\\n\\n**Criterion:** Every write goes through the same backend validation functions as the corresponding UI command, so a value the UI rejects is rejected by the CLI with the same error code and English message, and vice versa; the UI may show that message translated. UI commands that today replace an invalid value by a default (for example an unknown paste method) reject it instead. A rejected write changes nothing.\\n**Priority:** P1 | **Story:** Story 2\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L77-L82\",\n          \"excerpt\": \"### All surfaces and live effects\\n\\nMigrate every writer before CLI set becomes reachable, including get_settings migration/default stores, shortcut fallback/reset commands, UI setters, audio/model selection repairs, model switches and history retention. The inventory is the actual call-site scan, not a hand-selected subset. Replace write_settings(AppSettings) with `commit_mutation` closures/typed patches and propagate Result. Preexisting runtime-only flags and forced-disable-updater remain overrides, never persisted writes.\\n\\nInject LiveSettingsEffects for native validation/preparation, shortcut registration, audio/model reconfiguration, autostart, theme/log settings and settings-changed. Worker transaction serializes prepare/validate → durable persist → publish snapshot → apply live effects → notify. Prepare any fallible reversible native change before commit; compensate it on persistence failure. For effects that can fail after durable commit, do not falsely return validation_failed: return internal_error with details `{outcome:\\\"committed\\\", current_revision:N, field:...}`, keep committed data authoritative and reconcile live state before accepting another affected mutation. Timeout still reports outcome unknown to the caller. P0 tests require invalid/refused values and failed preparation leave both disk and revision unchanged, and injected effect failure never yields a success with stale shortcuts. UI native command adapters become async workers where needed; never wait for a worker holding the transaction lock from the main thread. Event contains revision and changed key names only, no secret values; the existing listener refreshes and discards older refresh responses by revision.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L302-L311\",\n          \"excerpt\": \"### Step 2 — Define descriptors, validators and DTO contracts\\n\\n**Prerequisite:** Step 1 retained primitives and automated checks pass; current UI/writer inventory captured. Pending release evidence does not block this step.\\n**Required inputs:** All AppSettings fields, UI command validators and current output enums, spec error table.\\n**Action:** Add the missing `settings_service/{mod.rs,descriptor.rs,validation.rs,protocol.rs,errors.rs}` around the retained Step 1 modules define SettingDescriptor, SettingsMutation, SettingsSnapshot, Revision, PublicSettings, OperationRequest and SettingsError. Build shared validators for every corresponding UI setting and existing domain operation; migrate invalid-to-default behavior to errors. New inline unit tests and `src-tauri/tests/settings_validation.rs` exercise real adapters against an independently maintained cases inventory. Generate `contracts/settings-cli.schema.json` from DTOs during implementation, plus `contracts/settings-cli.md` command matrix; schemas are not OpenAPI. Modify Cargo.toml for reviewed fs2, OS APIs and required Tokio features, not new model dependencies.\\n**FR covered:** FR-002.1: Complete descriptor and redaction model, FR-003.1: Shared typed validation, FR-005.1: Domain extension interface, FR-006.1: Typed errors and envelope contract\\n**Execution evidence:** Inventory diff, schema contract tests, valid/invalid/boundary cases including booleans, integers, enums, optional strings, read-only/secret/list keys.\\n**Success criteria:** Every persisted key classified; 100% settable-key UI/CLI parity including English reasons; unknown and unregistered-domain guidance deterministic; no secret serialization path.\\n**Failure handling:** Missing descriptor, divergent validation or leaked value is P0; repair before transaction integration.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L322-L331\",\n          \"excerpt\": \"### Step 4 — Migrate every app writer and live side effect\\n\\n**Prerequisite:** Isolated Step3 repository tests PASS; no running-app repository adoption or CLI mutation entry point enabled. Prepare one coordinated cutover covering every existing writer and settings-specific plugin ownership.\\n**Required inputs:** Full write_settings and store.set inventory, manager repairs, startup migrations, typed native ports.\\n**Action:** Modify settings.rs, shortcut/mod.rs, commands/{mod.rs,audio.rs,models.rs,history.rs,transcription.rs}, managers/{audio.rs,model.rs} and lib.rs. Replace every snapshot rewrite with a minimal mutation applied to latest state; adapt fallback repairs and secret UI writes. In the same coordinated all-writer cutover, activate AppHandle/service reads, writes and app startup normalization, transfer exclusive settings_store.json ownership and disable that file's plugin autosave/exit-save participation; retain other plugin stores. Never expose repository adoption alongside stale full-snapshot writers. New `settings_service/live.rs` owns ordered effects and reconciliation. Modify settingsStore.ts to consume revisions/typed errors, regenerate bindings.ts via supported specta export and add en/fr i18n keys using existing translation checks. No new screens/layout. New tests verify writer inventory closure and genuine UI adapters, compensation and post-commit failure behavior.\\n**FR covered:** FR-003.3: All writers and live adapters, FR-006.2: Stable UI errors and translations\\n**Execution evidence:** Exhaustive writer scan with no direct settings-file writer remaining, settings-specific plugin ownership/autosave/exit-save closure, actual app startup/write race and no-stale-cache-flush proof, parity report, manager mutation race tests, UI event/read ordering tests and native shortcut re-registration evidence.\\n**Success criteria:** App adopts the repository only with complete all-writer/settings-file ownership closure; startup sees complete commits with no independent stale-cache flush. Every committed app write increments once; rejected values change nothing; native updates/UI refresh complete before success; runtime-only settings stay runtime-only.\\n**Failure handling:** Any direct writer/cache autosave remaining blocks CLI enablement; main-thread waits, rollback failure or stale effect is P0.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L212-L249\",\n          \"excerpt\": \"## State Model\\n\\n```gherkin\\nFeature: Mutation outcome\\n  Scenario: Refusal or no-op\\n    Given a current durable revision\\n    When validation fails or expected revision is stale\\n    Then the durable state and revision remain unchanged\\n    When a valid patch changes nothing\\n    Then success carries the unchanged revision\\n  Scenario: Failure after durable commit\\n    When persistence commits but a live effect fails\\n    Then the revision remains committed and error details state outcome committed\\n    And the affected runtime state is reconciled before another affected mutation\\n  Scenario: Timeout at the caller\\n    When the deadline expires after submission\\n    Then the caller reports outcome unknown until a fresh read resolves it\\n```\\n\\n```mermaid\\nstateDiagram-v2\\n  [*] --> Parsed\\n  Parsed --> Refused: invalid usage or unavailable owner\\n  Parsed --> Locked: owner established\\n  Locked --> Refused: validation or revision conflict\\n  Locked --> NoOp: same normalized value or dry-run\\n  Locked --> Prepared: valid changed patch\\n  Prepared --> Refused: prepare or persistence fails, compensate\\n  Prepared --> Durable: atomic replace succeeded\\n  Durable --> Applied: native effects and event complete\\n  Durable --> Reconcile: effect failure, outcome committed\\n  Applied --> [*]: success\\n  Reconcile --> Applied: repair live state\\n  Refused --> [*]: error, disk unchanged\\n  NoOp --> [*]: success, revision unchanged\\n  note right of Durable: Client timeout is an unknown observation, not rollback\\n```\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:AC-004\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The final architecture has one persistent cross-process lock, fresh reread and typed latest-state patch, persisted revision, under-lock CAS conflict with current_revision, and normalized no-op/read invariance. Step 3 builds/tests these repository primitives in isolation; its two repository subprocess writers are not falsely presented as app adoption. Step 4 atomically migrates every intent-bearing writer, app/startup adapters and settings-file autosave/exit-save ownership, with actual startup/cache and manager-race proof. No temporary full-snapshot conversion is introduced and CLI remains disabled until closure. This removes the sequencing hazard while preserving the required final all-surface transaction semantics.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L221-L225\",\n          \"excerpt\": \"### AC-004\\n\\n**Criterion:** Settings carry a persisted revision number returned by every read and incremented by 1 on every committed write from any surface, including writes made by Handy itself; a write that changes nothing and a read do not increment it. Writes accept `--expected-revision N`; a mismatch returns `revision_conflict` with the current revision in `error.details.current_revision` and writes nothing. All writers (UI commands, a running instance and a headless CLI process) are serialized by one cross-process settings lock, and each writer re-reads the stored settings under that lock before applying its change, so a write without expected revision applies to the latest settings and never discards fields changed by another writer.\\n**Priority:** P1 | **Story:** Story 3\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L18-L35\",\n          \"excerpt\": \"## Technical Context\\n\\n| Aspect | Choice | Reason / current evidence |\\n|---|---|---|\\n| Native | Rust edition 2021, Cargo, Tauri 2.11.5 | Current stack and Cargo manifest |\\n| Parsing / serialization | Existing clap 4, serde / serde_json | Typed subcommands; no second CLI executable |\\n| Async | Existing Tokio; enable required net/io/time/sync production features | Bounded IPC worker; keep native main thread free |\\n| Frontend | React 18, Zustand, i18next, TypeScript | Existing UI adapters and settings-changed listener |\\n| Persistence | Existing settings_store.json object, settings payload plus top-level settings_revision | Preserve unknown top-level/payload fields and schema migrations; no SQL table |\\n| Lock | One persistent settings.lock inode/handle per canonical store; fs2 cross-platform file locking | Same lock for UI, app mutations, startup and CLI; proposed dependency must be reviewed/pinned |\\n| Installed path resolver | Direct dirs 6, already resolved as 6.0.0 in Cargo.lock | Match current Tauri desktop app_data_dir: dirs::data_dir joined with configured identifier; no guessed HOME or new model library |\\n| Transport | Unix domain socket (macOS/Linux); Windows named pipe | Local only, explicit owner authentication; never TCP/MCP |\\n| Test levels | cargo unit/integration/process, Bun adapter tests, Playwright frontend regression, native release proof | Browser mocks cannot prove process/OS behavior |\\n| Store identity | Canonical absolute store path + user UID/SID, SHA-256 identity | Installed and portable paths resolve identically without AppHandle |\\n| Infrastructure | Local user directory, lock and endpoint only | No cloud resource, credentials or provisioning |\\n\\nInspect [existing parser](../../../src-tauri/src/cli.rs), [entry point](../../../src-tauri/src/main.rs), [startup](../../../src-tauri/src/lib.rs), [settings](../../../src-tauri/src/settings.rs), [portable paths](../../../src-tauri/src/portable.rs), [UI store](../../../src/stores/settingsStore.ts) and [Cargo manifest](../../../src-tauri/Cargo.toml) for implementation context. These source inspections do not replace acceptance requirements.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L69-L76\",\n          \"excerpt\": \"### Paths, storage and revision\\n\\nExtract side-effect-free StoreLocator from portable initialization. Read the portable marker without upgrading it or creating Data; resolve installed user app-data using the configured identifier com.pais.handy and OS APIs, not guessed HOME strings. For nonexistent paths, canonicalize the nearest existing ancestor, append validated components and reject symlink/reparse aliases that cross user boundaries. Lock identity survives atomic store replacement: lock the stable sibling lock file, never the replaced JSON inode.\\n\\nSettingsRepository reads fresh disk bytes under settings.lock; missing store gives defaults/revision 0. Read only salvage/migrate/merge defaults in memory, never save, create settings_store.json, upgrade portable marker or increment revision. Startup takes the same lock and explicitly commits any initialization/migration change once. Older stores with no revision start at 0; first changed commit is 1. Preserve a valid top-level revision through payload salvage; malformed existing revision or unrecoverable revision continuity refuses writes with persistence_failed rather than reset-and-CAS. Entire unreadable JSON reports defaults with warning for read recovery, but cannot be overwritten automatically; explicit supported recovery is outside this feature. Semantic no-op after normalization does not write or increment; migrations persisted by startup are real writes. Reject revision overflow before native effects. Never silently reset the counter.\\n\\nCommit a typed mutation/patch against the newly loaded settings, not the caller's stale AppSettings snapshot. Validate the whole candidate and dependencies, compare normalized persisted values (including secret changes, excluding runtime overrides), increment once, serialize the entire preserved store object to a private same-directory temporary file, flush/sync, atomically replace and sync the parent directory on Unix (Windows replacement APIs and durable flush). Crash injection must observe old or new complete generation, never partial JSON. Disable plugin-store ownership/autosave/exit-save for this particular settings file; a reload alone cannot prevent a delayed old cache write. Other plugin stores remain unchanged. A compatibility AppHandle adapter reads the service snapshot; it cannot write the settings file independently. Activate app/startup adapters and transfer exclusive settings-file ownership only in Step4, atomically with all-writer migration; Step3 builds isolated repository/locator/normalization primitives while the existing app path and disabled settings CLI remain unchanged.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L77-L82\",\n          \"excerpt\": \"### All surfaces and live effects\\n\\nMigrate every writer before CLI set becomes reachable, including get_settings migration/default stores, shortcut fallback/reset commands, UI setters, audio/model selection repairs, model switches and history retention. The inventory is the actual call-site scan, not a hand-selected subset. Replace write_settings(AppSettings) with `commit_mutation` closures/typed patches and propagate Result. Preexisting runtime-only flags and forced-disable-updater remain overrides, never persisted writes.\\n\\nInject LiveSettingsEffects for native validation/preparation, shortcut registration, audio/model reconfiguration, autostart, theme/log settings and settings-changed. Worker transaction serializes prepare/validate → durable persist → publish snapshot → apply live effects → notify. Prepare any fallible reversible native change before commit; compensate it on persistence failure. For effects that can fail after durable commit, do not falsely return validation_failed: return internal_error with details `{outcome:\\\"committed\\\", current_revision:N, field:...}`, keep committed data authoritative and reconcile live state before accepting another affected mutation. Timeout still reports outcome unknown to the caller. P0 tests require invalid/refused values and failed preparation leave both disk and revision unchanged, and injected effect failure never yields a success with stale shortcuts. UI native command adapters become async workers where needed; never wait for a worker holding the transaction lock from the main thread. Event contains revision and changed key names only, no secret values; the existing listener refreshes and discards older refresh responses by revision.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L124-L211\",\n          \"excerpt\": \"## Gherkin Scenarios and Sequence Diagrams\\n\\n```gherkin\\nFeature: Shared live settings transaction\\n  Scenario: Successful live mutation\\n    Given the same user's instance has revision 41 and a private channel\\n    When the CLI sets paste_method to ctrl_v with expected revision 41\\n    Then the instance persists revision 42 before confirming success\\n    And native effects finish and the UI receives settings-changed\\n  Scenario: Stale or timed-out request\\n    Given current revision is 42\\n    When expected revision is 41\\n    Then revision_conflict returns current_revision 42 without mutation\\n    When an accepted request produces no answer within 5 seconds\\n    Then unavailable reports outcome unknown without offline fallback\\n```\\n\\n```mermaid\\nsequenceDiagram\\n  participant CLI\\n  participant IPC as Private channel\\n  participant Service as Live commit worker\\n  participant Disk as Fresh repository and lock\\n  participant Native as Native effects\\n  participant UI\\n  CLI->>IPC: operation, store identity, expected revision\\n  IPC->>Service: authenticated typed request\\n  Service->>Disk: lock and reread\\n  alt revision mismatch or invalid\\n    Service-->>CLI: error envelope; no write\\n  else changed candidate\\n    Service->>Native: prepare reversible effects\\n    Service->>Disk: atomic persist, revision plus 1\\n    Service->>Native: apply and confirm\\n    Service->>UI: settings-changed revision and keys\\n    Service-->>CLI: success envelope\\n  else no-op\\n    Service-->>CLI: current revision unchanged\\n  end\\n  alt no reply before deadline\\n    CLI->>CLI: unavailable, outcome unknown; reread before retry\\n  end\\n```\\n\\n```gherkin\\nFeature: Safe offline settings access\\n  Scenario: Read missing or salvageable store\\n    Given no Handy instance exists\\n    When the CLI reads settings\\n    Then defaults or salvage are returned without creating or rewriting the store\\n    And a warning goes only to stderr when recovery was needed\\n  Scenario: Startup competes with offline write\\n    Given a GUI startup and headless write target the same store\\n    When both acquire shared ownership and transaction guards\\n    Then the write is visible at startup or routed to the new instance\\n    And each changed transaction increments revision exactly once\\n  Scenario: Older instance present\\n    Given an older same-user Handy instance holds its legacy identity\\n    When the CLI requests a mutation\\n    Then unavailable is returned without a callback or store write\\n```\\n\\n```mermaid\\nsequenceDiagram\\n  participant CLI\\n  participant Owner as Lease and legacy probe\\n  participant Repo as Locked fresh repository\\n  participant App as Starting app\\n  CLI->>Owner: inspect private lease and legacy identity\\n  alt authenticated new instance\\n    Owner-->>CLI: route private request\\n  else old, busy, or uncertain\\n    Owner-->>CLI: unavailable; no write\\n  else proven offline\\n    CLI->>Repo: take transaction lock\\n    CLI->>Owner: recheck new lease and passive legacy state\\n    CLI->>Repo: read or validate patch\\n    alt read or dry-run\\n      Repo-->>CLI: projection or preview; no persist\\n    else changed write\\n      Repo->>Repo: durable replace with next revision\\n      Repo-->>CLI: success\\n    end\\n    App->>Repo: startup waits, then reads committed store\\n    CLI->>Owner: release transaction lock\\n  end\\n```\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L312-L321\",\n          \"excerpt\": \"### Step 3 — Build atomic repository, revision and locking\\n\\n**Prerequisite:** Step 2 validators and mutation types stable; repository work is isolated/pure, with no running-app adoption before the coordinated Step4 cutover.\\n**Required inputs:** Pure StoreLocator, raw store shape, extracted normalization/migrations/salvage helpers, stable lock, new-instance lease and passive legacy probe; current Tauri desktop path resolver and already-locked dirs 6.\\n**Action:** New `settings_service/{store.rs,transaction.rs}` implement isolated non-creating `read_snapshot`, lock/reload/patch `commit_mutation`, pure startup normalization transaction logic, no-op/CAS/overflow and durable replacement. Expose side-effect-free locator/normalization helpers from portable/settings logic, using direct dirs 6 (already locked) to match Tauri native path resolution. Keep existing AppHandle reads/writes/startup and settings-file plugin ownership unchanged; no production CLI mutation reachability. Do not add a temporary full-snapshot-to-patch adapter or global provenance/cache machinery. New `src-tauri/tests/settings_transactions.rs` uses private stores, barriers, two subprocess repository writers and crash/fault injection.\\n**FR covered:** FR-002.2: Non-mutating fresh reads, FR-003.2: Durable revision and atomic patch, FR-004.2: Startup ownership fence\\n**Execution evidence:** Isolated repository before/after hashes, revision sequences, independent raw-file reader, crash old-or-new snapshots, lock identity tests across rename and pure normalization/startup-transaction races. Running-app startup/cache/no-stale-plugin-flush proof belongs to the Step4 all-writer cutover.\\n**Success criteria:** Isolated repository mutations lose no fields; stale CAS refused, no-op/read invariant, secrets/unknown fields preserved and pure startup normalization observes complete generations. No claim that the running app has adopted this repository or that its old cache/writers are already removed.\\n**Failure handling:** Persistence failure leaves old durable generation; uncertain durable outcome is explicit, never blanket retry; invalid revision continuity blocks writes. Any attempted running-app/service adoption before all-writer closure is blocked until Step4, rather than repaired with an ambiguous snapshot adapter.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L322-L331\",\n          \"excerpt\": \"### Step 4 — Migrate every app writer and live side effect\\n\\n**Prerequisite:** Isolated Step3 repository tests PASS; no running-app repository adoption or CLI mutation entry point enabled. Prepare one coordinated cutover covering every existing writer and settings-specific plugin ownership.\\n**Required inputs:** Full write_settings and store.set inventory, manager repairs, startup migrations, typed native ports.\\n**Action:** Modify settings.rs, shortcut/mod.rs, commands/{mod.rs,audio.rs,models.rs,history.rs,transcription.rs}, managers/{audio.rs,model.rs} and lib.rs. Replace every snapshot rewrite with a minimal mutation applied to latest state; adapt fallback repairs and secret UI writes. In the same coordinated all-writer cutover, activate AppHandle/service reads, writes and app startup normalization, transfer exclusive settings_store.json ownership and disable that file's plugin autosave/exit-save participation; retain other plugin stores. Never expose repository adoption alongside stale full-snapshot writers. New `settings_service/live.rs` owns ordered effects and reconciliation. Modify settingsStore.ts to consume revisions/typed errors, regenerate bindings.ts via supported specta export and add en/fr i18n keys using existing translation checks. No new screens/layout. New tests verify writer inventory closure and genuine UI adapters, compensation and post-commit failure behavior.\\n**FR covered:** FR-003.3: All writers and live adapters, FR-006.2: Stable UI errors and translations\\n**Execution evidence:** Exhaustive writer scan with no direct settings-file writer remaining, settings-specific plugin ownership/autosave/exit-save closure, actual app startup/write race and no-stale-cache-flush proof, parity report, manager mutation race tests, UI event/read ordering tests and native shortcut re-registration evidence.\\n**Success criteria:** App adopts the repository only with complete all-writer/settings-file ownership closure; startup sees complete commits with no independent stale-cache flush. Every committed app write increments once; rejected values change nothing; native updates/UI refresh complete before success; runtime-only settings stay runtime-only.\\n**Failure handling:** Any direct writer/cache autosave remaining blocks CLI enablement; main-thread waits, rollback failure or stale effect is P0.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:AC-005\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"Same-user/store live routing uses private local sockets/pipes, a total monotonic five-second deadline, ordered effects/UI notification and no offline fallback after accepted/unknown requests. Offline operations share validation/lock and ownership recheck; old/uncertain owners and absent live-only capability refuse without write. Unix canonical current-UID directory/identity guards and kernel UID enforcement in both directions precede application bytes; socket mode, protocol UID/PID and process umask cannot authorize. Retained paths prevent substitute deletion and Step 5 owns lease-proven restart reclamation. Cross-session absence remains the warning below. Step 4 coordinated app/startup adoption preserves the fence rather than activating it amid old writers. Native foreign/legacy/account observations are pending, not design-issued runtime proof.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L226-L230\",\n          \"excerpt\": \"### AC-005\\n\\n**Criterion:** When a Handy instance of the same user and settings store is running, the CLI sends the operation to it over a local channel accessible only to that user and waits up to 5 seconds for its answer; the instance applies it with its live state, re-registers affected shortcuts and notifies its UI. If no answer arrives in time, the CLI returns `unavailable` with `error.details.outcome` set to `unknown`, and agents must read again before retrying. If a running Handy without this channel (an older version) is detected, the CLI returns `unavailable` and never writes the store itself. When none is running, the CLI applies the operation to the settings store itself under the same lock and validation. Operations that need live state (for example the current destination) return `unavailable` without a running instance. No network listener and no MCP server are introduced.\\n**Priority:** P1 | **Story:** Stories 2, 3 and 5\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L83-L102\",\n          \"excerpt\": \"### Routing, startup fence and legacy compatibility\\n\\nNew app acquires a per-user/store instance lease before loading settings, under settings.lock, publishes its private endpoint before releasing startup ownership, and keeps the lease until shutdown. A headless writer acquires settings.lock, then checks the new lease/endpoint and passive legacy state again immediately before commit. GUI startup for the new version uses that same lock; it reads a complete commit or establishes ownership before the CLI can mutate. The lease is separate from the transaction lock; a busy or starting owner never means offline permission. A stale new-version endpoint is reclaimable only after OS liveness/ownership proof and protected removal; ambiguous access returns unavailable with no write.\\n\\n| OS | Private request channel / peer verification | Passive older-instance detection |\\n|---|---|---|\\n| macOS | Short AF_UNIX SOCK_STREAM path in a canonical current-UID-owned directory (0700), with owner/type/device/inode guards; both endpoints enforce kernel peer UID via getpeereid before any application bytes | Inspect `/tmp/com_pais_handy_si.sock` type/owner without connecting, reading a legacy frame, invoking callback or removing it. Reuse inspect_legacy_path and its Absent/Occupied/Unavailable results. Stale/uncertain legacy resources refuse mutation rather than authorize deletion |\\n| Linux | AF_UNIX SOCK_STREAM under validated current-UID-owned directory (0700), XDG_RUNTIME_DIR or short private fallback, with owner/type/device/inode guards; both endpoints enforce checked SO_PEERCRED UID before any application bytes | Query session DBus `com.pais.handy.SingleInstance` through NameHasOwner/GetNameOwner only; never own that name, serve ExecuteCallback or call it. Errors/unknown scope refuse mutation |\\n| Windows | Named pipe keyed by SID+store hash, protected current-logon-SID DACL, reject remote clients and verify client token | Query legacy `com.pais.handy-sim` mutex and `com.pais.handy-sic`/`com.pais.handy-siw` target without WM_COPYDATA. Never reserve the mutex or create a compatibility window/message loop. Missing/ambiguous ownership evidence refuses mutation |\\n\\nUnix channel authorization uses the validated canonical current-UID directory with mode 0700 plus retained directory/socket owner, type, device/inode and single-link checks. Revalidate directory identity before/after bind and before accept/connect; refuse hostile aliases/replacements without touching substitutes. Bind without changing process-global umask, pathname chmod or a bootstrap-permission framework. Socket mode is diagnostic, not a portable security boundary. On macOS, ACLs can grant traversal/connection beyond ordinary mode bits, so mode 0700 alone is not exhaustive access proof: accepted clients and connected servers must each pass kernel-derived expected UID authentication before request parsing, response rendering or any application read/write. Failure closes/refuses the connection with no application bytes or store mutation; protocol UID/PID fields are never authorization evidence. Same-UID identity changes fail closed; no atomic pathname-race guarantee is claimed. Failed/closed socket names are retained rather than removed through a racy stat/check-then-unlink; Step 5 implements reviewed lease-proven reclamation so normal restart remains possible. Never delete the legacy singleton path.\\n\\n**Informative:** Inspect [Linux unix(7)](https://man7.org/linux/man-pages/man7/unix.7.html) for pathname/socket permission portability and kernel SO_PEERCRED context; inspect [Apple getpeereid(3)](https://developer.apple.com/library/archive/documentation/System/Conceptual/ManPages_iPhoneOS/man3/getpeereid.3.html) for both-side peer effective UID authentication. These references explain the mechanism; they add no external normative requirement or acceptance graph.\\n\\nInspect the locked [macOS plugin source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/macos.rs), [Windows source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/windows.rs) and [Linux source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/linux.rs). Cargo.lock resolves 2.4.0; recalculate identities if that dependency changes. Legacy identities do not prove store identity, so refuse conservatively for a same-user legacy owner even with an apparently different store. Do not connect/send an empty command: macOS empty streams can invoke show-window. Detected old instance means unavailable/5 and byte-identical store/revision, for reads or writes that would otherwise go to it.\\n\\nMinimal AC-005 scope: passive detection and refusal only. **No legacy invocation handoff, worker, spool, capture, acknowledgement, replay or recovery daemon is planned.** Offline CLI and new startup never impersonate an old singleton. Existing historical flags still use their current single-instance flow outside `settings`. Remove obsolete spike decoder/spool/reservation code and handoff tests during implementation, preserving the passive probe and reusable private-resource/peer-UID helpers. No code is removed by this planning command. Older versions do not participate in the new lock: a launch after the final passive probe is not claimed to be atomically fenced or delivered/replayed. This unsupported old-version race is documented; deterministic probes refuse an owner that appears before commit. Real older-binary race observations are pending release evidence, never a demand to recreate replay.\\n\\nRequests to a running new app carry protocol version, user/store identity, opaque request ID, typed operation, expected revision and dry_run. Bound UTF-8 frames to 1 MiB, reject malformed/oversized input without raw dumps. Domain imports share this technical limit until their owner defines another. Requests contain no raw argv. Use a monotonic 5 s end-to-end response deadline, including lock/persistence/transport wait. Successful M1 reads finish within 2 s; timeout failures are measured separately. No offline fallback write or blind retry after submission/timeout; reread revision/value first. Late replies cannot resurrect an expired request.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L77-L82\",\n          \"excerpt\": \"### All surfaces and live effects\\n\\nMigrate every writer before CLI set becomes reachable, including get_settings migration/default stores, shortcut fallback/reset commands, UI setters, audio/model selection repairs, model switches and history retention. The inventory is the actual call-site scan, not a hand-selected subset. Replace write_settings(AppSettings) with `commit_mutation` closures/typed patches and propagate Result. Preexisting runtime-only flags and forced-disable-updater remain overrides, never persisted writes.\\n\\nInject LiveSettingsEffects for native validation/preparation, shortcut registration, audio/model reconfiguration, autostart, theme/log settings and settings-changed. Worker transaction serializes prepare/validate → durable persist → publish snapshot → apply live effects → notify. Prepare any fallible reversible native change before commit; compensate it on persistence failure. For effects that can fail after durable commit, do not falsely return validation_failed: return internal_error with details `{outcome:\\\"committed\\\", current_revision:N, field:...}`, keep committed data authoritative and reconcile live state before accepting another affected mutation. Timeout still reports outcome unknown to the caller. P0 tests require invalid/refused values and failed preparation leave both disk and revision unchanged, and injected effect failure never yields a success with stale shortcuts. UI native command adapters become async workers where needed; never wait for a worker holding the transaction lock from the main thread. Event contains revision and changed key names only, no secret values; the existing listener refreshes and discards older refresh responses by revision.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L124-L211\",\n          \"excerpt\": \"## Gherkin Scenarios and Sequence Diagrams\\n\\n```gherkin\\nFeature: Shared live settings transaction\\n  Scenario: Successful live mutation\\n    Given the same user's instance has revision 41 and a private channel\\n    When the CLI sets paste_method to ctrl_v with expected revision 41\\n    Then the instance persists revision 42 before confirming success\\n    And native effects finish and the UI receives settings-changed\\n  Scenario: Stale or timed-out request\\n    Given current revision is 42\\n    When expected revision is 41\\n    Then revision_conflict returns current_revision 42 without mutation\\n    When an accepted request produces no answer within 5 seconds\\n    Then unavailable reports outcome unknown without offline fallback\\n```\\n\\n```mermaid\\nsequenceDiagram\\n  participant CLI\\n  participant IPC as Private channel\\n  participant Service as Live commit worker\\n  participant Disk as Fresh repository and lock\\n  participant Native as Native effects\\n  participant UI\\n  CLI->>IPC: operation, store identity, expected revision\\n  IPC->>Service: authenticated typed request\\n  Service->>Disk: lock and reread\\n  alt revision mismatch or invalid\\n    Service-->>CLI: error envelope; no write\\n  else changed candidate\\n    Service->>Native: prepare reversible effects\\n    Service->>Disk: atomic persist, revision plus 1\\n    Service->>Native: apply and confirm\\n    Service->>UI: settings-changed revision and keys\\n    Service-->>CLI: success envelope\\n  else no-op\\n    Service-->>CLI: current revision unchanged\\n  end\\n  alt no reply before deadline\\n    CLI->>CLI: unavailable, outcome unknown; reread before retry\\n  end\\n```\\n\\n```gherkin\\nFeature: Safe offline settings access\\n  Scenario: Read missing or salvageable store\\n    Given no Handy instance exists\\n    When the CLI reads settings\\n    Then defaults or salvage are returned without creating or rewriting the store\\n    And a warning goes only to stderr when recovery was needed\\n  Scenario: Startup competes with offline write\\n    Given a GUI startup and headless write target the same store\\n    When both acquire shared ownership and transaction guards\\n    Then the write is visible at startup or routed to the new instance\\n    And each changed transaction increments revision exactly once\\n  Scenario: Older instance present\\n    Given an older same-user Handy instance holds its legacy identity\\n    When the CLI requests a mutation\\n    Then unavailable is returned without a callback or store write\\n```\\n\\n```mermaid\\nsequenceDiagram\\n  participant CLI\\n  participant Owner as Lease and legacy probe\\n  participant Repo as Locked fresh repository\\n  participant App as Starting app\\n  CLI->>Owner: inspect private lease and legacy identity\\n  alt authenticated new instance\\n    Owner-->>CLI: route private request\\n  else old, busy, or uncertain\\n    Owner-->>CLI: unavailable; no write\\n  else proven offline\\n    CLI->>Repo: take transaction lock\\n    CLI->>Owner: recheck new lease and passive legacy state\\n    CLI->>Repo: read or validate patch\\n    alt read or dry-run\\n      Repo-->>CLI: projection or preview; no persist\\n    else changed write\\n      Repo->>Repo: durable replace with next revision\\n      Repo-->>CLI: success\\n    end\\n    App->>Repo: startup waits, then reads committed store\\n    CLI->>Owner: release transaction lock\\n  end\\n```\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L312-L321\",\n          \"excerpt\": \"### Step 3 — Build atomic repository, revision and locking\\n\\n**Prerequisite:** Step 2 validators and mutation types stable; repository work is isolated/pure, with no running-app adoption before the coordinated Step4 cutover.\\n**Required inputs:** Pure StoreLocator, raw store shape, extracted normalization/migrations/salvage helpers, stable lock, new-instance lease and passive legacy probe; current Tauri desktop path resolver and already-locked dirs 6.\\n**Action:** New `settings_service/{store.rs,transaction.rs}` implement isolated non-creating `read_snapshot`, lock/reload/patch `commit_mutation`, pure startup normalization transaction logic, no-op/CAS/overflow and durable replacement. Expose side-effect-free locator/normalization helpers from portable/settings logic, using direct dirs 6 (already locked) to match Tauri native path resolution. Keep existing AppHandle reads/writes/startup and settings-file plugin ownership unchanged; no production CLI mutation reachability. Do not add a temporary full-snapshot-to-patch adapter or global provenance/cache machinery. New `src-tauri/tests/settings_transactions.rs` uses private stores, barriers, two subprocess repository writers and crash/fault injection.\\n**FR covered:** FR-002.2: Non-mutating fresh reads, FR-003.2: Durable revision and atomic patch, FR-004.2: Startup ownership fence\\n**Execution evidence:** Isolated repository before/after hashes, revision sequences, independent raw-file reader, crash old-or-new snapshots, lock identity tests across rename and pure normalization/startup-transaction races. Running-app startup/cache/no-stale-plugin-flush proof belongs to the Step4 all-writer cutover.\\n**Success criteria:** Isolated repository mutations lose no fields; stale CAS refused, no-op/read invariant, secrets/unknown fields preserved and pure startup normalization observes complete generations. No claim that the running app has adopted this repository or that its old cache/writers are already removed.\\n**Failure handling:** Persistence failure leaves old durable generation; uncertain durable outcome is explicit, never blanket retry; invalid revision continuity blocks writes. Any attempted running-app/service adoption before all-writer closure is blocked until Step4, rather than repaired with an ambiguous snapshot adapter.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L322-L331\",\n          \"excerpt\": \"### Step 4 — Migrate every app writer and live side effect\\n\\n**Prerequisite:** Isolated Step3 repository tests PASS; no running-app repository adoption or CLI mutation entry point enabled. Prepare one coordinated cutover covering every existing writer and settings-specific plugin ownership.\\n**Required inputs:** Full write_settings and store.set inventory, manager repairs, startup migrations, typed native ports.\\n**Action:** Modify settings.rs, shortcut/mod.rs, commands/{mod.rs,audio.rs,models.rs,history.rs,transcription.rs}, managers/{audio.rs,model.rs} and lib.rs. Replace every snapshot rewrite with a minimal mutation applied to latest state; adapt fallback repairs and secret UI writes. In the same coordinated all-writer cutover, activate AppHandle/service reads, writes and app startup normalization, transfer exclusive settings_store.json ownership and disable that file's plugin autosave/exit-save participation; retain other plugin stores. Never expose repository adoption alongside stale full-snapshot writers. New `settings_service/live.rs` owns ordered effects and reconciliation. Modify settingsStore.ts to consume revisions/typed errors, regenerate bindings.ts via supported specta export and add en/fr i18n keys using existing translation checks. No new screens/layout. New tests verify writer inventory closure and genuine UI adapters, compensation and post-commit failure behavior.\\n**FR covered:** FR-003.3: All writers and live adapters, FR-006.2: Stable UI errors and translations\\n**Execution evidence:** Exhaustive writer scan with no direct settings-file writer remaining, settings-specific plugin ownership/autosave/exit-save closure, actual app startup/write race and no-stale-cache-flush proof, parity report, manager mutation race tests, UI event/read ordering tests and native shortcut re-registration evidence.\\n**Success criteria:** App adopts the repository only with complete all-writer/settings-file ownership closure; startup sees complete commits with no independent stale-cache flush. Every committed app write increments once; rejected values change nothing; native updates/UI refresh complete before success; runtime-only settings stay runtime-only.\\n**Failure handling:** Any direct writer/cache autosave remaining blocks CLI enablement; main-thread waits, rollback failure or stale effect is P0.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L352-L361\",\n          \"excerpt\": \"### Step 7 — Prove macOS acceptance and track release evidence\\n\\n**Prerequisite:** Steps 1–6 complete; automated platform builds/tests run in supported environments; macOS release binary available. Native Windows/Linux, older-binary and second-account artifacts are not entry gates.\\n**Required inputs:** Independent AC/FR inventory, actual macOS binary, native harness/schema, isolated installed/portable stores and release-evidence check matrix.\\n**Action:** Add `src-tauri/tests/{settings_cli.rs,settings_routing.rs}` and `scripts/settings-native-proof.ts`; add `tests/settings-events.spec.ts` for existing frontend behavior. Run the automated commands below and mandatory macOS native checks, capture M1 read latency, no window/tray/model, real new-app IPC, live settings refresh and shortcut registration. The Bun child-process harness uses real binaries/private stores, not browser-only Tauri mocks. Exercise older-owner/foreign-peer branches with injected resources deterministically, then list the exact real Windows/Linux/older-binary/second-account checks as pending release evidence below.\\n**FR covered:** FR-001.3: Native flag and latency evidence, FR-002.4: Discovery and secret tests, FR-003.4: Parity and concurrency proof, FR-004.4: Real platform routing proof, FR-005.3: Domain acceptance proof, FR-006.5: Every owned code and exit proof\\n**Execution evidence:** macOS binary hash/OS/tool versions, stdout/stderr/exits, raw store generations, AC/FR/SC assertion matrix, native observations and every latency sample; build/test transcripts for supported code plus explicit pending release evidence rows with exact checks and no PASS.\\n**Success criteria:** Required automated P0/P1 checks have zero unexplained failures; macOS native proof is complete before Implemented; every AC/SC has a truthful coverage row distinguishing proved assertions from the pending platform/old-binary/second-user subsets. Those pending observations never block implementation steps, feature completion on the integration branch or merge into dev, and are never declared passed.\\n**Failure handling:** Missing macOS native acceptance blocks Implemented; automated failure/data/secret defects require repair. Missing Windows/Linux/old-binary/second-account native observations stay pending release evidence, with exact check and owner, rather than BLOCKED for this feature or dev merge.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:AC-006\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The Domain trait supplies schema/help, file/dash input, pure validation, preview, typed atomic patches and export formatting. Existing output fields use shared descriptors; later production domains remain owned by later features. Valid dry-run emits preview/revision without persistence/effects and invalid dry-run refuses. Step 6 implements bounded input, exact compiled-domain help and fixture-based atomic/import/export/live-only tests. The fixture is explicitly permitted by the spec and absent from production help.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L231-L235\",\n          \"excerpt\": \"### AC-006\\n\\n**Criterion:** This feature delivers the shared domain framework (argument parsing, file or `-` (stdin) input, `--dry-run` preview for bulk changes, atomic commit, help text per command) and the output domain for the existing output settings (paste method, clipboard handling, existing auto-submit). The domains microphones, replacements, vocabulary, shortcuts, prompts, destination and the new output settings (smart paste method, automatic Enter) are added on this framework by the features that own them (001–007, 009, 010). `handy settings --help` lists exactly the domains present in the build.\\n**Priority:** P1 | **Story:** Story 4\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L48-L60\",\n          \"excerpt\": \"## Requirement Inventory and Scope\\n\\n| Requirement | Acceptance / measure | Implementation steps |\\n|---|---|---|\\n| FR-001 | AC-001; existing flags, no visible UI/tray/model, M1 reads ≤2 s | 1, 5, 7 |\\n| FR-002 | AC-002; descriptors, scalar parsing, redaction, non-creating reads | 2, 6, 7 |\\n| FR-003 | AC-003/004; SC-001/002, all writers, no-op/CAS | 2, 3, 4, 7 |\\n| FR-004 | AC-005; private IPC, 5 s, unknown outcome, older-instance refusal | 1, 3, 5, 7 |\\n| FR-005 | AC-006; framework plus existing output domain only | 2, 6, 7 |\\n| FR-006 | AC-007/008; SC-003, one envelope, channels, stable exits | 2, 5, 6, 7 |\\n\\n008 does not deliver microphone priority, replacements, new vocabulary/shortcut/prompt operations, destination/PIN, smart paste execution or automatic Enter. Existing lists are readable; generic set refuses them. Their later owners register domains and aliases (`edit`→`update`, `delete`→`remove`) without changing the framework. Only `output` appears as a production domain in the 008 build. A fixture bulk/live domain is compiled only in tests.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L342-L351\",\n          \"excerpt\": \"### Step 6 — Deliver output domain and bulk framework\\n\\n**Prerequisite:** Step 5 generic routing operational in isolated tests.\\n**Required inputs:** Registered descriptor set, input reader, preview and export ports.\\n**Action:** New `settings_service/{domains/mod.rs,domains/output.rs,input.rs}` registers existing output get/set, extension aliases/help and bounded file/stdin processing. New test-only domain uses the production framework for import/export, merge/replace, dry-run and live-only fixture operations. New `src-tauri/tests/settings_domains.rs` asserts help contains exactly production domains and export channel behavior. Update README.md CLI usage and recovery/no-blind-retry instructions during implementation.\\n**FR covered:** FR-002.3: Generic list and secret denial, FR-005.2: Output and bulk framework, FR-006.4: Help export and agent recovery docs\\n**Execution evidence:** Valid/invalid UTF-8 and offset, invalid dry-run exit 2, valid preview zero mutations/effects, atomic bulk rejection, help snapshots and raw/JSON export tests.\\n**Success criteria:** Only output production domain; no premature future settings; one shared commit path, no stdin prompt, additive domain registration.\\n**Failure handling:** Domain-specific policy stays with owning feature; invalid preview cannot be accepted as success.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:AC-007\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The single renderer explicitly defines success/failure envelopes with object details, newline and stderr diagnostics; raw human export and JSON data.content are specified. The Step 5 renderer is bound to the exact source output contract, including readable human mode, and generic/parse/error paths plus Step 6 export-channel tests are assigned. Step 7 records actual stdout/stderr/exits. The submitted slice provides contract ownership and proof targets, not a runtime transcript PASS.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L236-L240\",\n          \"excerpt\": \"### AC-007\\n\\n**Criterion:** With `--json`, stdout contains exactly one JSON envelope: success `{\\\"ok\\\": true, \\\"revision\\\": N, \\\"data\\\": …}`, failure `{\\\"ok\\\": false, \\\"error\\\": {\\\"code\\\": C, \\\"message\\\": M, \\\"details\\\": {…}}}` where `details` is always an object (for example `current_revision`, `outcome`, `field`, `issues` as a list of `{field, reason}`). Without `--json`, stdout shows readable text. Diagnostics, warnings and progress go to stderr in both modes. Export operations writing to `-` print only the exported content without `--json`, and put it in `data.content` of the envelope with `--json`.\\n**Priority:** P1 | **Story:** Stories 1 and 5\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L342-L351\",\n          \"excerpt\": \"### Step 6 — Deliver output domain and bulk framework\\n\\n**Prerequisite:** Step 5 generic routing operational in isolated tests.\\n**Required inputs:** Registered descriptor set, input reader, preview and export ports.\\n**Action:** New `settings_service/{domains/mod.rs,domains/output.rs,input.rs}` registers existing output get/set, extension aliases/help and bounded file/stdin processing. New test-only domain uses the production framework for import/export, merge/replace, dry-run and live-only fixture operations. New `src-tauri/tests/settings_domains.rs` asserts help contains exactly production domains and export channel behavior. Update README.md CLI usage and recovery/no-blind-retry instructions during implementation.\\n**FR covered:** FR-002.3: Generic list and secret denial, FR-005.2: Output and bulk framework, FR-006.4: Help export and agent recovery docs\\n**Execution evidence:** Valid/invalid UTF-8 and offset, invalid dry-run exit 2, valid preview zero mutations/effects, atomic bulk rejection, help snapshots and raw/JSON export tests.\\n**Success criteria:** Only output production domain; no premature future settings; one shared commit path, no stdin prompt, additive domain registration.\\n**Failure handling:** Domain-specific policy stays with owning feature; invalid preview cannot be accepted as success.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L352-L361\",\n          \"excerpt\": \"### Step 7 — Prove macOS acceptance and track release evidence\\n\\n**Prerequisite:** Steps 1–6 complete; automated platform builds/tests run in supported environments; macOS release binary available. Native Windows/Linux, older-binary and second-account artifacts are not entry gates.\\n**Required inputs:** Independent AC/FR inventory, actual macOS binary, native harness/schema, isolated installed/portable stores and release-evidence check matrix.\\n**Action:** Add `src-tauri/tests/{settings_cli.rs,settings_routing.rs}` and `scripts/settings-native-proof.ts`; add `tests/settings-events.spec.ts` for existing frontend behavior. Run the automated commands below and mandatory macOS native checks, capture M1 read latency, no window/tray/model, real new-app IPC, live settings refresh and shortcut registration. The Bun child-process harness uses real binaries/private stores, not browser-only Tauri mocks. Exercise older-owner/foreign-peer branches with injected resources deterministically, then list the exact real Windows/Linux/older-binary/second-account checks as pending release evidence below.\\n**FR covered:** FR-001.3: Native flag and latency evidence, FR-002.4: Discovery and secret tests, FR-003.4: Parity and concurrency proof, FR-004.4: Real platform routing proof, FR-005.3: Domain acceptance proof, FR-006.5: Every owned code and exit proof\\n**Execution evidence:** macOS binary hash/OS/tool versions, stdout/stderr/exits, raw store generations, AC/FR/SC assertion matrix, native observations and every latency sample; build/test transcripts for supported code plus explicit pending release evidence rows with exact checks and no PASS.\\n**Success criteria:** Required automated P0/P1 checks have zero unexplained failures; macOS native proof is complete before Implemented; every AC/SC has a truthful coverage row distinguishing proved assertions from the pending platform/old-binary/second-user subsets. Those pending observations never block implementation steps, feature completion on the integration branch or merge into dev, and are never declared passed.\\n**Failure handling:** Missing macOS native acceptance blocks Implemented; automated failure/data/secret defects require repair. Missing Windows/Linux/old-binary/second-account native observations stay pending release evidence, with exact check and owner, rather than BLOCKED for this feature or dev merge.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:AC-008\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The complete stable code/exit mapping appears in the contract-rendering design and is owned by the enum/renderer. DTO/schema and command-matrix documentation are generated; Step 5 binds exits to the exact source contract and Step 7 requires every-owned-code/exit proof. Existing domain code meanings are kept, with their behavior owned by the later domain features. No current DTO or primitive test is treated as complete process-exit coverage.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L241-L245\",\n          \"excerpt\": \"### AC-008\\n\\n**Criterion:** Error codes and exit codes are stable and documented: `usage_error` and `validation_failed`, `shortcut_conflict`, `limit_exceeded` → 2; `revision_conflict` → 3; `not_found` → 4; `unavailable` → 5; `persistence_failed` and `internal_error` → 1; success → 0. New codes may be added; existing ones never change meaning.\\n**Priority:** P1 | **Story:** Story 5\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L302-L311\",\n          \"excerpt\": \"### Step 2 — Define descriptors, validators and DTO contracts\\n\\n**Prerequisite:** Step 1 retained primitives and automated checks pass; current UI/writer inventory captured. Pending release evidence does not block this step.\\n**Required inputs:** All AppSettings fields, UI command validators and current output enums, spec error table.\\n**Action:** Add the missing `settings_service/{mod.rs,descriptor.rs,validation.rs,protocol.rs,errors.rs}` around the retained Step 1 modules define SettingDescriptor, SettingsMutation, SettingsSnapshot, Revision, PublicSettings, OperationRequest and SettingsError. Build shared validators for every corresponding UI setting and existing domain operation; migrate invalid-to-default behavior to errors. New inline unit tests and `src-tauri/tests/settings_validation.rs` exercise real adapters against an independently maintained cases inventory. Generate `contracts/settings-cli.schema.json` from DTOs during implementation, plus `contracts/settings-cli.md` command matrix; schemas are not OpenAPI. Modify Cargo.toml for reviewed fs2, OS APIs and required Tokio features, not new model dependencies.\\n**FR covered:** FR-002.1: Complete descriptor and redaction model, FR-003.1: Shared typed validation, FR-005.1: Domain extension interface, FR-006.1: Typed errors and envelope contract\\n**Execution evidence:** Inventory diff, schema contract tests, valid/invalid/boundary cases including booleans, integers, enums, optional strings, read-only/secret/list keys.\\n**Success criteria:** Every persisted key classified; 100% settable-key UI/CLI parity including English reasons; unknown and unregistered-domain guidance deterministic; no secret serialization path.\\n**Failure handling:** Missing descriptor, divergent validation or leaked value is P0; repair before transaction integration.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L342-L351\",\n          \"excerpt\": \"### Step 6 — Deliver output domain and bulk framework\\n\\n**Prerequisite:** Step 5 generic routing operational in isolated tests.\\n**Required inputs:** Registered descriptor set, input reader, preview and export ports.\\n**Action:** New `settings_service/{domains/mod.rs,domains/output.rs,input.rs}` registers existing output get/set, extension aliases/help and bounded file/stdin processing. New test-only domain uses the production framework for import/export, merge/replace, dry-run and live-only fixture operations. New `src-tauri/tests/settings_domains.rs` asserts help contains exactly production domains and export channel behavior. Update README.md CLI usage and recovery/no-blind-retry instructions during implementation.\\n**FR covered:** FR-002.3: Generic list and secret denial, FR-005.2: Output and bulk framework, FR-006.4: Help export and agent recovery docs\\n**Execution evidence:** Valid/invalid UTF-8 and offset, invalid dry-run exit 2, valid preview zero mutations/effects, atomic bulk rejection, help snapshots and raw/JSON export tests.\\n**Success criteria:** Only output production domain; no premature future settings; one shared commit path, no stdin prompt, additive domain registration.\\n**Failure handling:** Domain-specific policy stays with owning feature; invalid preview cannot be accepted as success.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L352-L361\",\n          \"excerpt\": \"### Step 7 — Prove macOS acceptance and track release evidence\\n\\n**Prerequisite:** Steps 1–6 complete; automated platform builds/tests run in supported environments; macOS release binary available. Native Windows/Linux, older-binary and second-account artifacts are not entry gates.\\n**Required inputs:** Independent AC/FR inventory, actual macOS binary, native harness/schema, isolated installed/portable stores and release-evidence check matrix.\\n**Action:** Add `src-tauri/tests/{settings_cli.rs,settings_routing.rs}` and `scripts/settings-native-proof.ts`; add `tests/settings-events.spec.ts` for existing frontend behavior. Run the automated commands below and mandatory macOS native checks, capture M1 read latency, no window/tray/model, real new-app IPC, live settings refresh and shortcut registration. The Bun child-process harness uses real binaries/private stores, not browser-only Tauri mocks. Exercise older-owner/foreign-peer branches with injected resources deterministically, then list the exact real Windows/Linux/older-binary/second-account checks as pending release evidence below.\\n**FR covered:** FR-001.3: Native flag and latency evidence, FR-002.4: Discovery and secret tests, FR-003.4: Parity and concurrency proof, FR-004.4: Real platform routing proof, FR-005.3: Domain acceptance proof, FR-006.5: Every owned code and exit proof\\n**Execution evidence:** macOS binary hash/OS/tool versions, stdout/stderr/exits, raw store generations, AC/FR/SC assertion matrix, native observations and every latency sample; build/test transcripts for supported code plus explicit pending release evidence rows with exact checks and no PASS.\\n**Success criteria:** Required automated P0/P1 checks have zero unexplained failures; macOS native proof is complete before Implemented; every AC/SC has a truthful coverage row distinguishing proved assertions from the pending platform/old-binary/second-user subsets. Those pending observations never block implementation steps, feature completion on the integration branch or merge into dev, and are never declared passed.\\n**Failure handling:** Missing macOS native acceptance blocks Implemented; automated failure/data/secret defects require repair. Missing Windows/Linux/old-binary/second-account native observations stay pending release evidence, with exact check and owner, rather than BLOCKED for this feature or dev merge.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:FR-001\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"Early nested settings parsing and return avoid GUI/model/single-instance effects while old flags remain on their original branch. The same executable keeps correct Windows console ownership; actual binary regression is assigned. Step histories show partial parser/console implementation only and do not negate the remaining production-path work.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L248-L252\",\n          \"excerpt\": \"### FR-001\\n\\n**Requirement:** Add a `settings` subcommand group to the existing executable that runs without GUI side effects and keeps existing flags unchanged.\\n**AC References:** AC-001\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L63-L68\",\n          \"excerpt\": \"### Entry point and Windows console\\n\\nUse `CliArgs::try_parse_from` before any Tauri builder, specta export, model/audio manager, portable mutating initialization or single-instance callback. `settings` runs and exits here; all old invocations retain their existing run branch. Accept both JSON placements and deduplicate them. Mixed settings with recording, startup, transcription/model/device/list/repeat flags is usage_error (2); `--debug` and `--json` remain compatible. Parser failures with JSON requested use the same envelope renderer without echoing raw values. JSON help is `{ok:true,revision:N,data:{help:...}}`, human help remains readable; obtain revision using the same non-mutating read path.\\n\\nWindows decision: retain one `handy.exe` with the **console PE subsystem** in debug and release. During implementation replace the current release-only `windows_subsystem=\\\"windows\\\"` attribute with the console selection; retain inherited stdout/stderr handles throughout the `settings` branch. The existing GUI branch calls `FreeConsole` before Tauri; never hide or close the parent's console, allocate another console or introduce a launcher/manifest policy. Existing headless transcription/list operations keep their console handles. Pure dispatch tests distinguish settings, existing headless, GUI and transcription-engine worker branches. Compile the Windows target in its supported native build environment and inspect PE OptionalHeader.Subsystem=3; compilation/header inspection tests this choice without claiming shell/UI runtime evidence. Inspect [Microsoft console creation](https://learn.microsoft.com/en-us/windows/console/creation-of-a-console) and [FreeConsole](https://learn.microsoft.com/en-us/windows/console/freeconsole) as technical context. Native cmd/PowerShell output, waits/exits, redirection and GUI launch/console-flash checks on the oldest supported Windows and 24H2 are **pending release evidence**; they never block Steps 1–7, feature completion on the integration branch or merge into `dev`. A compile failure remains a code defect to fix; missing Windows native observation does not become a step gate. No platform-native success is inferred from compilation.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L352-L361\",\n          \"excerpt\": \"### Step 7 — Prove macOS acceptance and track release evidence\\n\\n**Prerequisite:** Steps 1–6 complete; automated platform builds/tests run in supported environments; macOS release binary available. Native Windows/Linux, older-binary and second-account artifacts are not entry gates.\\n**Required inputs:** Independent AC/FR inventory, actual macOS binary, native harness/schema, isolated installed/portable stores and release-evidence check matrix.\\n**Action:** Add `src-tauri/tests/{settings_cli.rs,settings_routing.rs}` and `scripts/settings-native-proof.ts`; add `tests/settings-events.spec.ts` for existing frontend behavior. Run the automated commands below and mandatory macOS native checks, capture M1 read latency, no window/tray/model, real new-app IPC, live settings refresh and shortcut registration. The Bun child-process harness uses real binaries/private stores, not browser-only Tauri mocks. Exercise older-owner/foreign-peer branches with injected resources deterministically, then list the exact real Windows/Linux/older-binary/second-account checks as pending release evidence below.\\n**FR covered:** FR-001.3: Native flag and latency evidence, FR-002.4: Discovery and secret tests, FR-003.4: Parity and concurrency proof, FR-004.4: Real platform routing proof, FR-005.3: Domain acceptance proof, FR-006.5: Every owned code and exit proof\\n**Execution evidence:** macOS binary hash/OS/tool versions, stdout/stderr/exits, raw store generations, AC/FR/SC assertion matrix, native observations and every latency sample; build/test transcripts for supported code plus explicit pending release evidence rows with exact checks and no PASS.\\n**Success criteria:** Required automated P0/P1 checks have zero unexplained failures; macOS native proof is complete before Implemented; every AC/SC has a truthful coverage row distinguishing proved assertions from the pending platform/old-binary/second-user subsets. Those pending observations never block implementation steps, feature completion on the integration branch or merge into dev, and are never declared passed.\\n**Failure handling:** Missing macOS native acceptance blocks Implemented; automated failure/data/secret defects require repair. Missing Windows/Linux/old-binary/second-account native observations stay pending release evidence, with exact check and owner, rather than BLOCKED for this feature or dev merge.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:FR-002\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"Generic get/keys/set are assigned to source-bound CLI execution over complete descriptors and explicit presence-only public projection. Type/scalar/read-only/secret/list policies and deterministic unknown/domain guidance are designed. Pure non-creating reads precede production wiring. There is no dependence on raw AppSettings serialization for public output or an assumption that existing foundation alone satisfies full CLI behavior.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L253-L257\",\n          \"excerpt\": \"### FR-002\\n\\n**Requirement:** Provide generic get, keys and set operations over non-secret settings with redaction of secrets.\\n**AC References:** AC-002\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L69-L76\",\n          \"excerpt\": \"### Paths, storage and revision\\n\\nExtract side-effect-free StoreLocator from portable initialization. Read the portable marker without upgrading it or creating Data; resolve installed user app-data using the configured identifier com.pais.handy and OS APIs, not guessed HOME strings. For nonexistent paths, canonicalize the nearest existing ancestor, append validated components and reject symlink/reparse aliases that cross user boundaries. Lock identity survives atomic store replacement: lock the stable sibling lock file, never the replaced JSON inode.\\n\\nSettingsRepository reads fresh disk bytes under settings.lock; missing store gives defaults/revision 0. Read only salvage/migrate/merge defaults in memory, never save, create settings_store.json, upgrade portable marker or increment revision. Startup takes the same lock and explicitly commits any initialization/migration change once. Older stores with no revision start at 0; first changed commit is 1. Preserve a valid top-level revision through payload salvage; malformed existing revision or unrecoverable revision continuity refuses writes with persistence_failed rather than reset-and-CAS. Entire unreadable JSON reports defaults with warning for read recovery, but cannot be overwritten automatically; explicit supported recovery is outside this feature. Semantic no-op after normalization does not write or increment; migrations persisted by startup are real writes. Reject revision overflow before native effects. Never silently reset the counter.\\n\\nCommit a typed mutation/patch against the newly loaded settings, not the caller's stale AppSettings snapshot. Validate the whole candidate and dependencies, compare normalized persisted values (including secret changes, excluding runtime overrides), increment once, serialize the entire preserved store object to a private same-directory temporary file, flush/sync, atomically replace and sync the parent directory on Unix (Windows replacement APIs and durable flush). Crash injection must observe old or new complete generation, never partial JSON. Disable plugin-store ownership/autosave/exit-save for this particular settings file; a reload alone cannot prevent a delayed old cache write. Other plugin stores remain unchanged. A compatibility AppHandle adapter reads the service snapshot; it cannot write the settings file independently. Activate app/startup adapters and transfer exclusive settings-file ownership only in Step4, atomically with all-writer migration; Step3 builds isolated repository/locator/normalization primitives while the existing app path and disabled settings CLI remain unchanged.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L302-L311\",\n          \"excerpt\": \"### Step 2 — Define descriptors, validators and DTO contracts\\n\\n**Prerequisite:** Step 1 retained primitives and automated checks pass; current UI/writer inventory captured. Pending release evidence does not block this step.\\n**Required inputs:** All AppSettings fields, UI command validators and current output enums, spec error table.\\n**Action:** Add the missing `settings_service/{mod.rs,descriptor.rs,validation.rs,protocol.rs,errors.rs}` around the retained Step 1 modules define SettingDescriptor, SettingsMutation, SettingsSnapshot, Revision, PublicSettings, OperationRequest and SettingsError. Build shared validators for every corresponding UI setting and existing domain operation; migrate invalid-to-default behavior to errors. New inline unit tests and `src-tauri/tests/settings_validation.rs` exercise real adapters against an independently maintained cases inventory. Generate `contracts/settings-cli.schema.json` from DTOs during implementation, plus `contracts/settings-cli.md` command matrix; schemas are not OpenAPI. Modify Cargo.toml for reviewed fs2, OS APIs and required Tokio features, not new model dependencies.\\n**FR covered:** FR-002.1: Complete descriptor and redaction model, FR-003.1: Shared typed validation, FR-005.1: Domain extension interface, FR-006.1: Typed errors and envelope contract\\n**Execution evidence:** Inventory diff, schema contract tests, valid/invalid/boundary cases including booleans, integers, enums, optional strings, read-only/secret/list keys.\\n**Success criteria:** Every persisted key classified; 100% settable-key UI/CLI parity including English reasons; unknown and unregistered-domain guidance deterministic; no secret serialization path.\\n**Failure handling:** Missing descriptor, divergent validation or leaked value is P0; repair before transaction integration.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:FR-003\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The shared validation and lock/reload/patch service has persisted revision/CAS and normalized no-op semantics. The reviewed sequencing keeps repository development pure through Step 3 and moves actual app/startup adoption, every writer and settings-specific plugin ownership into the same Step 4 cutover. This avoids reconstructing intent from stale full snapshots or allowing mixed old/cache writers. Real adapter/live-effect tests and revision/cache closure remain mandatory before CLI reachability.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L258-L262\",\n          \"excerpt\": \"### FR-003\\n\\n**Requirement:** Expose one shared validation and commit service used by UI commands and CLI, with a persisted revision, optional expected-revision check and a single write lock.\\n**AC References:** AC-003, AC-004\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L69-L76\",\n          \"excerpt\": \"### Paths, storage and revision\\n\\nExtract side-effect-free StoreLocator from portable initialization. Read the portable marker without upgrading it or creating Data; resolve installed user app-data using the configured identifier com.pais.handy and OS APIs, not guessed HOME strings. For nonexistent paths, canonicalize the nearest existing ancestor, append validated components and reject symlink/reparse aliases that cross user boundaries. Lock identity survives atomic store replacement: lock the stable sibling lock file, never the replaced JSON inode.\\n\\nSettingsRepository reads fresh disk bytes under settings.lock; missing store gives defaults/revision 0. Read only salvage/migrate/merge defaults in memory, never save, create settings_store.json, upgrade portable marker or increment revision. Startup takes the same lock and explicitly commits any initialization/migration change once. Older stores with no revision start at 0; first changed commit is 1. Preserve a valid top-level revision through payload salvage; malformed existing revision or unrecoverable revision continuity refuses writes with persistence_failed rather than reset-and-CAS. Entire unreadable JSON reports defaults with warning for read recovery, but cannot be overwritten automatically; explicit supported recovery is outside this feature. Semantic no-op after normalization does not write or increment; migrations persisted by startup are real writes. Reject revision overflow before native effects. Never silently reset the counter.\\n\\nCommit a typed mutation/patch against the newly loaded settings, not the caller's stale AppSettings snapshot. Validate the whole candidate and dependencies, compare normalized persisted values (including secret changes, excluding runtime overrides), increment once, serialize the entire preserved store object to a private same-directory temporary file, flush/sync, atomically replace and sync the parent directory on Unix (Windows replacement APIs and durable flush). Crash injection must observe old or new complete generation, never partial JSON. Disable plugin-store ownership/autosave/exit-save for this particular settings file; a reload alone cannot prevent a delayed old cache write. Other plugin stores remain unchanged. A compatibility AppHandle adapter reads the service snapshot; it cannot write the settings file independently. Activate app/startup adapters and transfer exclusive settings-file ownership only in Step4, atomically with all-writer migration; Step3 builds isolated repository/locator/normalization primitives while the existing app path and disabled settings CLI remain unchanged.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L77-L82\",\n          \"excerpt\": \"### All surfaces and live effects\\n\\nMigrate every writer before CLI set becomes reachable, including get_settings migration/default stores, shortcut fallback/reset commands, UI setters, audio/model selection repairs, model switches and history retention. The inventory is the actual call-site scan, not a hand-selected subset. Replace write_settings(AppSettings) with `commit_mutation` closures/typed patches and propagate Result. Preexisting runtime-only flags and forced-disable-updater remain overrides, never persisted writes.\\n\\nInject LiveSettingsEffects for native validation/preparation, shortcut registration, audio/model reconfiguration, autostart, theme/log settings and settings-changed. Worker transaction serializes prepare/validate → durable persist → publish snapshot → apply live effects → notify. Prepare any fallible reversible native change before commit; compensate it on persistence failure. For effects that can fail after durable commit, do not falsely return validation_failed: return internal_error with details `{outcome:\\\"committed\\\", current_revision:N, field:...}`, keep committed data authoritative and reconcile live state before accepting another affected mutation. Timeout still reports outcome unknown to the caller. P0 tests require invalid/refused values and failed preparation leave both disk and revision unchanged, and injected effect failure never yields a success with stale shortcuts. UI native command adapters become async workers where needed; never wait for a worker holding the transaction lock from the main thread. Event contains revision and changed key names only, no secret values; the existing listener refreshes and discards older refresh responses by revision.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L302-L311\",\n          \"excerpt\": \"### Step 2 — Define descriptors, validators and DTO contracts\\n\\n**Prerequisite:** Step 1 retained primitives and automated checks pass; current UI/writer inventory captured. Pending release evidence does not block this step.\\n**Required inputs:** All AppSettings fields, UI command validators and current output enums, spec error table.\\n**Action:** Add the missing `settings_service/{mod.rs,descriptor.rs,validation.rs,protocol.rs,errors.rs}` around the retained Step 1 modules define SettingDescriptor, SettingsMutation, SettingsSnapshot, Revision, PublicSettings, OperationRequest and SettingsError. Build shared validators for every corresponding UI setting and existing domain operation; migrate invalid-to-default behavior to errors. New inline unit tests and `src-tauri/tests/settings_validation.rs` exercise real adapters against an independently maintained cases inventory. Generate `contracts/settings-cli.schema.json` from DTOs during implementation, plus `contracts/settings-cli.md` command matrix; schemas are not OpenAPI. Modify Cargo.toml for reviewed fs2, OS APIs and required Tokio features, not new model dependencies.\\n**FR covered:** FR-002.1: Complete descriptor and redaction model, FR-003.1: Shared typed validation, FR-005.1: Domain extension interface, FR-006.1: Typed errors and envelope contract\\n**Execution evidence:** Inventory diff, schema contract tests, valid/invalid/boundary cases including booleans, integers, enums, optional strings, read-only/secret/list keys.\\n**Success criteria:** Every persisted key classified; 100% settable-key UI/CLI parity including English reasons; unknown and unregistered-domain guidance deterministic; no secret serialization path.\\n**Failure handling:** Missing descriptor, divergent validation or leaked value is P0; repair before transaction integration.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L312-L321\",\n          \"excerpt\": \"### Step 3 — Build atomic repository, revision and locking\\n\\n**Prerequisite:** Step 2 validators and mutation types stable; repository work is isolated/pure, with no running-app adoption before the coordinated Step4 cutover.\\n**Required inputs:** Pure StoreLocator, raw store shape, extracted normalization/migrations/salvage helpers, stable lock, new-instance lease and passive legacy probe; current Tauri desktop path resolver and already-locked dirs 6.\\n**Action:** New `settings_service/{store.rs,transaction.rs}` implement isolated non-creating `read_snapshot`, lock/reload/patch `commit_mutation`, pure startup normalization transaction logic, no-op/CAS/overflow and durable replacement. Expose side-effect-free locator/normalization helpers from portable/settings logic, using direct dirs 6 (already locked) to match Tauri native path resolution. Keep existing AppHandle reads/writes/startup and settings-file plugin ownership unchanged; no production CLI mutation reachability. Do not add a temporary full-snapshot-to-patch adapter or global provenance/cache machinery. New `src-tauri/tests/settings_transactions.rs` uses private stores, barriers, two subprocess repository writers and crash/fault injection.\\n**FR covered:** FR-002.2: Non-mutating fresh reads, FR-003.2: Durable revision and atomic patch, FR-004.2: Startup ownership fence\\n**Execution evidence:** Isolated repository before/after hashes, revision sequences, independent raw-file reader, crash old-or-new snapshots, lock identity tests across rename and pure normalization/startup-transaction races. Running-app startup/cache/no-stale-plugin-flush proof belongs to the Step4 all-writer cutover.\\n**Success criteria:** Isolated repository mutations lose no fields; stale CAS refused, no-op/read invariant, secrets/unknown fields preserved and pure startup normalization observes complete generations. No claim that the running app has adopted this repository or that its old cache/writers are already removed.\\n**Failure handling:** Persistence failure leaves old durable generation; uncertain durable outcome is explicit, never blanket retry; invalid revision continuity blocks writes. Any attempted running-app/service adoption before all-writer closure is blocked until Step4, rather than repaired with an ambiguous snapshot adapter.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L322-L331\",\n          \"excerpt\": \"### Step 4 — Migrate every app writer and live side effect\\n\\n**Prerequisite:** Isolated Step3 repository tests PASS; no running-app repository adoption or CLI mutation entry point enabled. Prepare one coordinated cutover covering every existing writer and settings-specific plugin ownership.\\n**Required inputs:** Full write_settings and store.set inventory, manager repairs, startup migrations, typed native ports.\\n**Action:** Modify settings.rs, shortcut/mod.rs, commands/{mod.rs,audio.rs,models.rs,history.rs,transcription.rs}, managers/{audio.rs,model.rs} and lib.rs. Replace every snapshot rewrite with a minimal mutation applied to latest state; adapt fallback repairs and secret UI writes. In the same coordinated all-writer cutover, activate AppHandle/service reads, writes and app startup normalization, transfer exclusive settings_store.json ownership and disable that file's plugin autosave/exit-save participation; retain other plugin stores. Never expose repository adoption alongside stale full-snapshot writers. New `settings_service/live.rs` owns ordered effects and reconciliation. Modify settingsStore.ts to consume revisions/typed errors, regenerate bindings.ts via supported specta export and add en/fr i18n keys using existing translation checks. No new screens/layout. New tests verify writer inventory closure and genuine UI adapters, compensation and post-commit failure behavior.\\n**FR covered:** FR-003.3: All writers and live adapters, FR-006.2: Stable UI errors and translations\\n**Execution evidence:** Exhaustive writer scan with no direct settings-file writer remaining, settings-specific plugin ownership/autosave/exit-save closure, actual app startup/write race and no-stale-cache-flush proof, parity report, manager mutation race tests, UI event/read ordering tests and native shortcut re-registration evidence.\\n**Success criteria:** App adopts the repository only with complete all-writer/settings-file ownership closure; startup sees complete commits with no independent stale-cache flush. Every committed app write increments once; rejected values change nothing; native updates/UI refresh complete before success; runtime-only settings stay runtime-only.\\n**Failure handling:** Any direct writer/cache autosave remaining blocks CLI enablement; main-thread waits, rollback failure or stale effect is P0.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L124-L211\",\n          \"excerpt\": \"## Gherkin Scenarios and Sequence Diagrams\\n\\n```gherkin\\nFeature: Shared live settings transaction\\n  Scenario: Successful live mutation\\n    Given the same user's instance has revision 41 and a private channel\\n    When the CLI sets paste_method to ctrl_v with expected revision 41\\n    Then the instance persists revision 42 before confirming success\\n    And native effects finish and the UI receives settings-changed\\n  Scenario: Stale or timed-out request\\n    Given current revision is 42\\n    When expected revision is 41\\n    Then revision_conflict returns current_revision 42 without mutation\\n    When an accepted request produces no answer within 5 seconds\\n    Then unavailable reports outcome unknown without offline fallback\\n```\\n\\n```mermaid\\nsequenceDiagram\\n  participant CLI\\n  participant IPC as Private channel\\n  participant Service as Live commit worker\\n  participant Disk as Fresh repository and lock\\n  participant Native as Native effects\\n  participant UI\\n  CLI->>IPC: operation, store identity, expected revision\\n  IPC->>Service: authenticated typed request\\n  Service->>Disk: lock and reread\\n  alt revision mismatch or invalid\\n    Service-->>CLI: error envelope; no write\\n  else changed candidate\\n    Service->>Native: prepare reversible effects\\n    Service->>Disk: atomic persist, revision plus 1\\n    Service->>Native: apply and confirm\\n    Service->>UI: settings-changed revision and keys\\n    Service-->>CLI: success envelope\\n  else no-op\\n    Service-->>CLI: current revision unchanged\\n  end\\n  alt no reply before deadline\\n    CLI->>CLI: unavailable, outcome unknown; reread before retry\\n  end\\n```\\n\\n```gherkin\\nFeature: Safe offline settings access\\n  Scenario: Read missing or salvageable store\\n    Given no Handy instance exists\\n    When the CLI reads settings\\n    Then defaults or salvage are returned without creating or rewriting the store\\n    And a warning goes only to stderr when recovery was needed\\n  Scenario: Startup competes with offline write\\n    Given a GUI startup and headless write target the same store\\n    When both acquire shared ownership and transaction guards\\n    Then the write is visible at startup or routed to the new instance\\n    And each changed transaction increments revision exactly once\\n  Scenario: Older instance present\\n    Given an older same-user Handy instance holds its legacy identity\\n    When the CLI requests a mutation\\n    Then unavailable is returned without a callback or store write\\n```\\n\\n```mermaid\\nsequenceDiagram\\n  participant CLI\\n  participant Owner as Lease and legacy probe\\n  participant Repo as Locked fresh repository\\n  participant App as Starting app\\n  CLI->>Owner: inspect private lease and legacy identity\\n  alt authenticated new instance\\n    Owner-->>CLI: route private request\\n  else old, busy, or uncertain\\n    Owner-->>CLI: unavailable; no write\\n  else proven offline\\n    CLI->>Repo: take transaction lock\\n    CLI->>Owner: recheck new lease and passive legacy state\\n    CLI->>Repo: read or validate patch\\n    alt read or dry-run\\n      Repo-->>CLI: projection or preview; no persist\\n    else changed write\\n      Repo->>Repo: durable replace with next revision\\n      Repo-->>CLI: success\\n    end\\n    App->>Repo: startup waits, then reads committed store\\n    CLI->>Owner: release transaction lock\\n  end\\n```\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:FR-004\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"Private authenticated user/store routing and the monotonic response deadline distinguish new/live, old/uncertain and proven-offline states. Offline writes recheck ownership under the same repository lock; no legacy notification/replay/network/MCP listener is added. Directory/identity guards and kernel peer checks precede application bytes, with normal-restart reclamation assigned to Step 5. App startup adopts the fence only during the coordinated writer cutover. Cross-session absence must remain uncertain rather than inferred from a session-local negative.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L263-L267\",\n          \"excerpt\": \"### FR-004\\n\\n**Requirement:** Route CLI operations to a running instance over a user-only local channel with a 5-second timeout, or apply them headlessly when no instance runs.\\n**AC References:** AC-005\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L83-L102\",\n          \"excerpt\": \"### Routing, startup fence and legacy compatibility\\n\\nNew app acquires a per-user/store instance lease before loading settings, under settings.lock, publishes its private endpoint before releasing startup ownership, and keeps the lease until shutdown. A headless writer acquires settings.lock, then checks the new lease/endpoint and passive legacy state again immediately before commit. GUI startup for the new version uses that same lock; it reads a complete commit or establishes ownership before the CLI can mutate. The lease is separate from the transaction lock; a busy or starting owner never means offline permission. A stale new-version endpoint is reclaimable only after OS liveness/ownership proof and protected removal; ambiguous access returns unavailable with no write.\\n\\n| OS | Private request channel / peer verification | Passive older-instance detection |\\n|---|---|---|\\n| macOS | Short AF_UNIX SOCK_STREAM path in a canonical current-UID-owned directory (0700), with owner/type/device/inode guards; both endpoints enforce kernel peer UID via getpeereid before any application bytes | Inspect `/tmp/com_pais_handy_si.sock` type/owner without connecting, reading a legacy frame, invoking callback or removing it. Reuse inspect_legacy_path and its Absent/Occupied/Unavailable results. Stale/uncertain legacy resources refuse mutation rather than authorize deletion |\\n| Linux | AF_UNIX SOCK_STREAM under validated current-UID-owned directory (0700), XDG_RUNTIME_DIR or short private fallback, with owner/type/device/inode guards; both endpoints enforce checked SO_PEERCRED UID before any application bytes | Query session DBus `com.pais.handy.SingleInstance` through NameHasOwner/GetNameOwner only; never own that name, serve ExecuteCallback or call it. Errors/unknown scope refuse mutation |\\n| Windows | Named pipe keyed by SID+store hash, protected current-logon-SID DACL, reject remote clients and verify client token | Query legacy `com.pais.handy-sim` mutex and `com.pais.handy-sic`/`com.pais.handy-siw` target without WM_COPYDATA. Never reserve the mutex or create a compatibility window/message loop. Missing/ambiguous ownership evidence refuses mutation |\\n\\nUnix channel authorization uses the validated canonical current-UID directory with mode 0700 plus retained directory/socket owner, type, device/inode and single-link checks. Revalidate directory identity before/after bind and before accept/connect; refuse hostile aliases/replacements without touching substitutes. Bind without changing process-global umask, pathname chmod or a bootstrap-permission framework. Socket mode is diagnostic, not a portable security boundary. On macOS, ACLs can grant traversal/connection beyond ordinary mode bits, so mode 0700 alone is not exhaustive access proof: accepted clients and connected servers must each pass kernel-derived expected UID authentication before request parsing, response rendering or any application read/write. Failure closes/refuses the connection with no application bytes or store mutation; protocol UID/PID fields are never authorization evidence. Same-UID identity changes fail closed; no atomic pathname-race guarantee is claimed. Failed/closed socket names are retained rather than removed through a racy stat/check-then-unlink; Step 5 implements reviewed lease-proven reclamation so normal restart remains possible. Never delete the legacy singleton path.\\n\\n**Informative:** Inspect [Linux unix(7)](https://man7.org/linux/man-pages/man7/unix.7.html) for pathname/socket permission portability and kernel SO_PEERCRED context; inspect [Apple getpeereid(3)](https://developer.apple.com/library/archive/documentation/System/Conceptual/ManPages_iPhoneOS/man3/getpeereid.3.html) for both-side peer effective UID authentication. These references explain the mechanism; they add no external normative requirement or acceptance graph.\\n\\nInspect the locked [macOS plugin source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/macos.rs), [Windows source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/windows.rs) and [Linux source](https://raw.githubusercontent.com/tauri-apps/plugins-workspace/single-instance-v2.4.0/plugins/single-instance/src/platform_impl/linux.rs). Cargo.lock resolves 2.4.0; recalculate identities if that dependency changes. Legacy identities do not prove store identity, so refuse conservatively for a same-user legacy owner even with an apparently different store. Do not connect/send an empty command: macOS empty streams can invoke show-window. Detected old instance means unavailable/5 and byte-identical store/revision, for reads or writes that would otherwise go to it.\\n\\nMinimal AC-005 scope: passive detection and refusal only. **No legacy invocation handoff, worker, spool, capture, acknowledgement, replay or recovery daemon is planned.** Offline CLI and new startup never impersonate an old singleton. Existing historical flags still use their current single-instance flow outside `settings`. Remove obsolete spike decoder/spool/reservation code and handoff tests during implementation, preserving the passive probe and reusable private-resource/peer-UID helpers. No code is removed by this planning command. Older versions do not participate in the new lock: a launch after the final passive probe is not claimed to be atomically fenced or delivered/replayed. This unsupported old-version race is documented; deterministic probes refuse an owner that appears before commit. Real older-binary race observations are pending release evidence, never a demand to recreate replay.\\n\\nRequests to a running new app carry protocol version, user/store identity, opaque request ID, typed operation, expected revision and dry_run. Bound UTF-8 frames to 1 MiB, reject malformed/oversized input without raw dumps. Domain imports share this technical limit until their owner defines another. Requests contain no raw argv. Use a monotonic 5 s end-to-end response deadline, including lock/persistence/transport wait. Successful M1 reads finish within 2 s; timeout failures are measured separately. No offline fallback write or blind retry after submission/timeout; reread revision/value first. Late replies cannot resurrect an expired request.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L312-L321\",\n          \"excerpt\": \"### Step 3 — Build atomic repository, revision and locking\\n\\n**Prerequisite:** Step 2 validators and mutation types stable; repository work is isolated/pure, with no running-app adoption before the coordinated Step4 cutover.\\n**Required inputs:** Pure StoreLocator, raw store shape, extracted normalization/migrations/salvage helpers, stable lock, new-instance lease and passive legacy probe; current Tauri desktop path resolver and already-locked dirs 6.\\n**Action:** New `settings_service/{store.rs,transaction.rs}` implement isolated non-creating `read_snapshot`, lock/reload/patch `commit_mutation`, pure startup normalization transaction logic, no-op/CAS/overflow and durable replacement. Expose side-effect-free locator/normalization helpers from portable/settings logic, using direct dirs 6 (already locked) to match Tauri native path resolution. Keep existing AppHandle reads/writes/startup and settings-file plugin ownership unchanged; no production CLI mutation reachability. Do not add a temporary full-snapshot-to-patch adapter or global provenance/cache machinery. New `src-tauri/tests/settings_transactions.rs` uses private stores, barriers, two subprocess repository writers and crash/fault injection.\\n**FR covered:** FR-002.2: Non-mutating fresh reads, FR-003.2: Durable revision and atomic patch, FR-004.2: Startup ownership fence\\n**Execution evidence:** Isolated repository before/after hashes, revision sequences, independent raw-file reader, crash old-or-new snapshots, lock identity tests across rename and pure normalization/startup-transaction races. Running-app startup/cache/no-stale-plugin-flush proof belongs to the Step4 all-writer cutover.\\n**Success criteria:** Isolated repository mutations lose no fields; stale CAS refused, no-op/read invariant, secrets/unknown fields preserved and pure startup normalization observes complete generations. No claim that the running app has adopted this repository or that its old cache/writers are already removed.\\n**Failure handling:** Persistence failure leaves old durable generation; uncertain durable outcome is explicit, never blanket retry; invalid revision continuity blocks writes. Any attempted running-app/service adoption before all-writer closure is blocked until Step4, rather than repaired with an ambiguous snapshot adapter.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L322-L331\",\n          \"excerpt\": \"### Step 4 — Migrate every app writer and live side effect\\n\\n**Prerequisite:** Isolated Step3 repository tests PASS; no running-app repository adoption or CLI mutation entry point enabled. Prepare one coordinated cutover covering every existing writer and settings-specific plugin ownership.\\n**Required inputs:** Full write_settings and store.set inventory, manager repairs, startup migrations, typed native ports.\\n**Action:** Modify settings.rs, shortcut/mod.rs, commands/{mod.rs,audio.rs,models.rs,history.rs,transcription.rs}, managers/{audio.rs,model.rs} and lib.rs. Replace every snapshot rewrite with a minimal mutation applied to latest state; adapt fallback repairs and secret UI writes. In the same coordinated all-writer cutover, activate AppHandle/service reads, writes and app startup normalization, transfer exclusive settings_store.json ownership and disable that file's plugin autosave/exit-save participation; retain other plugin stores. Never expose repository adoption alongside stale full-snapshot writers. New `settings_service/live.rs` owns ordered effects and reconciliation. Modify settingsStore.ts to consume revisions/typed errors, regenerate bindings.ts via supported specta export and add en/fr i18n keys using existing translation checks. No new screens/layout. New tests verify writer inventory closure and genuine UI adapters, compensation and post-commit failure behavior.\\n**FR covered:** FR-003.3: All writers and live adapters, FR-006.2: Stable UI errors and translations\\n**Execution evidence:** Exhaustive writer scan with no direct settings-file writer remaining, settings-specific plugin ownership/autosave/exit-save closure, actual app startup/write race and no-stale-cache-flush proof, parity report, manager mutation race tests, UI event/read ordering tests and native shortcut re-registration evidence.\\n**Success criteria:** App adopts the repository only with complete all-writer/settings-file ownership closure; startup sees complete commits with no independent stale-cache flush. Every committed app write increments once; rejected values change nothing; native updates/UI refresh complete before success; runtime-only settings stay runtime-only.\\n**Failure handling:** Any direct writer/cache autosave remaining blocks CLI enablement; main-thread waits, rollback failure or stale effect is P0.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L124-L211\",\n          \"excerpt\": \"## Gherkin Scenarios and Sequence Diagrams\\n\\n```gherkin\\nFeature: Shared live settings transaction\\n  Scenario: Successful live mutation\\n    Given the same user's instance has revision 41 and a private channel\\n    When the CLI sets paste_method to ctrl_v with expected revision 41\\n    Then the instance persists revision 42 before confirming success\\n    And native effects finish and the UI receives settings-changed\\n  Scenario: Stale or timed-out request\\n    Given current revision is 42\\n    When expected revision is 41\\n    Then revision_conflict returns current_revision 42 without mutation\\n    When an accepted request produces no answer within 5 seconds\\n    Then unavailable reports outcome unknown without offline fallback\\n```\\n\\n```mermaid\\nsequenceDiagram\\n  participant CLI\\n  participant IPC as Private channel\\n  participant Service as Live commit worker\\n  participant Disk as Fresh repository and lock\\n  participant Native as Native effects\\n  participant UI\\n  CLI->>IPC: operation, store identity, expected revision\\n  IPC->>Service: authenticated typed request\\n  Service->>Disk: lock and reread\\n  alt revision mismatch or invalid\\n    Service-->>CLI: error envelope; no write\\n  else changed candidate\\n    Service->>Native: prepare reversible effects\\n    Service->>Disk: atomic persist, revision plus 1\\n    Service->>Native: apply and confirm\\n    Service->>UI: settings-changed revision and keys\\n    Service-->>CLI: success envelope\\n  else no-op\\n    Service-->>CLI: current revision unchanged\\n  end\\n  alt no reply before deadline\\n    CLI->>CLI: unavailable, outcome unknown; reread before retry\\n  end\\n```\\n\\n```gherkin\\nFeature: Safe offline settings access\\n  Scenario: Read missing or salvageable store\\n    Given no Handy instance exists\\n    When the CLI reads settings\\n    Then defaults or salvage are returned without creating or rewriting the store\\n    And a warning goes only to stderr when recovery was needed\\n  Scenario: Startup competes with offline write\\n    Given a GUI startup and headless write target the same store\\n    When both acquire shared ownership and transaction guards\\n    Then the write is visible at startup or routed to the new instance\\n    And each changed transaction increments revision exactly once\\n  Scenario: Older instance present\\n    Given an older same-user Handy instance holds its legacy identity\\n    When the CLI requests a mutation\\n    Then unavailable is returned without a callback or store write\\n```\\n\\n```mermaid\\nsequenceDiagram\\n  participant CLI\\n  participant Owner as Lease and legacy probe\\n  participant Repo as Locked fresh repository\\n  participant App as Starting app\\n  CLI->>Owner: inspect private lease and legacy identity\\n  alt authenticated new instance\\n    Owner-->>CLI: route private request\\n  else old, busy, or uncertain\\n    Owner-->>CLI: unavailable; no write\\n  else proven offline\\n    CLI->>Repo: take transaction lock\\n    CLI->>Owner: recheck new lease and passive legacy state\\n    CLI->>Repo: read or validate patch\\n    alt read or dry-run\\n      Repo-->>CLI: projection or preview; no persist\\n    else changed write\\n      Repo->>Repo: durable replace with next revision\\n      Repo-->>CLI: success\\n    end\\n    App->>Repo: startup waits, then reads committed store\\n    CLI->>Owner: release transaction lock\\n  end\\n```\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:FR-005\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The reusable framework supplies file/stdin, pure validation, non-mutating preview, shared atomic commit, registration/help and export. Existing output is the only production domain; test-only fixture operations exercise deferred-domain mechanics. UTF-8 offsets, invalid/valid dry-run, atomic rejection and exact help/export channel tests are concrete Step 6 targets.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L268-L272\",\n          \"excerpt\": \"### FR-005\\n\\n**Requirement:** Provide the domain command framework (file/stdin input, dry run, atomic commit, help) used by features 001–007, 009 and 010.\\n**AC References:** AC-006\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L342-L351\",\n          \"excerpt\": \"### Step 6 — Deliver output domain and bulk framework\\n\\n**Prerequisite:** Step 5 generic routing operational in isolated tests.\\n**Required inputs:** Registered descriptor set, input reader, preview and export ports.\\n**Action:** New `settings_service/{domains/mod.rs,domains/output.rs,input.rs}` registers existing output get/set, extension aliases/help and bounded file/stdin processing. New test-only domain uses the production framework for import/export, merge/replace, dry-run and live-only fixture operations. New `src-tauri/tests/settings_domains.rs` asserts help contains exactly production domains and export channel behavior. Update README.md CLI usage and recovery/no-blind-retry instructions during implementation.\\n**FR covered:** FR-002.3: Generic list and secret denial, FR-005.2: Output and bulk framework, FR-006.4: Help export and agent recovery docs\\n**Execution evidence:** Valid/invalid UTF-8 and offset, invalid dry-run exit 2, valid preview zero mutations/effects, atomic bulk rejection, help snapshots and raw/JSON export tests.\\n**Success criteria:** Only output production domain; no premature future settings; one shared commit path, no stdin prompt, additive domain registration.\\n**Failure handling:** Domain-specific policy stays with owning feature; invalid preview cannot be accepted as success.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L48-L60\",\n          \"excerpt\": \"## Requirement Inventory and Scope\\n\\n| Requirement | Acceptance / measure | Implementation steps |\\n|---|---|---|\\n| FR-001 | AC-001; existing flags, no visible UI/tray/model, M1 reads ≤2 s | 1, 5, 7 |\\n| FR-002 | AC-002; descriptors, scalar parsing, redaction, non-creating reads | 2, 6, 7 |\\n| FR-003 | AC-003/004; SC-001/002, all writers, no-op/CAS | 2, 3, 4, 7 |\\n| FR-004 | AC-005; private IPC, 5 s, unknown outcome, older-instance refusal | 1, 3, 5, 7 |\\n| FR-005 | AC-006; framework plus existing output domain only | 2, 6, 7 |\\n| FR-006 | AC-007/008; SC-003, one envelope, channels, stable exits | 2, 5, 6, 7 |\\n\\n008 does not deliver microphone priority, replacements, new vocabulary/shortcut/prompt operations, destination/PIN, smart paste execution or automatic Enter. Existing lists are readable; generic set refuses them. Their later owners register domains and aliases (`edit`→`update`, `delete`→`remove`) without changing the framework. Only `output` appears as a production domain in the 008 build. A fixture bulk/live domain is compiled only in tests.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:FR-006\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"Typed DTO/error documentation, the whole exit table and the one renderer define the public surface. Exact-source output binding covers human mode and diagnostics alongside explicit JSON/export shapes, with process output and every-owned-code proof assigned to Step 7. UI translation preserves native English reasons. No alternative code meaning or exposed raw candidate diagnostics is introduced.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L273-L277\",\n          \"excerpt\": \"### FR-006\\n\\n**Requirement:** Produce the documented JSON envelope, human output, stderr diagnostics, stable error codes and exit codes.\\n**AC References:** AC-007, AC-008\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L302-L311\",\n          \"excerpt\": \"### Step 2 — Define descriptors, validators and DTO contracts\\n\\n**Prerequisite:** Step 1 retained primitives and automated checks pass; current UI/writer inventory captured. Pending release evidence does not block this step.\\n**Required inputs:** All AppSettings fields, UI command validators and current output enums, spec error table.\\n**Action:** Add the missing `settings_service/{mod.rs,descriptor.rs,validation.rs,protocol.rs,errors.rs}` around the retained Step 1 modules define SettingDescriptor, SettingsMutation, SettingsSnapshot, Revision, PublicSettings, OperationRequest and SettingsError. Build shared validators for every corresponding UI setting and existing domain operation; migrate invalid-to-default behavior to errors. New inline unit tests and `src-tauri/tests/settings_validation.rs` exercise real adapters against an independently maintained cases inventory. Generate `contracts/settings-cli.schema.json` from DTOs during implementation, plus `contracts/settings-cli.md` command matrix; schemas are not OpenAPI. Modify Cargo.toml for reviewed fs2, OS APIs and required Tokio features, not new model dependencies.\\n**FR covered:** FR-002.1: Complete descriptor and redaction model, FR-003.1: Shared typed validation, FR-005.1: Domain extension interface, FR-006.1: Typed errors and envelope contract\\n**Execution evidence:** Inventory diff, schema contract tests, valid/invalid/boundary cases including booleans, integers, enums, optional strings, read-only/secret/list keys.\\n**Success criteria:** Every persisted key classified; 100% settable-key UI/CLI parity including English reasons; unknown and unregistered-domain guidance deterministic; no secret serialization path.\\n**Failure handling:** Missing descriptor, divergent validation or leaked value is P0; repair before transaction integration.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L332-L341\",\n          \"excerpt\": \"### Step 5 — Wire private IPC and early CLI execution\\n\\n**Prerequisite:** Steps 1–4 PASS and old writer inventory empty.\\n**Required inputs:** Same-user/store lease and channel, absolute paths, monotonic Clock, existing cli.rs/main.rs/lib.rs routing.\\n**Action:** New `settings_service/{ipc.rs,cli.rs,render.rs}`; modify cli.rs with nested clap types, main.rs early return and lib.rs live endpoint lifetime. Authenticate accepted client and connected server kernel UID before any application bytes and validate the protocol; bounded frames, 5 s total deadline, no fallback after timeout. Implement graceful endpoint/lease lifecycle and reviewed lease-proven stale-path reclamation; never treat retained paths as permanent normal-restart refusal or delete the legacy singleton path. Implement generic operations and all parse/error JSON paths. Existing single-instance recording forwarding stays separate. Native FFI is isolated in reviewed platform modules with SAFETY comments; no unsafe domain code.\\n**FR covered:** FR-001.2: Early settings subcommand path, FR-004.3: Authenticated live and offline routing, FR-006.3: Single renderer and exit boundary\\n**Execution evidence:** Binary process tests for all old flags and both JSON positions; mocked output ports plus real local socket/pipe process tests, injected foreign-identity denial and late-answer tests; a real second-user run remains pending release evidence.\\n**Success criteria:** No Tauri/model setup on settings path; live-only requires owner; old or uncertain instance never permits fallback; outputs/exits obey exact contract.\\n**Failure handling:** Protocol, peer or liveness uncertainty returns unavailable; successful reads exceeding budget or no envelope on parser failure blocks release.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L342-L351\",\n          \"excerpt\": \"### Step 6 — Deliver output domain and bulk framework\\n\\n**Prerequisite:** Step 5 generic routing operational in isolated tests.\\n**Required inputs:** Registered descriptor set, input reader, preview and export ports.\\n**Action:** New `settings_service/{domains/mod.rs,domains/output.rs,input.rs}` registers existing output get/set, extension aliases/help and bounded file/stdin processing. New test-only domain uses the production framework for import/export, merge/replace, dry-run and live-only fixture operations. New `src-tauri/tests/settings_domains.rs` asserts help contains exactly production domains and export channel behavior. Update README.md CLI usage and recovery/no-blind-retry instructions during implementation.\\n**FR covered:** FR-002.3: Generic list and secret denial, FR-005.2: Output and bulk framework, FR-006.4: Help export and agent recovery docs\\n**Execution evidence:** Valid/invalid UTF-8 and offset, invalid dry-run exit 2, valid preview zero mutations/effects, atomic bulk rejection, help snapshots and raw/JSON export tests.\\n**Success criteria:** Only output production domain; no premature future settings; one shared commit path, no stdin prompt, additive domain registration.\\n**Failure handling:** Domain-specific policy stays with owning feature; invalid preview cannot be accepted as success.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L352-L361\",\n          \"excerpt\": \"### Step 7 — Prove macOS acceptance and track release evidence\\n\\n**Prerequisite:** Steps 1–6 complete; automated platform builds/tests run in supported environments; macOS release binary available. Native Windows/Linux, older-binary and second-account artifacts are not entry gates.\\n**Required inputs:** Independent AC/FR inventory, actual macOS binary, native harness/schema, isolated installed/portable stores and release-evidence check matrix.\\n**Action:** Add `src-tauri/tests/{settings_cli.rs,settings_routing.rs}` and `scripts/settings-native-proof.ts`; add `tests/settings-events.spec.ts` for existing frontend behavior. Run the automated commands below and mandatory macOS native checks, capture M1 read latency, no window/tray/model, real new-app IPC, live settings refresh and shortcut registration. The Bun child-process harness uses real binaries/private stores, not browser-only Tauri mocks. Exercise older-owner/foreign-peer branches with injected resources deterministically, then list the exact real Windows/Linux/older-binary/second-account checks as pending release evidence below.\\n**FR covered:** FR-001.3: Native flag and latency evidence, FR-002.4: Discovery and secret tests, FR-003.4: Parity and concurrency proof, FR-004.4: Real platform routing proof, FR-005.3: Domain acceptance proof, FR-006.5: Every owned code and exit proof\\n**Execution evidence:** macOS binary hash/OS/tool versions, stdout/stderr/exits, raw store generations, AC/FR/SC assertion matrix, native observations and every latency sample; build/test transcripts for supported code plus explicit pending release evidence rows with exact checks and no PASS.\\n**Success criteria:** Required automated P0/P1 checks have zero unexplained failures; macOS native proof is complete before Implemented; every AC/SC has a truthful coverage row distinguishing proved assertions from the pending platform/old-binary/second-user subsets. Those pending observations never block implementation steps, feature completion on the integration branch or merge into dev, and are never declared passed.\\n**Failure handling:** Missing macOS native acceptance blocks Implemented; automated failure/data/secret defects require repair. Missing Windows/Linux/old-binary/second-account native observations stay pending release evidence, with exact check and owner, rather than BLOCKED for this feature or dev merge.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:SC-001\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"Step 2 requires complete persisted-key classification and 100% settable-key accept/reject/English-reason parity against an independent cases inventory; Step 4 adds genuine UI adapter/writer closure and parity reporting. The current foundation documentation explicitly keeps actual UI writer parity unproved. The planned exhaustive measure is therefore covered without reusing pure-port execution as final certification.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L318-L321\",\n          \"excerpt\": \"### SC-001\\n\\nParity tests show identical accept/reject decisions and reasons between UI commands and CLI for 100% of settable keys.\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L302-L311\",\n          \"excerpt\": \"### Step 2 — Define descriptors, validators and DTO contracts\\n\\n**Prerequisite:** Step 1 retained primitives and automated checks pass; current UI/writer inventory captured. Pending release evidence does not block this step.\\n**Required inputs:** All AppSettings fields, UI command validators and current output enums, spec error table.\\n**Action:** Add the missing `settings_service/{mod.rs,descriptor.rs,validation.rs,protocol.rs,errors.rs}` around the retained Step 1 modules define SettingDescriptor, SettingsMutation, SettingsSnapshot, Revision, PublicSettings, OperationRequest and SettingsError. Build shared validators for every corresponding UI setting and existing domain operation; migrate invalid-to-default behavior to errors. New inline unit tests and `src-tauri/tests/settings_validation.rs` exercise real adapters against an independently maintained cases inventory. Generate `contracts/settings-cli.schema.json` from DTOs during implementation, plus `contracts/settings-cli.md` command matrix; schemas are not OpenAPI. Modify Cargo.toml for reviewed fs2, OS APIs and required Tokio features, not new model dependencies.\\n**FR covered:** FR-002.1: Complete descriptor and redaction model, FR-003.1: Shared typed validation, FR-005.1: Domain extension interface, FR-006.1: Typed errors and envelope contract\\n**Execution evidence:** Inventory diff, schema contract tests, valid/invalid/boundary cases including booleans, integers, enums, optional strings, read-only/secret/list keys.\\n**Success criteria:** Every persisted key classified; 100% settable-key UI/CLI parity including English reasons; unknown and unregistered-domain guidance deterministic; no secret serialization path.\\n**Failure handling:** Missing descriptor, divergent validation or leaked value is P0; repair before transaction integration.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L322-L331\",\n          \"excerpt\": \"### Step 4 — Migrate every app writer and live side effect\\n\\n**Prerequisite:** Isolated Step3 repository tests PASS; no running-app repository adoption or CLI mutation entry point enabled. Prepare one coordinated cutover covering every existing writer and settings-specific plugin ownership.\\n**Required inputs:** Full write_settings and store.set inventory, manager repairs, startup migrations, typed native ports.\\n**Action:** Modify settings.rs, shortcut/mod.rs, commands/{mod.rs,audio.rs,models.rs,history.rs,transcription.rs}, managers/{audio.rs,model.rs} and lib.rs. Replace every snapshot rewrite with a minimal mutation applied to latest state; adapt fallback repairs and secret UI writes. In the same coordinated all-writer cutover, activate AppHandle/service reads, writes and app startup normalization, transfer exclusive settings_store.json ownership and disable that file's plugin autosave/exit-save participation; retain other plugin stores. Never expose repository adoption alongside stale full-snapshot writers. New `settings_service/live.rs` owns ordered effects and reconciliation. Modify settingsStore.ts to consume revisions/typed errors, regenerate bindings.ts via supported specta export and add en/fr i18n keys using existing translation checks. No new screens/layout. New tests verify writer inventory closure and genuine UI adapters, compensation and post-commit failure behavior.\\n**FR covered:** FR-003.3: All writers and live adapters, FR-006.2: Stable UI errors and translations\\n**Execution evidence:** Exhaustive writer scan with no direct settings-file writer remaining, settings-specific plugin ownership/autosave/exit-save closure, actual app startup/write race and no-stale-cache-flush proof, parity report, manager mutation race tests, UI event/read ordering tests and native shortcut re-registration evidence.\\n**Success criteria:** App adopts the repository only with complete all-writer/settings-file ownership closure; startup sees complete commits with no independent stale-cache flush. Every committed app write increments once; rejected values change nothing; native updates/UI refresh complete before success; runtime-only settings stay runtime-only.\\n**Failure handling:** Any direct writer/cache autosave remaining blocks CLI enablement; main-thread waits, rollback failure or stale effect is P0.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:SC-002\",\n      \"disposition\": \"missing\",\n      \"rationale\": \"Batch-local missing test design: Step 3 specifies two subprocess repository writers and pure startup/normalization races; Step 4 adds writer closure, manager mutation races and genuine UI adapters. The submitted plan slice does not explicitly prescribe interleaved real UI and CLI writer tests with zero committed fields lost and every stale expected revision refused. It ends at Step 7; no later testing-strategy sections are supplied. This is not a full-plan absence judgment. Synthesis must ground the exact UI/CLI interleaving test from actual other-batch excerpts rather than infer it from repository-only concurrency or architecture.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L322-L325\",\n          \"excerpt\": \"### SC-002\\n\\nIn concurrency tests with interleaved UI and CLI writers, zero committed fields are lost and every stale expected revision is refused.\"\n        }\n      ],\n      \"plan_citations\": [],\n      \"searched_plan_sections\": [\n        \".specs/features/008-settings-cli/plan.md:L1-L9\",\n        \".specs/features/008-settings-cli/plan.md:L10-L11\",\n        \".specs/features/008-settings-cli/plan.md:L12-L17\",\n        \".specs/features/008-settings-cli/plan.md:L18-L35\",\n        \".specs/features/008-settings-cli/plan.md:L36-L47\",\n        \".specs/features/008-settings-cli/plan.md:L48-L60\",\n        \".specs/features/008-settings-cli/plan.md:L61-L62\",\n        \".specs/features/008-settings-cli/plan.md:L63-L68\",\n        \".specs/features/008-settings-cli/plan.md:L69-L76\",\n        \".specs/features/008-settings-cli/plan.md:L77-L82\",\n        \".specs/features/008-settings-cli/plan.md:L83-L102\",\n        \".specs/features/008-settings-cli/plan.md:L103-L123\",\n        \".specs/features/008-settings-cli/plan.md:L124-L211\",\n        \".specs/features/008-settings-cli/plan.md:L212-L249\",\n        \".specs/features/008-settings-cli/plan.md:L250-L289\",\n        \".specs/features/008-settings-cli/plan.md:L290-L291\",\n        \".specs/features/008-settings-cli/plan.md:L292-L301\",\n        \".specs/features/008-settings-cli/plan.md:L302-L311\",\n        \".specs/features/008-settings-cli/plan.md:L312-L321\",\n        \".specs/features/008-settings-cli/plan.md:L322-L331\",\n        \".specs/features/008-settings-cli/plan.md:L332-L341\",\n        \".specs/features/008-settings-cli/plan.md:L342-L351\",\n        \".specs/features/008-settings-cli/plan.md:L352-L361\"\n      ]\n    },\n    {\n      \"requirement_id\": \"008-settings-cli:SC-003\",\n      \"disposition\": \"covered\",\n      \"rationale\": \"The submitted Step 7 runs automated native/process tests with stdout/stderr/exits, records the AC/FR/SC assertion matrix and explicitly supplies every-owned-code/exit proof. The complete owned/error mapping is available, while domain-specific behavior stays with its owner. This covers the planned per-code proof requirement at the implementation-plan level; no present full acceptance certification is inferred.\",\n      \"source_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L326-L328\",\n          \"excerpt\": \"### SC-003\\n\\nEvery error code owned by this feature (`usage_error`, `validation_failed`, `revision_conflict`, `not_found`, `unavailable`, `persistence_failed`, `internal_error`) is produced by at least one automated test with its documented exit code; domain codes (`shortcut_conflict`, `limit_exceeded`) are tested by the features that own them.\"\n        }\n      ],\n      \"plan_citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L352-L361\",\n          \"excerpt\": \"### Step 7 — Prove macOS acceptance and track release evidence\\n\\n**Prerequisite:** Steps 1–6 complete; automated platform builds/tests run in supported environments; macOS release binary available. Native Windows/Linux, older-binary and second-account artifacts are not entry gates.\\n**Required inputs:** Independent AC/FR inventory, actual macOS binary, native harness/schema, isolated installed/portable stores and release-evidence check matrix.\\n**Action:** Add `src-tauri/tests/{settings_cli.rs,settings_routing.rs}` and `scripts/settings-native-proof.ts`; add `tests/settings-events.spec.ts` for existing frontend behavior. Run the automated commands below and mandatory macOS native checks, capture M1 read latency, no window/tray/model, real new-app IPC, live settings refresh and shortcut registration. The Bun child-process harness uses real binaries/private stores, not browser-only Tauri mocks. Exercise older-owner/foreign-peer branches with injected resources deterministically, then list the exact real Windows/Linux/older-binary/second-account checks as pending release evidence below.\\n**FR covered:** FR-001.3: Native flag and latency evidence, FR-002.4: Discovery and secret tests, FR-003.4: Parity and concurrency proof, FR-004.4: Real platform routing proof, FR-005.3: Domain acceptance proof, FR-006.5: Every owned code and exit proof\\n**Execution evidence:** macOS binary hash/OS/tool versions, stdout/stderr/exits, raw store generations, AC/FR/SC assertion matrix, native observations and every latency sample; build/test transcripts for supported code plus explicit pending release evidence rows with exact checks and no PASS.\\n**Success criteria:** Required automated P0/P1 checks have zero unexplained failures; macOS native proof is complete before Implemented; every AC/SC has a truthful coverage row distinguishing proved assertions from the pending platform/old-binary/second-user subsets. Those pending observations never block implementation steps, feature completion on the integration branch or merge into dev, and are never declared passed.\\n**Failure handling:** Missing macOS native acceptance blocks Implemented; automated failure/data/secret defects require repair. Missing Windows/Linux/old-binary/second-account native observations stay pending release evidence, with exact check and owner, rather than BLOCKED for this feature or dev merge.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L103-L123\",\n          \"excerpt\": \"### Descriptors, output domain and contract rendering\\n\\nDescriptor inventory covers every AppSettings field, with wire type, enum/range, mutable/read-only, secret/presence projection, owning domain, runtime effect and validator. Build a reviewed manifest plus an independent test inventory from serialized default settings and all UI adapters; a descriptor omission fails, not silently hides a setting. Existing scalar settings are generic-settable except internal fields (schema, revision, onboarding/migration markers, manager-only model state) and provider configuration, which remain read-only from CLI. API-key fields are secret and never generic-settable. Lists/maps return validation_failed naming their owning domain command, plus `not available in this build` when unregistered; include owning command even when unavailable to satisfy AC-002. Optional values have descriptor-defined null handling; non-null boolean accepts exactly true/false, numeric parses without overflow, enums use existing serde values, strings preserve bytes without trimming meaningful content.\\n\\nRedact via explicit public projection, never AppSettings Serialize or Debug. `post_process_api_keys` becomes per-provider `{present:boolean}` only; nested/future secrets inherit the rule. All stdout, stderr, parse errors, IPC diagnostics and logs sanitize raw candidate values. Public errors use stable English text and object details, with field/issues where applicable; no OS trace, raw document or credential in details. Reject `paste_method=invalid_method` identically via UI and CLI rather than existing default-to-ctrl_v behavior. UI maps code+field to i18n keys, falling back to a translated generic error, not free-text parsing.\\n\\n`output get [KEY]` and `output set KEY VALUE` delegate to the same descriptors for existing paste_method, clipboard_handling, auto_submit, auto_submit_key, paste_delay_ms, paste_delay_after_ms, reliable_paste, typing_tool, external_script_path and append_trailing_space. Existing enum values remain unchanged: ctrl_v/direct/none/shift_insert/ctrl_shift_v/external_script; dont_modify/copy_to_clipboard; enter/ctrl_enter/cmd_enter. When 007 ships, it extends the same output descriptor and validation path with paste_method=smart_paste on macOS (validation_failed outside macOS), using the existing commit_mutation service and Domain trait; 008 alone keeps the existing methods. Feature 007 owns the macOS migration/default and removal of the beta reliable_paste switch; the Windows reliable_paste switch/path and Linux methods stay unchanged. This is configuration, not insertion execution. Keep destination 006/009, insertion method and clipboard handling separate. The 007 outcome contract is: \\\"insertion attempted, read observed\\\", \\\"not read\\\", \\\"permission missing\\\", \\\"typed\\\", \\\"clipboard handed over\\\", \\\"insertion failed\\\". Only read observed and typed authorize automatic Enter in 009; not read, permission missing and insertion failed route to recovery in 010. Clipboard handed over is neither Enter nor verified insertion. Outcomes wait for the read/fallback decision and never claim text verified in a field. A committed output setting proves configuration only.\\n\\nDomain trait registers command schema/help, file/`-` input, pure parsing/validation, preview, typed patch and export formatter. Valid dry-run loads latest revision, validates fully, emits preview/revision with exit 0, and does not persist or call effects. Invalid dry-run returns validation_failed/2 with issues, no success preview. `-` explicitly requests stdin, never prompts; non-UTF-8 text returns byte offset in details. Export `-` human mode is raw exchange content only; JSON is data.content. Fixture domain proves bulk merge/replace/atomic all-or-nothing and live-only unavailable behavior; it never appears in production help.\\n\\n| Result | Exit |\\n|---|---|\\n| success | 0 |\\n| persistence_failed, internal_error | 1 |\\n| usage_error, validation_failed, shortcut_conflict, limit_exceeded | 2 |\\n| revision_conflict (`details.current_revision`) | 3 |\\n| not_found | 4 |\\n| unavailable (timeout: `details.outcome=unknown`) | 5 |\\n\\nThe enum+single renderer owns this mapping. Every JSON operation emits exactly one `{ok:true,revision:N,data:...}` or `{ok:false,error:{code,message,details:{...}}}` followed by newline; diagnostics go to stderr. No newly introduced HTTP endpoints: OpenAPI would misrepresent local IPC. Contract is the typed DTO/JSON-schema and command matrix in Step 2; no openapi.yaml generated.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L342-L351\",\n          \"excerpt\": \"### Step 6 — Deliver output domain and bulk framework\\n\\n**Prerequisite:** Step 5 generic routing operational in isolated tests.\\n**Required inputs:** Registered descriptor set, input reader, preview and export ports.\\n**Action:** New `settings_service/{domains/mod.rs,domains/output.rs,input.rs}` registers existing output get/set, extension aliases/help and bounded file/stdin processing. New test-only domain uses the production framework for import/export, merge/replace, dry-run and live-only fixture operations. New `src-tauri/tests/settings_domains.rs` asserts help contains exactly production domains and export channel behavior. Update README.md CLI usage and recovery/no-blind-retry instructions during implementation.\\n**FR covered:** FR-002.3: Generic list and secret denial, FR-005.2: Output and bulk framework, FR-006.4: Help export and agent recovery docs\\n**Execution evidence:** Valid/invalid UTF-8 and offset, invalid dry-run exit 2, valid preview zero mutations/effects, atomic bulk rejection, help snapshots and raw/JSON export tests.\\n**Success criteria:** Only output production domain; no premature future settings; one shared commit path, no stdin prompt, additive domain registration.\\n**Failure handling:** Domain-specific policy stays with owning feature; invalid preview cannot be accepted as success.\"\n        }\n      ],\n      \"searched_plan_sections\": []\n    }\n  ],\n  \"ambiguities\": [\n    {\n      \"requirement_id\": \"008-settings-cli:AC-001\",\n      \"decision_key\": \"oldest-supported-windows-release\",\n      \"question\": \"Which Windows release is the oldest supported target for the pending native console/installer/portable matrix?\",\n      \"critical\": false,\n      \"citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/logs/2026-10-13.md:L22-L31\",\n          \"excerpt\": \"The oldest supported Windows release is not specified in the examined repository documents; do not invent a support floor.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/progress.md:L45-L55\",\n          \"excerpt\": \"Resolve the oldest-supported-Windows release-policy floor before collecting native evidence\"\n        }\n      ],\n      \"resolution\": \"\",\n      \"resolution_citations\": []\n    }\n  ],\n  \"extra_scope\": [\n    {\n      \"description\": \"Test-only fixture domain and native transaction/channel integrity scaffolding, including direct already-locked dirs 6 and isolated repository development.\",\n      \"justification\": \"The specification approves fixture verification. Matching the existing Tauri native path resolver, using the stable cross-process lock, before-bytes kernel authorization and atomically switching app/writer/plugin ownership are technical necessities for the required final behavior. They add no domain business scope, model migration, compatibility daemon or temporary snapshot-provenance framework.\",\n      \"approved\": true,\n      \"citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/spec.md:L287-L297\",\n          \"excerpt\": \"008 tests the framework with a test-only fixture domain.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L18-L35\",\n          \"excerpt\": \"## Technical Context\\n\\n| Aspect | Choice | Reason / current evidence |\\n|---|---|---|\\n| Native | Rust edition 2021, Cargo, Tauri 2.11.5 | Current stack and Cargo manifest |\\n| Parsing / serialization | Existing clap 4, serde / serde_json | Typed subcommands; no second CLI executable |\\n| Async | Existing Tokio; enable required net/io/time/sync production features | Bounded IPC worker; keep native main thread free |\\n| Frontend | React 18, Zustand, i18next, TypeScript | Existing UI adapters and settings-changed listener |\\n| Persistence | Existing settings_store.json object, settings payload plus top-level settings_revision | Preserve unknown top-level/payload fields and schema migrations; no SQL table |\\n| Lock | One persistent settings.lock inode/handle per canonical store; fs2 cross-platform file locking | Same lock for UI, app mutations, startup and CLI; proposed dependency must be reviewed/pinned |\\n| Installed path resolver | Direct dirs 6, already resolved as 6.0.0 in Cargo.lock | Match current Tauri desktop app_data_dir: dirs::data_dir joined with configured identifier; no guessed HOME or new model library |\\n| Transport | Unix domain socket (macOS/Linux); Windows named pipe | Local only, explicit owner authentication; never TCP/MCP |\\n| Test levels | cargo unit/integration/process, Bun adapter tests, Playwright frontend regression, native release proof | Browser mocks cannot prove process/OS behavior |\\n| Store identity | Canonical absolute store path + user UID/SID, SHA-256 identity | Installed and portable paths resolve identically without AppHandle |\\n| Infrastructure | Local user directory, lock and endpoint only | No cloud resource, credentials or provisioning |\\n\\nInspect [existing parser](../../../src-tauri/src/cli.rs), [entry point](../../../src-tauri/src/main.rs), [startup](../../../src-tauri/src/lib.rs), [settings](../../../src-tauri/src/settings.rs), [portable paths](../../../src-tauri/src/portable.rs), [UI store](../../../src/stores/settingsStore.ts) and [Cargo manifest](../../../src-tauri/Cargo.toml) for implementation context. These source inspections do not replace acceptance requirements.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L312-L321\",\n          \"excerpt\": \"### Step 3 — Build atomic repository, revision and locking\\n\\n**Prerequisite:** Step 2 validators and mutation types stable; repository work is isolated/pure, with no running-app adoption before the coordinated Step4 cutover.\\n**Required inputs:** Pure StoreLocator, raw store shape, extracted normalization/migrations/salvage helpers, stable lock, new-instance lease and passive legacy probe; current Tauri desktop path resolver and already-locked dirs 6.\\n**Action:** New `settings_service/{store.rs,transaction.rs}` implement isolated non-creating `read_snapshot`, lock/reload/patch `commit_mutation`, pure startup normalization transaction logic, no-op/CAS/overflow and durable replacement. Expose side-effect-free locator/normalization helpers from portable/settings logic, using direct dirs 6 (already locked) to match Tauri native path resolution. Keep existing AppHandle reads/writes/startup and settings-file plugin ownership unchanged; no production CLI mutation reachability. Do not add a temporary full-snapshot-to-patch adapter or global provenance/cache machinery. New `src-tauri/tests/settings_transactions.rs` uses private stores, barriers, two subprocess repository writers and crash/fault injection.\\n**FR covered:** FR-002.2: Non-mutating fresh reads, FR-003.2: Durable revision and atomic patch, FR-004.2: Startup ownership fence\\n**Execution evidence:** Isolated repository before/after hashes, revision sequences, independent raw-file reader, crash old-or-new snapshots, lock identity tests across rename and pure normalization/startup-transaction races. Running-app startup/cache/no-stale-plugin-flush proof belongs to the Step4 all-writer cutover.\\n**Success criteria:** Isolated repository mutations lose no fields; stale CAS refused, no-op/read invariant, secrets/unknown fields preserved and pure startup normalization observes complete generations. No claim that the running app has adopted this repository or that its old cache/writers are already removed.\\n**Failure handling:** Persistence failure leaves old durable generation; uncertain durable outcome is explicit, never blanket retry; invalid revision continuity blocks writes. Any attempted running-app/service adoption before all-writer closure is blocked until Step4, rather than repaired with an ambiguous snapshot adapter.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L322-L331\",\n          \"excerpt\": \"### Step 4 — Migrate every app writer and live side effect\\n\\n**Prerequisite:** Isolated Step3 repository tests PASS; no running-app repository adoption or CLI mutation entry point enabled. Prepare one coordinated cutover covering every existing writer and settings-specific plugin ownership.\\n**Required inputs:** Full write_settings and store.set inventory, manager repairs, startup migrations, typed native ports.\\n**Action:** Modify settings.rs, shortcut/mod.rs, commands/{mod.rs,audio.rs,models.rs,history.rs,transcription.rs}, managers/{audio.rs,model.rs} and lib.rs. Replace every snapshot rewrite with a minimal mutation applied to latest state; adapt fallback repairs and secret UI writes. In the same coordinated all-writer cutover, activate AppHandle/service reads, writes and app startup normalization, transfer exclusive settings_store.json ownership and disable that file's plugin autosave/exit-save participation; retain other plugin stores. Never expose repository adoption alongside stale full-snapshot writers. New `settings_service/live.rs` owns ordered effects and reconciliation. Modify settingsStore.ts to consume revisions/typed errors, regenerate bindings.ts via supported specta export and add en/fr i18n keys using existing translation checks. No new screens/layout. New tests verify writer inventory closure and genuine UI adapters, compensation and post-commit failure behavior.\\n**FR covered:** FR-003.3: All writers and live adapters, FR-006.2: Stable UI errors and translations\\n**Execution evidence:** Exhaustive writer scan with no direct settings-file writer remaining, settings-specific plugin ownership/autosave/exit-save closure, actual app startup/write race and no-stale-cache-flush proof, parity report, manager mutation race tests, UI event/read ordering tests and native shortcut re-registration evidence.\\n**Success criteria:** App adopts the repository only with complete all-writer/settings-file ownership closure; startup sees complete commits with no independent stale-cache flush. Every committed app write increments once; rejected values change nothing; native updates/UI refresh complete before success; runtime-only settings stay runtime-only.\\n**Failure handling:** Any direct writer/cache autosave remaining blocks CLI enablement; main-thread waits, rollback failure or stale effect is P0.\"\n        }\n      ]\n    }\n  ],\n  \"findings\": [\n    {\n      \"category\": \"legacy_cross_session_absence\",\n      \"severity\": \"warning\",\n      \"description\": \"Linux session DBus and Windows desktop/session singleton probes cannot establish same-user/store legacy absence across all sessions. The plan requires unknown-scope refusal, but complete cross-session absence/offline availability is not proved by this batch review.\",\n      \"suggestion\": \"Keep session-local negative evidence separate from proven absence and deterministically test uncertainty/no-write. Real other-session/older-binary checks remain pending release evidence; do not reintroduce replay or block steps solely on unavailable native observations.\",\n      \"citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/logs/2026-10-13.md:L22-L31\",\n          \"excerpt\": \"Possible design gap requiring proof/resolution: Linux session bus and Windows session/desktop namespace absence do not establish absence of another session of the same user/store.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L83-L102\",\n          \"excerpt\": \"Errors/unknown scope refuse mutation\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/progress.md:L45-L55\",\n          \"excerpt\": \"Pending release evidence; injected checks remain required; no PASS\"\n        }\n      ]\n    },\n    {\n      \"category\": \"repository_adoption_ordering\",\n      \"severity\": \"info\",\n      \"description\": \"The source-backed full-snapshot intent hazard is addressed in this plan slice: isolated Step 3 repository development no longer adopts the service or removes plugin ownership, and Step 4 performs one all-writer/app/startup/settings-file ownership cutover. This is a sound sequencing disposition, not observed runtime lost-update repair or acceptance proof.\",\n      \"suggestion\": \"Enforce the Step 3 no-adoption boundary and verify actual writer/plugin ownership closure, startup races and no stale cache flush during Step 4 before enabling CLI writes.\",\n      \"citations\": [\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L312-L321\",\n          \"excerpt\": \"Keep existing AppHandle reads/writes/startup and settings-file plugin ownership unchanged; no production CLI mutation reachability. Do not add a temporary full-snapshot-to-patch adapter or global provenance/cache machinery.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/plan.md:L322-L331\",\n          \"excerpt\": \"In the same coordinated all-writer cutover, activate AppHandle/service reads, writes and app startup normalization, transfer exclusive settings_store.json ownership and disable that file's plugin autosave/exit-save participation; retain other plugin stores. Never expose repository adoption alongside stale full-snapshot writers.\"\n        },\n        {\n          \"section_id\": \".specs/features/008-settings-cli/logs/2026-10-13.md:L295-L311\",\n          \"excerpt\": \"A serialized/reloaded adapter cannot infer whether stale microphoneM0 after concurrentM1 is intentional.\"\n        }\n      ]\n    }\n  ],\n  \"confidence\": 4,\n  \"synthesized_batch_ids\": [],\n  \"resolutions\": []\n}\n",
+    "{\"batch_id\":\"batch-002\",\"reviewed_section_ids\":[\".specs/constitution.md:L1-L2\",\".specs/constitution.md:L3-L17\",\".specs/constitution.md:L18-L26\",\".specs/constitution.md:L27-L30\",\".specs/constitution.md:L31-L36\",\".specs/project.md:L1-L2\",\".specs/project.md:L3-L7\",\".specs/project.md:L8-L16\",\".specs/project.md:L17-L20\",\".specs/project.md:L21-L24\",\".specs/project.md:L25-L28\",\".specs/project.md:L29-L36\",\".specs/stacks/_default.md:L1-L5\",\".specs/stacks/_default.md:L6-L7\",\".specs/stacks/_default.md:L8-L21\",\".specs/stacks/_default.md:L22-L31\",\".specs/README.md:L1-L8\",\".specs/README.md:L9-L22\",\".specs/README.md:L23-L31\",\".specs/README.md:L32-L51\",\".specs/README.md:L52-L63\",\".specs/README.md:L64-L163\",\".specs/changelog.md:L1-L7\",\".specs/changelog.md:L8-L11\",\".specs/changelog.md:L12-L15\",\".specs/changelog.md:L16-L19\",\".specs/changelog.md:L20-L28\",\".specs/changelog.md:L29-L37\",\".specs/changelog.md:L38-L46\",\".specs/changelog.md:L47-L57\",\".specs/changelog.md:L58-L61\",\".specs/changelog.md:L62-L65\",\".specs/changelog.md:L66-L69\",\".specs/changelog.md:L70-L72\",\".specs/changelog.md:L73-L75\",\".specs/changelog.md:L76-L78\",\".specs/changelog.md:L79-L81\",\".specs/changelog.md:L82-L84\",\".specs/changelog.md:L85-L87\",\".specs/changelog.md:L88-L90\",\".specs/changelog.md:L91-L93\",\".specs/changelog.md:L94-L96\",\".specs/changelog.md:L97-L99\",\".specs/changelog.md:L100-L102\",\".specs/changelog.md:L103-L105\",\".specs/changelog.md:L106-L108\",\".specs/changelog.md:L109-L111\",\".specs/changelog.md:L112-L114\",\".specs/changelog.md:L115-L117\",\".specs/changelog.md:L118-L120\",\".specs/changelog.md:L121-L123\",\".specs/changelog.md:L124-L126\",\".specs/changelog.md:L127-L129\",\".specs/changelog.md:L130-L132\",\".specs/changelog.md:L133-L135\",\".specs/changelog.md:L136-L138\",\".specs/changelog.md:L139-L141\",\".specs/changelog.md:L142-L144\",\".specs/changelog.md:L145-L147\",\".specs/changelog.md:L148-L150\",\".specs/changelog.md:L151-L153\",\".specs/changelog.md:L154-L156\",\".specs/changelog.md:L157-L159\",\".specs/changelog.md:L160-L162\",\".specs/changelog.md:L163-L165\",\".specs/changelog.md:L166-L168\",\".specs/changelog.md:L169-L171\",\".specs/changelog.md:L172-L174\",\".specs/changelog.md:L175-L177\",\".specs/changelog.md:L178-L180\",\".specs/changelog.md:L181-L183\",\".specs/changelog.md:L184-L186\",\".specs/changelog.md:L187-L193\",\".specs/changelog.md:L194-L200\",\".specs/changelog.md:L201-L206\",\".specs/features/008-settings-cli/contracts/settings-cli.md:L1-L31\",\".specs/features/008-settings-cli/implementation.md:L1-L4\",\".specs/features/008-settings-cli/implementation.md:L5-L15\",\".specs/features/008-settings-cli/implementation.md:L16-L30\",\".specs/features/008-settings-cli/implementation.md:L31-L38\",\".specs/features/008-settings-cli/implementation.md:L39-L46\",\".specs/features/008-settings-cli/implementation.md:L47-L50\",\".specs/features/008-settings-cli/implementation.md:L51-L54\",\".specs/features/008-settings-cli/implementation.md:L55-L57\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L1-L4\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L5-L10\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L11-L21\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L22-L31\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L32-L37\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L38-L55\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L56-L69\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L70-L76\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L77-L97\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L98-L101\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L102-L119\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L120-L123\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L124-L132\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L133-L143\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L144-L147\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L148-L167\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L168-L183\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L184-L201\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L202-L217\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L218-L233\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L234-L245\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L246-L262\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L263-L266\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L267-L282\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L283-L290\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L291-L294\",\".specs/features/008-settings-cli/logs/2026-10-13.md:L295-L311\",\".specs/features/008-settings-cli/progress.md:L1-L16\",\".specs/features/008-settings-cli/progress.md:L17-L22\",\".specs/features/008-settings-cli/progress.md:L23-L33\",\".specs/features/008-settings-cli/progress.md:L34-L44\",\".specs/features/008-settings-cli/progress.md:L45-L55\",\".specs/features/008-settings-cli/progress.md:L56-L74\",\".specs/features/008-settings-cli/progress.md:L75-L83\",\".specs/features/008-settings-cli/progress.md:L84-L87\",\".specs/features/008-settings-cli/progress.md:L88-L107\",\".specs/features/008-settings-cli/progress.md:L108-L113\",\".specs/features/008-settings-cli/progress.md:L114-L134\",\".specs/features/008-settings-cli/progress.md:L135-L151\",\".specs/features/008-settings-cli/progress.md:L152-L168\",\".specs/features/008-settings-cli/spec.md:L1-L9\",\".specs/features/008-settings-cli/spec.md:L10-L11\",\".specs/features/008-settings-cli/spec.md:L12-L20\",\".specs/features/008-settings-cli/spec.md:L21-L22\",\".specs/features/008-settings-cli/spec.md:L23-L58\",\".specs/features/008-settings-cli/spec.md:L59-L93\",\".specs/features/008-settings-cli/spec.md:L94-L129\",\".specs/features/008-settings-cli/spec.md:L130-L170\",\".specs/features/008-settings-cli/spec.md:L171-L203\",\".specs/features/008-settings-cli/spec.md:L204-L205\",\".specs/features/008-settings-cli/spec.md:L206-L210\",\".specs/features/008-settings-cli/spec.md:L211-L215\",\".specs/features/008-settings-cli/spec.md:L216-L220\",\".specs/features/008-settings-cli/spec.md:L221-L225\",\".specs/features/008-settings-cli/spec.md:L226-L230\",\".specs/features/008-settings-cli/spec.md:L231-L235\",\".specs/features/008-settings-cli/spec.md:L236-L240\",\".specs/features/008-settings-cli/spec.md:L241-L245\",\".specs/features/008-settings-cli/spec.md:L246-L247\",\".specs/features/008-settings-cli/spec.md:L248-L252\",\".specs/features/008-settings-cli/spec.md:L253-L257\",\".specs/features/008-settings-cli/spec.md:L258-L262\",\".specs/features/008-settings-cli/spec.md:L263-L267\",\".specs/features/008-settings-cli/spec.md:L268-L272\",\".specs/features/008-settings-cli/spec.md:L273-L277\",\".specs/features/008-settings-cli/spec.md:L278-L286\",\".specs/features/008-settings-cli/spec.md:L287-L297\",\".specs/features/008-settings-cli/spec.md:L298-L307\",\".specs/features/008-settings-cli/spec.md:L308-L315\",\".specs/features/008-settings-cli/spec.md:L316-L317\",\".specs/features/008-settings-cli/spec.md:L318-L321\",\".specs/features/008-settings-cli/spec.md:L322-L325\",\".specs/features/008-settings-cli/spec.md:L326-L328\",\".specs/testing/strategy.md:L1-L2\",\".specs/testing/strategy.md:L3-L6\",\".specs/testing/strategy.md:L7-L12\",\".specs/testing/strategy.md:L13-L16\",\".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L1-L9\",\".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L10-L15\",\".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L16-L21\",\".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L22-L26\",\".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L27-L30\",\".specs/tool-defects/2026-10-13-cargo-runner-lacks-native-execution-certification.md:L31-L33\",\".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L1-L9\",\".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L10-L15\",\".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L16-L21\",\".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L22-L26\",\".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L27-L30\",\".specs/tool-defects/2026-10-13-native-cargo-execution-capture-crosses-generated-rule-symlin.md:L31-L33\",\".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L1-L9\",\".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L10-L15\",\".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L16-L21\",\".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L22-L25\",\".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L26-L37\",\".specs/tool-defects/2026-10-13-step-execution-proof-requires-whole-acceptance-criterion-bef.md:L38-L44\",\".specs/features/008-settings-cli/plan.md:L362-L385\",\".specs/features/008-settings-cli/plan.md:L386-L402\",\".specs/features/008-settings-cli/plan.md:L403-L416\",\".specs/features/008-settings-cli/plan.md:L417-L431\",\".specs/features/008-settings-cli/plan.md:L432-L459\",\".specs/features/008-settings-cli/plan.md:L460-L462\"],\"conclusions\":[{\"requirement_id\":\"008-settings-cli:AC-001\",\"disposition\":\"covered\",\"rationale\":\"The slice plans the same console-subsystem executable, preserved settings/headless output, old-only flag regression, both JSON placements and no activation/window/tray/model. Thirty fresh M1 release reads offline and live must each succeed within 2000 ms. Windows shell observations remain pending release evidence; planned coverage is not runtime certification.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L206-L210\",\"excerpt\":\"**Criterion:** `handy settings` is a subcommand group of the existing `handy` executable. Existing flags (`--toggle-transcription`, `--toggle-post-process`, `--cancel`, `--start-hidden`, `--no-tray`, `--debug`, `--transcribe-file`, `--model`, `--device-index`, `--list-devices`, `--list-models`, `--repeat`, `--json`) keep their behavior; `--json` after `settings` belongs to the subcommand. It works on macOS, Windows and Linux; on Windows, output appears in the console the command was started from. A `handy settings` invocation never shows a window, a tray icon or loads a model, never triggers the single-instance \\\"show window\\\" behavior, and completes reads within 2 seconds on an Apple M1 Mac in a release build.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Console-subsystem same exe, preserve settings/headless handles, GUI FreeConsole; compilation/PE gate; cmd/PowerShell/GUI native checks pending release evidence\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"All seven owned error codes with actual stdout/stderr/exit, malformed argv, two JSON placements, redaction sentinels in every branch including panic/error diagnostics; `settings_cli.rs`\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Old flags inventory, no window/tray/model/single-instance show, Windows cmd/PowerShell interactive and pipe/redirection exits, installed/portable launch\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"M1 release wall time including process startup, 30 fresh process reads offline/live; retain every sample and require every successful read ≤2000 ms; deadline failures separately identified\"}]},{\"requirement_id\":\"008-settings-cli:AC-002\",\"disposition\":\"covered\",\"rationale\":\"The supplied normative foundation contract defines generic get/keys/scalar set, presence-only secrets, descriptor grammar and list/readonly/secret refusals. The plan binds completeness/types/refusal and real-process JSON/redaction tests and in-memory-only read normalization. Those planned checks cover the contract; the current foundation does not claim executable CLI delivery.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L211-L215\",\"excerpt\":\"**Criterion:** `handy settings get [KEY]` returns all non-secret settings or one key; `handy settings keys` lists settable keys with type, allowed values or range and read-only flag; `handy settings set KEY VALUE` changes one scalar setting. Secret values (API keys) are never printed; reads report only their presence. Unknown keys return `not_found`. `set` parses VALUE with the key's descriptor type (boolean `true`/`false`, integer, enumeration value, string). Generic `set` on a list key returns `validation_failed` naming the domain command to use; on a secret or read-only key it returns `validation_failed` stating that the key is changed in the settings UI. A top-level `--json` before `settings` is accepted as equivalent to `--json` after it. A headless read never creates the settings store.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Descriptor completeness, types, ranges, null, list/read-only/secret refusals, all UI command validation reasons; `settings_validation.rs` and inline validator tests\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"All seven owned error codes with actual stdout/stderr/exit, malformed argv, two JSON placements, redaction sentinels in every branch including panic/error diagnostics; `settings_cli.rs`\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"In-memory read normalization only; preserve revision, refuse unrecoverable continuity on mutation\"}]},{\"requirement_id\":\"008-settings-cli:AC-003\",\"disposition\":\"covered\",\"rationale\":\"Former UI coercions explicitly become consistent rejection with CLI, while persisted salvage remains a separate read/startup path. All actual UI validation reasons and genuine adapter parity are tested with English backend messages and translated UI mapping; pure foundation tests are not misrepresented as completed UI parity.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L216-L220\",\"excerpt\":\"**Criterion:** Every write goes through the same backend validation functions as the corresponding UI command, so a value the UI rejects is rejected by the CLI with the same error code and English message, and vice versa; the UI may show that message translated. UI commands that today replace an invalid value by a default (for example an unknown paste method) reject it instead. A rejected write changes nothing.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Descriptor completeness, types, ranges, null, list/read-only/secret refusals, all UI command validation reasons; `settings_validation.rs` and inline validator tests\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L417-L431\",\"excerpt\":\"Full key inventory, genuine adapter parity and each owned code/exit; spec-test\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Formerly coerced UI values reject consistently with CLI; legacy persisted salvage/migration stays a separate in-memory read/startup-commit path\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Stable code+field translation keys; English backend parity, translated generic fallback\"}]},{\"requirement_id\":\"008-settings-cli:AC-004\",\"disposition\":\"missing\",\"rationale\":\"Batch-002 plans transaction/CAS/no-op/crash tests and gates CLI on all-writer/plugin-cache closure, but its L362–L462 plan slice does not define stable single-lock acquisition and fresh disk reread by every writer, the increment/no-op algorithm, or an under-lock mismatch response with error.details.current_revision. Resolve those batch-local implementation absences from the other batch; no complete-plan omission is inferred.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L221-L225\",\"excerpt\":\"**Criterion:** Settings carry a persisted revision number returned by every read and incremented by 1 on every committed write from any surface, including writes made by Handy itself; a write that changes nothing and a read do not increment it. Writes accept `--expected-revision N`; a mismatch returns `revision_conflict` with the current revision in `error.details.current_revision` and writes nothing. All writers (UI commands, a running instance and a headless CLI process) are serialized by one cross-process settings lock, and each writer re-reads the stored settings under that lock before applying its change, so a write without expected revision applies to the latest settings and never discards fields changed by another writer.\"}],\"plan_citations\":[],\"searched_plan_sections\":[\".specs/features/008-settings-cli/plan.md:L362-L385\",\".specs/features/008-settings-cli/plan.md:L386-L402\",\".specs/features/008-settings-cli/plan.md:L403-L416\",\".specs/features/008-settings-cli/plan.md:L417-L431\",\".specs/features/008-settings-cli/plan.md:L432-L459\",\".specs/features/008-settings-cli/plan.md:L460-L462\"]},{\"requirement_id\":\"008-settings-cli:AC-005\",\"disposition\":\"missing\",\"rationale\":\"Concrete live/no-instance/older/startup/busy/stale/foreign-peer tests, five-second unknown/reread risk handling, passive old-owner refusal and native UI/shortcut proof are planned. The supplied slice does not define live-only operation rejection offline or the shared validated offline-versus-live adapter dispatch. Earlier architecture sections may resolve these details; primitive/foundation PASS certifies no complete AC.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L226-L230\",\"excerpt\":\"**Criterion:** When a Handy instance of the same user and settings store is running, the CLI sends the operation to it over a local channel accessible only to that user and waits up to 5 seconds for its answer; the instance applies it with its live state, re-registers affected shortcuts and notifies its UI. If no answer arrives in time, the CLI returns `unavailable` with `error.details.outcome` set to `unknown`, and agents must read again before retrying. If a running Handy without this channel (an older version) is detected, the CLI returns `unavailable` and never writes the store itself. When none is running, the CLI applies the operation to the settings store itself under the same lock and validation. Operations that need live state (for example the current destination) return `unavailable` without a running instance. No network listener and no MCP server are introduced.\"}],\"plan_citations\":[],\"searched_plan_sections\":[\".specs/features/008-settings-cli/plan.md:L362-L385\",\".specs/features/008-settings-cli/plan.md:L386-L402\",\".specs/features/008-settings-cli/plan.md:L403-L416\",\".specs/features/008-settings-cli/plan.md:L417-L431\",\".specs/features/008-settings-cli/plan.md:L432-L459\",\".specs/features/008-settings-cli/plan.md:L460-L462\"]},{\"requirement_id\":\"008-settings-cli:AC-006\",\"disposition\":\"missing\",\"rationale\":\"Bulk fixture/file/stdin/dry-run/all-or-nothing/export/exact-help tests and unavailable later-owner scope are supplied. Production output operations for existing paste method, clipboard handling and auto-submit, and the concrete registered-domain parser/help implementation are outside this slice. The foundation contract leaves orchestration to Step6, whose plan section is in the other batch.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L231-L235\",\"excerpt\":\"**Criterion:** This feature delivers the shared domain framework (argument parsing, file or `-` (stdin) input, `--dry-run` preview for bulk changes, atomic commit, help text per command) and the output domain for the existing output settings (paste method, clipboard handling, existing auto-submit). The domains microphones, replacements, vocabulary, shortcuts, prompts, destination and the new output settings (smart paste method, automatic Enter) are added on this framework by the features that own them (001–007, 009, 010). `handy settings --help` lists exactly the domains present in the build.\"}],\"plan_citations\":[],\"searched_plan_sections\":[\".specs/features/008-settings-cli/plan.md:L362-L385\",\".specs/features/008-settings-cli/plan.md:L386-L402\",\".specs/features/008-settings-cli/plan.md:L403-L416\",\".specs/features/008-settings-cli/plan.md:L417-L431\",\".specs/features/008-settings-cli/plan.md:L432-L459\",\".specs/features/008-settings-cli/plan.md:L460-L462\"]},{\"requirement_id\":\"008-settings-cli:AC-007\",\"disposition\":\"missing\",\"rationale\":\"The normative foundation defines exact envelope DTOs and always-object details, and the slice plans actual output/exit/redaction/export tests. It does not state default human stdout versus stderr diagnostics or raw export-to-dash versus JSON data.content rendering. The earlier renderer plan section must resolve those batch-local details.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L236-L240\",\"excerpt\":\"**Criterion:** With `--json`, stdout contains exactly one JSON envelope: success `{\\\"ok\\\": true, \\\"revision\\\": N, \\\"data\\\": …}`, failure `{\\\"ok\\\": false, \\\"error\\\": {\\\"code\\\": C, \\\"message\\\": M, \\\"details\\\": {…}}}` where `details` is always an object (for example `current_revision`, `outcome`, `field`, `issues` as a list of `{field, reason}`). Without `--json`, stdout shows readable text. Diagnostics, warnings and progress go to stderr in both modes. Export operations writing to `-` print only the exported content without `--json`, and put it in `data.content` of the envelope with `--json`.\"}],\"plan_citations\":[],\"searched_plan_sections\":[\".specs/features/008-settings-cli/plan.md:L362-L385\",\".specs/features/008-settings-cli/plan.md:L386-L402\",\".specs/features/008-settings-cli/plan.md:L403-L416\",\".specs/features/008-settings-cli/plan.md:L417-L431\",\".specs/features/008-settings-cli/plan.md:L432-L459\",\".specs/features/008-settings-cli/plan.md:L460-L462\"]},{\"requirement_id\":\"008-settings-cli:AC-008\",\"disposition\":\"covered\",\"rationale\":\"The supplied foundation wire contract preserves all required category/exit mappings, including extension codes. The plan requires all seven owned codes with actual process output/exits, and QE retains future-domain codes with their owning features. DTO definitions do not claim extension runtime PASS.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L241-L245\",\"excerpt\":\"**Criterion:** Error codes and exit codes are stable and documented: `usage_error` and `validation_failed`, `shortcut_conflict`, `limit_exceeded` → 2; `revision_conflict` → 3; `not_found` → 4; `unavailable` → 5; `persistence_failed` and `internal_error` → 1; success → 0. New codes may be added; existing ones never change meaning.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"All seven owned error codes with actual stdout/stderr/exit, malformed argv, two JSON placements, redaction sentinels in every branch including panic/error diagnostics; `settings_cli.rs`\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L417-L431\",\"excerpt\":\"Future domain codes owned by their features, not falsely counted covered here\"}]},{\"requirement_id\":\"008-settings-cli:FR-001\",\"disposition\":\"covered\",\"rationale\":\"The same executable preserves settings/headless console handles and detaches GUI appropriately. Concrete old-only regression and no-GUI/model/settings activation checks establish the functional headless group; detailed early entry wiring is in the other plan slice.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L248-L252\",\"excerpt\":\"**Requirement:** Add a `settings` subcommand group to the existing executable that runs without GUI side effects and keeps existing flags unchanged.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Console-subsystem same exe, preserve settings/headless handles, GUI FreeConsole; compilation/PE gate; cmd/PowerShell/GUI native checks pending release evidence\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Old flags inventory, no window/tray/model/single-instance show, Windows cmd/PowerShell interactive and pipe/redirection exits, installed/portable launch\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"usage_error/2 except debug/json; regression matrix for old-only invocations\"}]},{\"requirement_id\":\"008-settings-cli:FR-002\",\"disposition\":\"covered\",\"rationale\":\"The normative command matrix defines generic operations over the redacted projection, while planned descriptor completeness/refusals and secret-sentinel checks exercise actual output/error branches. This covers generic behavior without claiming the existing foundation is a delivered executable CLI.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L253-L257\",\"excerpt\":\"**Requirement:** Provide generic get, keys and set operations over non-secret settings with redaction of secrets.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Descriptor completeness, types, ranges, null, list/read-only/secret refusals, all UI command validation reasons; `settings_validation.rs` and inline validator tests\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"All seven owned error codes with actual stdout/stderr/exit, malformed argv, two JSON placements, redaction sentinels in every branch including panic/error diagnostics; `settings_cli.rs`\"}]},{\"requirement_id\":\"008-settings-cli:FR-003\",\"disposition\":\"missing\",\"rationale\":\"Actual parity and concurrency/CAS tests and all-writer/cache closure are planned, but shared validation/commit service interfaces, the one cross-process lock and persisted revision/CAS implementation are not specified in this slice. The coherent Step3/4 correction in current progress is context, not a substitute for absent canonical architecture/step excerpts. Resolve from the other batch.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L258-L262\",\"excerpt\":\"**Requirement:** Expose one shared validation and commit service used by UI commands and CLI, with a persisted revision, optional expected-revision check and a single write lock.\"}],\"plan_citations\":[],\"searched_plan_sections\":[\".specs/features/008-settings-cli/plan.md:L362-L385\",\".specs/features/008-settings-cli/plan.md:L386-L402\",\".specs/features/008-settings-cli/plan.md:L403-L416\",\".specs/features/008-settings-cli/plan.md:L417-L431\",\".specs/features/008-settings-cli/plan.md:L432-L459\",\".specs/features/008-settings-cli/plan.md:L460-L462\"]},{\"requirement_id\":\"008-settings-cli:FR-004\",\"disposition\":\"covered\",\"rationale\":\"Real IPC/process tests cover live/offline/older/startup and ambiguous owners, foreign-peer denial and unchanged-store refusal. Risks preserve the five-second timeout and unknown/reread/no-fallback behavior. This establishes broader routing intent; the detailed live-only offline rule remains batch-local missing under AC-005.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L263-L267\",\"excerpt\":\"**Requirement:** Route CLI operations to a running instance over a user-only local channel with a 5-second timeout, or apply them headlessly when no instance runs.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Live/no instance/older/startup/busy/stale/different-user/store; permissions, protocol/frame errors, deadline and late replies, persisted-but-no-answer reread, passive detected-old refusal with unchanged store, new-app startup race, injected foreign-peer denial and no compatibility listener; `settings_routing.rs`, `settings_platform.rs`\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Every successful M1 release read ≤2 s; hung/deadline failure measured separately, never success; no invented Windows/Linux budget\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Test deadline before/after commit, lost response and late reply; outcome unknown, reread, no fallback/replay\"}]},{\"requirement_id\":\"008-settings-cli:FR-005\",\"disposition\":\"covered\",\"rationale\":\"Specific framework boundary tests cover file/stdin UTF-8, valid/invalid/dry-run, all-or-nothing commit, export and exact domain help. Risks demand full validation and zero preview effects, and absent later owners stay outside registered help. This establishes the shared framework without expanding production 008 into later domains.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L268-L272\",\"excerpt\":\"**Requirement:** Provide the domain command framework (file/stdin input, dry run, atomic commit, help) used by features 001–007, 009 and 010.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Bulk fixture valid/invalid/dry-run, file/stdin UTF-8, all-or-nothing, export and exact domain help; `settings_domains.rs`\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Full validation; invalid → validation_failed/2, valid → preview/0 with zero effects\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Error names owning domain plus unavailable-in-this-build; help lists only registered domains\"}]},{\"requirement_id\":\"008-settings-cli:FR-006\",\"disposition\":\"missing\",\"rationale\":\"Envelope/error DTOs and real-output/exit tests are supplied, but complete human/JSON/stdout/stderr/export renderer policies are not stated in any supplied plan section. Stable exit mapping alone cannot establish the full output contract; the other renderer slice should resolve this batch-local absence.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L273-L277\",\"excerpt\":\"**Requirement:** Produce the documented JSON envelope, human output, stderr diagnostics, stable error codes and exit codes.\"}],\"plan_citations\":[],\"searched_plan_sections\":[\".specs/features/008-settings-cli/plan.md:L362-L385\",\".specs/features/008-settings-cli/plan.md:L386-L402\",\".specs/features/008-settings-cli/plan.md:L403-L416\",\".specs/features/008-settings-cli/plan.md:L417-L431\",\".specs/features/008-settings-cli/plan.md:L432-L459\",\".specs/features/008-settings-cli/plan.md:L460-L462\"]},{\"requirement_id\":\"008-settings-cli:SC-001\",\"disposition\":\"covered\",\"rationale\":\"Descriptor completeness and all actual UI validation reasons are required with full-key inventory and genuine adapter parity. Explicit separation of pure-port tests from corresponding UI-adapter parity preserves the 100% criterion as future complete evidence, rather than falsely counting current foundation tests.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L318-L321\",\"excerpt\":\"Parity tests show identical accept/reject decisions and reasons between UI commands and CLI for 100% of settable keys.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Descriptor completeness, types, ranges, null, list/read-only/secret refusals, all UI command validation reasons; `settings_validation.rs` and inline validator tests\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L417-L431\",\"excerpt\":\"Full key inventory, genuine adapter parity and each owned code/exit; spec-test\"}]},{\"requirement_id\":\"008-settings-cli:SC-002\",\"disposition\":\"covered\",\"rationale\":\"Actual UI adapter and two CLI writers are interleaved by barriers across different/same keys and stale CAS. QE blocks delivery/CLI on any lost field or direct writer, with raw generations and no snapshot bypass. This is concrete zero-loss/stale-refusal evidence planning compatible with atomic all-writer adoption.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L322-L325\",\"excerpt\":\"In concurrency tests with interleaved UI and CLI writers, zero committed fields are lost and every stale expected revision is refused.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Two CLI writers and UI adapter writer with barriers; different/same keys, stale CAS, no-op, startup migration, secret writes, invalid revision, rename lock, crash/flush faults; `settings_transactions.rs`\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L417-L431\",\"excerpt\":\"Partial primitive diagnostics only; any direct writer or lost field blocks CLI enablement/delivery\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Exhaustive startup/internal/UI writer scan in Steps 2–4; real no-op and migration tests; no snapshot overwrite bypass\"}]},{\"requirement_id\":\"008-settings-cli:SC-003\",\"disposition\":\"covered\",\"rationale\":\"The contract process row explicitly requires all seven feature-owned error codes with actual stdout/stderr/exits, supported by the supplied normative exit matrix. Future shortcut/limit codes stay owner-feature obligations. This is planned coverage, not a claim of current runtime certification.\",\"source_citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L326-L328\",\"excerpt\":\"Every error code owned by this feature (`usage_error`, `validation_failed`, `revision_conflict`, `not_found`, `unavailable`, `persistence_failed`, `internal_error`) is produced by at least one automated test with its documented exit code; domain codes (`shortcut_conflict`, `limit_exceeded`) are tested by the features that own them.\"}],\"plan_citations\":[{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"All seven owned error codes with actual stdout/stderr/exit, malformed argv, two JSON placements, redaction sentinels in every branch including panic/error diagnostics; `settings_cli.rs`\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L417-L431\",\"excerpt\":\"Future domain codes owned by their features, not falsely counted covered here\"}]}],\"ambiguities\":[{\"requirement_id\":\"008-settings-cli:AC-001\",\"decision_key\":\"windows_release_support_floor\",\"question\":\"Which Windows release is the oldest supported target for the pending native shell/installer matrix?\",\"critical\":false,\"citations\":[{\"section_id\":\".specs/features/008-settings-cli/logs/2026-10-13.md:L22-L31\",\"excerpt\":\"The oldest supported Windows release is not specified in the examined repository documents; do not invent a support floor.\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L403-L416\",\"excerpt\":\"on oldest supported OS and 24H2\"}],\"resolution\":\"Unresolved release-policy floor; explicitly nonblocking for implementation/integration completion. The operator resolves it before collecting that pending native matrix; no version is invented.\",\"resolution_citations\":[{\"section_id\":\".specs/constitution.md:L31-L36\",\"excerpt\":\"Native evidence that needs Windows, Linux, an older Handy binary or a second user account is recorded as **pending release evidence** with the exact check to run. It never blocks implementation steps, feature completion on the integration branch, or the merge into `dev`; it is never claimed as passed.\"}]}],\"extra_scope\":[],\"findings\":[{\"category\":\"batch_local_transaction_and_dispatch\",\"severity\":\"blocking\",\"description\":\"This batch provides acceptance tests but lacks early service/repository/Step3–4 and capability-dispatch excerpts needed to establish AC-004, AC-005 and FR-003 fully. This is batch-local absence, not a defect inferred about the unseen complete plan.\",\"suggestion\":\"Resolve with exact other-batch plan excerpts for shared service, stable single-lock fresh reread/CAS details, atomic Step4 adoption/cache cutover and live-only offline refusal. Historical primitive PASS/current progress cannot replace canonical implementation evidence.\",\"citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L221-L225\",\"excerpt\":\"**Criterion:** Settings carry a persisted revision number returned by every read and incremented by 1 on every committed write from any surface, including writes made by Handy itself; a write that changes nothing and a read do not increment it. Writes accept `--expected-revision N`; a mismatch returns `revision_conflict` with the current revision in `error.details.current_revision` and writes nothing. All writers (UI commands, a running instance and a headless CLI process) are serialized by one cross-process settings lock, and each writer re-reads the stored settings under that lock before applying its change, so a write without expected revision applies to the latest settings and never discards fields changed by another writer.\"},{\"section_id\":\".specs/features/008-settings-cli/spec.md:L226-L230\",\"excerpt\":\"**Criterion:** When a Handy instance of the same user and settings store is running, the CLI sends the operation to it over a local channel accessible only to that user and waits up to 5 seconds for its answer; the instance applies it with its live state, re-registers affected shortcuts and notifies its UI. If no answer arrives in time, the CLI returns `unavailable` with `error.details.outcome` set to `unknown`, and agents must read again before retrying. If a running Handy without this channel (an older version) is detected, the CLI returns `unavailable` and never writes the store itself. When none is running, the CLI applies the operation to the settings store itself under the same lock and validation. Operations that need live state (for example the current destination) return `unavailable` without a running instance. No network listener and no MCP server are introduced.\"},{\"section_id\":\".specs/features/008-settings-cli/spec.md:L258-L262\",\"excerpt\":\"**Requirement:** Expose one shared validation and commit service used by UI commands and CLI, with a persisted revision, optional expected-revision check and a single write lock.\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Two CLI writers and UI adapter writer with barriers; different/same keys, stale CAS, no-op, startup migration, secret writes, invalid revision, rename lock, crash/flush faults; `settings_transactions.rs`\"}]},{\"category\":\"batch_local_output_and_domain\",\"severity\":\"blocking\",\"description\":\"The production output-domain implementation and complete human/JSON/stdout/stderr/export rendering policies are not supplied here. AC-006, AC-007 and FR-006 remain batch-local missing despite concrete contract/domain tests.\",\"suggestion\":\"Resolve using actual other-batch framework/renderer excerpts defining existing output operations, registered help, human diagnostics and raw export versus data.content; otherwise preserve the unresolved issue.\",\"citations\":[{\"section_id\":\".specs/features/008-settings-cli/spec.md:L231-L235\",\"excerpt\":\"**Criterion:** This feature delivers the shared domain framework (argument parsing, file or `-` (stdin) input, `--dry-run` preview for bulk changes, atomic commit, help text per command) and the output domain for the existing output settings (paste method, clipboard handling, existing auto-submit). The domains microphones, replacements, vocabulary, shortcuts, prompts, destination and the new output settings (smart paste method, automatic Enter) are added on this framework by the features that own them (001–007, 009, 010). `handy settings --help` lists exactly the domains present in the build.\"},{\"section_id\":\".specs/features/008-settings-cli/spec.md:L236-L240\",\"excerpt\":\"**Criterion:** With `--json`, stdout contains exactly one JSON envelope: success `{\\\"ok\\\": true, \\\"revision\\\": N, \\\"data\\\": …}`, failure `{\\\"ok\\\": false, \\\"error\\\": {\\\"code\\\": C, \\\"message\\\": M, \\\"details\\\": {…}}}` where `details` is always an object (for example `current_revision`, `outcome`, `field`, `issues` as a list of `{field, reason}`). Without `--json`, stdout shows readable text. Diagnostics, warnings and progress go to stderr in both modes. Export operations writing to `-` print only the exported content without `--json`, and put it in `data.content` of the envelope with `--json`.\"},{\"section_id\":\".specs/features/008-settings-cli/spec.md:L273-L277\",\"excerpt\":\"**Requirement:** Produce the documented JSON envelope, human output, stderr diagnostics, stable error codes and exit codes.\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Bulk fixture valid/invalid/dry-run, file/stdin UTF-8, all-or-nothing, export and exact domain help; `settings_domains.rs`\"}]},{\"category\":\"ordering_refinement\",\"severity\":\"info\",\"description\":\"Current source-backed refinement keeps pure Repository/Locator/normalization and isolated transactions in Step3, while app adoption, every writer and settings-file plugin autosave/exit-save removal move together at Step4. No stale snapshot-to-patch adapter or early CLI activation is introduced. The supplied risk gate is compatible; canonical Step3/4 excerpts are in the other batch.\",\"suggestion\":\"Preserve the cutover invariant and require actual writer inventory/startup/cache proof before adoption or CLI activation. Step3 isolated tests do not certify application loss prevention.\",\"citations\":[{\"section_id\":\".specs/features/008-settings-cli/progress.md:L17-L22\",\"excerpt\":\"Step3 keeps pure Repository/Locator/normalization, atomic raw preservation/revision/CAS and isolated tests; existing app integration and CLI remain unchanged. Step4 performs all-writer migration and app adoption/settings-specific plugin ownership/autosave/exit-save removal in one cutover, with startup/cache evidence then. No temporary snapshot-to-patch/provenance machinery.\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L432-L459\",\"excerpt\":\"Steps 2–4 precede CLI writes; no settings plugin autosave/exit flush, inventory closure gate\"},{\"section_id\":\".specs/features/008-settings-cli/logs/2026-10-13.md:L295-L311\",\"excerpt\":\"A serialized/reloaded adapter cannot infer whether stale microphoneM0 after concurrentM1 is intentional.\"}]},{\"category\":\"cross_session_fail_closed\",\"severity\":\"warning\",\"description\":\"Linux session/Windows desktop absence alone cannot establish absence of an older owner in another session of the same user/store. The tests/pending inventory preserve that distinction, but the concrete Step5 uncertainty algorithm is outside this slice. This remains noncritical feasibility follow-through, not a claim of safe global absence from a local negative probe.\",\"suggestion\":\"Verify earlier adapter excerpts treat unprovable session scope as unavailable/no write with deterministic uncertainty tests. Real cross-session/second-account evidence remains pending; add neither replay nor a missing-native-evidence step gate.\",\"citations\":[{\"section_id\":\".specs/features/008-settings-cli/logs/2026-10-13.md:L22-L31\",\"excerpt\":\"Linux session bus and Windows session/desktop namespace absence do not establish absence of another session of the same user/store.\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L386-L402\",\"excerpt\":\"Live/no instance/older/startup/busy/stale/different-user/store; permissions, protocol/frame errors, deadline and late replies\"},{\"section_id\":\".specs/features/008-settings-cli/plan.md:L403-L416\",\"excerpt\":\"| Second user/session / platform operator | Real other UID/SID attempts socket/pipe access to private test store; access denied/unavailable, no data/secret leak or changed store; verify installed/portable and endpoint isolation between accounts/sessions | **pending release evidence**; injected identity/ACL unit tests still required; same non-blocking rule |\"}]},{\"category\":\"supporting_contract_and_evidence_context\",\"severity\":\"info\",\"description\":\"The supplied foundation wire contract defines generic get/keys/scalar set, secret-presence projection and documented exits; the current history distinguishes pure ports from actual UI-adapter parity and asks the platform operator to resolve the Windows release floor. These excerpts support the unchanged semantic judgments but are contextual grounding, not obligation-owned source citations or evidence that runtime acceptance passed.\",\"suggestion\":\"Retain these exact contextual excerpts alongside the matching canonical spec citations; rely on actual plan-role excerpts for planned coverage and preserve complete acceptance/native proof obligations.\",\"citations\":[{\"section_id\":\".specs/features/008-settings-cli/contracts/settings-cli.md:L1-L31\",\"excerpt\":\"| `settings get [KEY]` | All 63 known fields or one recognized field; API keys become provider `{present: bool}` entries |\"},{\"section_id\":\".specs/features/008-settings-cli/contracts/settings-cli.md:L1-L31\",\"excerpt\":\"| `settings set KEY VALUE` | One scalar value validated by descriptor; list fields name their owner command, readonly/secret fields direct the user to settings UI |\"},{\"section_id\":\".specs/features/008-settings-cli/contracts/settings-cli.md:L1-L31\",\"excerpt\":\"| `settings keys` | Key, canonical value type, nullable flag, allowed values/range, read-only/secret flags, owner and runtime effect category |\"},{\"section_id\":\".specs/features/008-settings-cli/contracts/settings-cli.md:L1-L31\",\"excerpt\":\"| `usage_error`, `validation_failed`, `shortcut_conflict`, `limit_exceeded` | 2 |\\n| `revision_conflict` | 3 |\\n| `not_found` | 4 |\\n| `unavailable` | 5 |\\n| `persistence_failed`, `internal_error` | 1 |\\n| Success | 0 |\"},{\"section_id\":\".specs/features/008-settings-cli/logs/2026-10-13.md:L267-L282\",\"excerpt\":\"Do not turn pure port parity into corresponding UI-adapter parity or claim whole-AC/native certification.\"},{\"section_id\":\".specs/features/008-settings-cli/progress.md:L45-L55\",\"excerpt\":\"Resolve the oldest-supported-Windows release-policy floor before collecting native evidence; then native build/tests, PE subsystem=3;\"}]}],\"confidence\":4,\"synthesized_batch_ids\":[],\"resolutions\":[]}"
   ],
